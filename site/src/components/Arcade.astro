---
// The frame of a canvas game: the canvas, a readout line, and the website's items as prizes.
import { items } from "../lib/data";
interface Props { name: string; width: number; height: number; label: string; hint: string }
const { name, width, height, label, hint } = Astro.props;
const pool = items.map(({ kind, title, href }) => ({ kind, title, href }));
---

<div class={`fig arcade ${name}`} data-width={width} data-height={height}>
  <canvas tabindex="0" style={`aspect-ratio: ${width} / ${height}`} aria-label={label}></canvas>
  <div class="readout" aria-live="polite"><span class="hint">{hint}</span></div>
  <script is:inline type="application/json" set:html={JSON.stringify(pool)} />
</div>
