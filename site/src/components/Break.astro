---
// A coffee-break card away from home: after a while on a page (once per visit), a way to the games
// on the home page.
---

<aside class="break" hidden aria-live="polite">
  <strong>Take a break with a nerdy little game?</strong>
  <div class="break-actions">
    <a class="pill solid" href="/#game">Play a game</a>
    <button class="pill" type="button">Back to work</button>
  </div>
</aside>

<script>
  const card = document.querySelector<HTMLElement>(".break");
  const seen = () => { try { return sessionStorage.getItem("break") === "1"; } catch { return false; } };
  const remember = () => { try { sessionStorage.setItem("break", "1"); } catch {} };
  if (card && !seen()) {
    card.querySelector("button")!.addEventListener("click", () => { card.hidden = true; });
    card.querySelector("a")!.addEventListener("click", remember);
    setTimeout(() => { if (!seen()) { card.hidden = false; remember(); } }, 30000);
  }
</script>
