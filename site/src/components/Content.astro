---
// The content sections shared by every layout; layouts differ only in their shell and styles.
import EntryItem from "./EntryItem.astro";
import Related from "./Related.astro";
import WorkItem from "./WorkItem.astro";
import { data, isUpcoming, markup, outputSections, pathSections, studies, thesisLinks, type Entry, type Work } from "../lib/data";

const events = data.events as Entry[];
const upcoming = events.filter(isUpcoming).reverse();
const past = events.filter((e) => !isUpcoming(e));
---

<section class="section" id="about">
  <h2>About</h2>
  <div class="prose" set:html={markup(data.profile.bio)} />
  <div class="studied">
    <p><span class="label">Studied</span> {studies.join(", ")}</p>
    <Related related={thesisLinks} />
  </div>
</section>

<section class="section" id="publications">
  <h2>Publications</h2>
  {(data.publications as Work[]).map((work) => <WorkItem work={work} />)}
  {data.preprints.length > 0 && <h3>Preprints</h3>}
  {(data.preprints as Work[]).map((work) => <WorkItem work={work} />)}
</section>

<section class="section" id="open-science">
  <h2>Open science</h2>
  {outputSections.map((section) => (
    <>
      <h3>{section.title}</h3>
      {section.items.map((work) => <WorkItem work={work} />)}
    </>
  ))}
</section>

<section class="section" id="path">
  <h2>Path</h2>
  {pathSections.map(([title, items]) => (
    <>
      <h3>{title}</h3>
      {items.map((entry) => <EntryItem entry={entry} notes={false} />)}
    </>
  ))}
</section>

<section class="section" id="events">
  <h2>Events</h2>
  {upcoming.length > 0 && <h3>Upcoming</h3>}
  {upcoming.map((entry) => <EntryItem entry={entry} />)}
  <h3>Past</h3>
  {past.map((entry) => <EntryItem entry={entry} />)}
  {data.outreach.length > 0 && <h3>Outreach</h3>}
  {(data.outreach as Entry[]).map((entry) => <EntryItem entry={entry} />)}
</section>
