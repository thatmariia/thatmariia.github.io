---
// Fields as point charges with the electric field lines between them.
// With labels, each charge is a pill (all alike, so no field stands out) and hovering one shows
// only the lines that touch it (CSS only).
// Without labels it is a small mark, e.g. next to page titles.
import { points, random, type Point } from "../lib/random";
interface Props { fields: string[]; seed: number; width: number; height: number; labels?: boolean }
const { fields, seed, width, height, labels = true } = Astro.props;

// Charges sit on a jittered ellipse in shuffled order with alternating signs, so every field has
// neighbours of the opposite sign; negative charges are scaled so the total is zero, so every line
// runs from one field to another instead of leaving the figure.
const uniform = random(seed);
const n = fields.length, positives = Math.ceil(n / 2), negatives = n - positives;
const [padX, padY] = labels ? [Math.max(70, width * 0.13), 56] : [14, 14];
const slots = [...Array(n).keys()].sort(() => uniform() - 0.5);
const charges: { at: Point; q: number }[] = [];
slots.forEach((field, slot) => {
  const a = -Math.PI / 2 + (2 * Math.PI * slot) / n + (uniform() - 0.5) * 0.35;
  const rx = (width / 2 - padX) * (0.82 + uniform() * 0.18), ry = (height / 2 - padY) * (0.82 + uniform() * 0.18);
  charges[field] = { at: [width / 2 + rx * Math.cos(a), height / 2 + ry * Math.sin(a)], q: slot % 2 ? -positives / negatives : 1 };
});

// Nudge apart labelled charges whose pills would overlap (pill size estimated in figure units).
if (labels) {
  const size = fields.map((f) => [f.length * 7.6 + 30, 30]);
  for (let round = 0; round < 60; round++) {
    for (let i = 0; i < n; i++) {
      for (let j = i + 1; j < n; j++) {
        const a = charges[i].at, b = charges[j].at;
        const ox = (size[i][0] + size[j][0]) / 2 + 8 - Math.abs(a[0] - b[0]);
        const oy = (size[i][1] + size[j][1]) / 2 + 8 - Math.abs(a[1] - b[1]);
        if (ox <= 0 || oy <= 0) continue;
        const axis = oy < ox ? 1 : 0, push = (Math.min(ox, oy) / 2) * Math.sign(a[axis] - b[axis] || 1);
        a[axis] += push;
        b[axis] -= push;
      }
    }
    charges.forEach(({ at }, i) => {
      at[0] = Math.min(width - size[i][0] / 2, Math.max(size[i][0] / 2, at[0]));
      at[1] = Math.min(height - padY, Math.max(padY, at[1]));
    });
  }
}

function field([x, y]: Point): Point {
  let ex = 0, ey = 0;
  for (const { at: [cx, cy], q } of charges) {
    const dx = x - cx, dy = y - cy, r3 = Math.max(1, Math.hypot(dx, dy)) ** 3;
    ex += (q * dx) / r3;
    ey += (q * dy) / r3;
  }
  return [ex, ey];
}

// Trace lines out of each positive charge until they reach a negative one or leave the figure.
// Each line remembers the charges it touches, for the hover highlight.
const perCharge = labels ? 16 : 9;
const lines: { path: Point[]; touches: number[] }[] = [];
charges.forEach(({ at: [cx, cy], q }, source) => {
  if (q < 0) return;
  for (let k = 0; k < perCharge; k++) {
    const a = (2 * Math.PI * k) / perCharge + 0.13;
    let p: Point = [cx + 6 * Math.cos(a), cy + 6 * Math.sin(a)];
    const path: Point[] = [p];
    const touches = [source];
    for (let step = 0; step < 1500; step++) {
      const [ex, ey] = field(p);
      const norm = Math.hypot(ex, ey) || 1;
      p = [p[0] + (2 * ex) / norm, p[1] + (2 * ey) / norm];
      path.push(p);
      const sink = charges.findIndex((c) => c.q < 0 && Math.hypot(p[0] - c.at[0], p[1] - c.at[1]) < 6);
      if (sink >= 0) touches.push(sink);
      if (sink >= 0 || p[0] < -40 || p[0] > width + 40 || p[1] < -40 || p[1] > height + 40) break;
    }
    lines.push({ path, touches });
  }
});

const id = `fl-${seed}-${width}`;
const hover = charges
  .map((_, i) => `.${id}:has([data-charge="${i}"]:hover) .line:not([data-touches~="${i}"]) { opacity: 0.06; }
.${id}:has([data-charge="${i}"]:hover) .line[data-touches~="${i}"] { opacity: 1; stroke-width: 1.3; }`)
  .join("\n");
---

<div class:list={["fieldlines", id, { mark: !labels }]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={labels ? `Fields: ${fields.join(", ")}` : undefined} aria-hidden={labels ? undefined : "true"}>
    <clipPath id={`${id}-clip`}><rect width={width} height={height} /></clipPath>
    <g clip-path={`url(#${id}-clip)`}>
      {lines.map((line, i) => (
        <polyline class="line" data-touches={line.touches.join(" ")} style={`--i: ${i % 9}`} points={points(line.path)} pathLength="1" />
      ))}
    </g>
    {!labels && charges.map(({ at: [x, y] }) => <circle class="dot" cx={x} cy={y} r="4" />)}
  </svg>
  {labels && charges.map(({ at: [x, y] }, i) => (
    <span class="charge" data-charge={i} style={`left: ${((x / width) * 100).toFixed(2)}%; top: ${((y / height) * 100).toFixed(2)}%`}>
      {fields[i]}
    </span>
  ))}
  {labels && <style is:inline set:html={hover} />}
</div>
