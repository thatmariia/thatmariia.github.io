---
// Fields as points on a plot, visited in order by one 2D random walk (like a particle track).
// Points sit on a jittered ring in shuffled order, so labels point outwards and the walk crosses the middle.
import { bridge, points, random, type Point } from "../lib/walk";
interface Props { fields: string[]; seed: number; size?: number }
const { fields, seed, size = 340 } = Astro.props;

const { uniform, gauss } = random(seed);
const n = fields.length, c = size / 2;
const slots = fields.map((_, i) => i).sort(() => uniform() - 0.5);
const nodes = slots.map((slot) => {
  const angle = (2 * Math.PI * slot) / n + (uniform() - 0.5) * 0.5;
  const r = size * (0.24 + uniform() * 0.1);
  return { at: [c + r * Math.cos(angle), c + r * Math.sin(angle)] as Point, angle };
});
const track = nodes.slice(1).flatMap((node, i) => bridge(gauss, nodes[i].at, node.at, 36, 4).slice(i ? 1 : 0));
const ticks = [0.25, 0.5, 0.75];
---

<svg class="fieldmap" viewBox={`0 0 ${size} ${size}`} role="img" aria-label={`Fields: ${fields.join(", ")}`}>
  <rect class="frame" x="0.5" y="0.5" width={size - 1} height={size - 1} />
  {ticks.map((t) => (
    <>
      <line class="tick" x1={t * size} y1="0" x2={t * size} y2="6" />
      <line class="tick" x1="0" y1={t * size} x2="6" y2={t * size} />
    </>
  ))}
  <polyline class="track" points={points(track)} pathLength="1" />
  {nodes.map(({ at: [x, y], angle }, i) => {
    const below = Math.sin(angle) > 0;
    return (
      <g class:list={["node", { last: i === n - 1 }]}>
        <circle cx={x} cy={y} r="4" />
        <text x={x} y={below ? y + 19 : y - 11} text-anchor="middle">{fields[i]}</text>
      </g>
    );
  })}
</svg>
