---
// The home-page figure. TEMPORARY: all options are rendered and pill buttons (plain radio
// inputs, no JavaScript) switch between them until one is chosen.
import Itinerancy from "./figures/Itinerancy.astro";
import Quadrature from "./figures/Quadrature.astro";
import Signals from "./figures/Signals.astro";
import Synchrony from "./figures/Synchrony.astro";
import Topography from "./figures/Topography.astro";

const options = [
  { key: "itinerancy", label: "Attractors", Figure: Itinerancy, seed: 4 },
  { key: "signals", label: "Neurons", Figure: Signals, seed: 7 },
  { key: "synchrony", label: "Synchrony", Figure: Synchrony, seed: 2 },
  { key: "topography", label: "Topography", Figure: Topography, seed: 1 },
  { key: "quadrature", label: "Quadrature", Figure: Quadrature, seed: 1 },
];
const show = options.map(({ key }) => `.figure:has(input[value="${key}"]:checked) .option[data-option="${key}"] { display: block; }`).join("\n");
---

<figure class="figure">
  <fieldset class="figure-options">
    <legend>Figure</legend>
    {options.map(({ key, label }, i) => (
      <label class="pill"><input type="radio" name="figure" value={key} checked={i === 0} />{label}</label>
    ))}
  </fieldset>
  {options.map(({ key, Figure, seed }) => (
    <div class="option" data-option={key}>
      <div class="wide"><Figure seed={seed} width={960} height={460} /></div>
      <div class="narrow"><Figure seed={seed} width={400} height={560} /></div>
    </div>
  ))}
  <style is:inline set:html={show} />
</figure>
