---
// The figure at the top of a page. A page names the figures that suit its data; while choosing,
// pill buttons (plain radio inputs, no JavaScript) switch between them when there is more than one.
import CartPole from "./figures/CartPole.astro";
import Collaborators from "./figures/Collaborators.astro";
import EEG from "./figures/EEG.astro";
import Feynman from "./figures/Feynman.astro";
import Fireflies from "./figures/Fireflies.astro";
import Fireworks from "./figures/Fireworks.astro";
import Flanker from "./figures/Flanker.astro";
import GrowthCone from "./figures/GrowthCone.astro";
import NeuralNet from "./figures/NeuralNet.astro";
import NeuronGame from "./figures/NeuronGame.astro";
import PerceptronPong from "./figures/PerceptronPong.astro";
import Saltatory from "./figures/Saltatory.astro";
import Sieve from "./figures/Sieve.astro";
import Spiral from "./figures/Spiral.astro";
import Topo from "./figures/Topo.astro";
import Travels from "./figures/Travels.astro";
import Volleyball from "./figures/Volleyball.astro";

const FIGURES = {
  game: { label: "Neuron burst", Figure: NeuronGame, seed: 1 },
  saltatory: { label: "Saltatory", Figure: Saltatory, seed: 1 },
  sieve: { label: "Sieve", Figure: Sieve, seed: 1 },
  growthcone: { label: "Growth cone", Figure: GrowthCone, seed: 1 },
  flanker: { label: "Flanker", Figure: Flanker, seed: 1 },
  cartpole: { label: "Cart-pole", Figure: CartPole, seed: 1 },
  fireflies: { label: "Fireflies", Figure: Fireflies, seed: 1 },
  pong: { label: "Perceptron Pong", Figure: PerceptronPong, seed: 1 },
  spiral: { label: "Spiral explorer", Figure: Spiral, seed: 2 },
  collaborators: { label: "Collaborators", Figure: Collaborators, seed: 7 },
  topo: { label: "Topographic map", Figure: Topo, seed: 1 },
  feynman: { label: "Feynman diagram", Figure: Feynman, seed: 1 },
  neuralnet: { label: "Neural network", Figure: NeuralNet, seed: 1 },
  eeg: { label: "EEG", Figure: EEG, seed: 5 },
  travels: { label: "Travels", Figure: Travels, seed: 2 },
  fireworks: { label: "Fireworks", Figure: Fireworks, seed: 6 },
  volleyball: { label: "Volleyball", Figure: Volleyball, seed: 3 },
};
interface Props { show: (keyof typeof FIGURES)[] }
const { show } = Astro.props;
const options = show.map((key) => ({ key, ...FIGURES[key] }));
const visible = options.map(({ key }) => `.figure:has(input[value="${key}"]:checked) .option[data-option="${key}"] { display: block; }`).join("\n");
---

<figure class="figure">
  {options.length > 1 && (
    <fieldset class="figure-options">
      <legend>Figure</legend>
      {options.map(({ key, label }, i) => (
        <label class="pill"><input type="radio" name="figure" value={key} checked={i === 0} />{label}</label>
      ))}
    </fieldset>
  )}
  {options.map(({ key, Figure, seed }) => (
    <div class="option" data-option={key} style={options.length === 1 ? "display: block" : undefined}>
      <div class="wide"><Figure seed={seed} width={960} height={460} /></div>
      <div class="narrow"><Figure seed={seed} width={400} height={560} /></div>
    </div>
  ))}
  <style is:inline set:html={visible} />
</figure>
