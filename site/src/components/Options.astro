---
// TEMPORARY typeface picker, removed once one is chosen.
const typefaces = [["sora", "Sora"], ["lexend", "Lexend Exa + Lexend"], ["unbounded", "Unbounded + Manrope"], ["manrope", "Manrope"]];
---

<label class="options">
  <span>Typeface</span>
  <select>{typefaces.map(([value, label]) => <option value={value}>{label}</option>)}</select>
</label>

<script is:inline>
  {
    const select = document.querySelector(".options select");
    select.value = document.documentElement.dataset.type || "sora";
    select.addEventListener("change", () => {
      document.documentElement.dataset.type = select.value;
      try { localStorage.setItem("option-type", select.value); } catch {}
    });
  }
</script>
