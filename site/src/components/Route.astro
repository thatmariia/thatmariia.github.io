---
// The profile's walk drawn as a route: a seeded random walk (Brownian bridge)
// between pinned stops, each leg coloured by the field it leads to.
// Rendered at build time; horizontal for wide screens, vertical for narrow ones.
interface Props { stops: { label: string; year: number }[]; seed: number; vertical?: boolean }
const { stops, seed, vertical = false } = Astro.props;

const [width, height] = vertical ? [360, 820] : [1200, 340];
const [long, across] = vertical ? [height, width] : [width, height];
const COLORS = ["teal", "brown", "red", "ochre", "pink", "blue", "green"];

let state = seed;
const rand = () => {  // mulberry32: small seeded PRNG, so the drawing is stable between builds
  state = (state + 0x6d2b79f5) | 0;
  let t = Math.imul(state ^ (state >>> 15), 1 | state);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
const xy = (along: number, side: number) => (vertical ? [side, along] : [along, side]) as [number, number];

// Pins: evenly spaced along the route, wandering across it with some momentum.
const lo = across * (vertical ? 0.14 : 0.2), hi = across * (vertical ? 0.55 : 0.8);
let side = (lo + hi) / 2, velocity = 0;
const pins = stops.map((stop, i) => {
  velocity = 0.4 * velocity + gauss() * across * 0.18;
  side = Math.min(hi, Math.max(lo, side + velocity));
  const along = 40 + (i / Math.max(1, stops.length - 1)) * (long - (vertical ? 120 : 160));
  return { ...stop, at: xy(along, side), color: COLORS[i % COLORS.length] };
});

// Between pins: a Brownian bridge, so the trace wanders but lands exactly on each pin.
function bridge(a: [number, number], b: [number, number], steps = 28, sigma = 5) {
  const walk = [[0, 0]];
  for (let k = 1; k <= steps; k++) walk.push([walk[k - 1][0] + gauss() * sigma, walk[k - 1][1] + gauss() * sigma]);
  const [ex, ey] = walk[steps];
  return walk.map(([x, y], k) => {
    const t = k / steps;
    return [a[0] + (b[0] - a[0]) * t + x - ex * t, a[1] + (b[1] - a[1]) * t + y - ey * t].map((v) => v.toFixed(1)).join(",");
  });
}
const legs = pins.slice(1).map((pin, i) => ({ points: bridge(pins[i].at, pin.at).join(" "), color: pin.color }));
const last = pins[pins.length - 1].at;
const tail = bridge(last, vertical ? [last[0] - 24, height - 20] : [width - 20, last[1] - 30], 14, 4).join(" ");
---

<svg class:list={["route", { vertical }]} viewBox={`0 0 ${width} ${height}`} role="img"
  aria-label={`Route: ${stops.map((s) => `${s.label} (${s.year})`).join(", ")}`}>
  {legs.map((leg, i) => (
    <polyline class={`leg ${leg.color}`} points={leg.points} pathLength="1" style={`--i: ${i}`} />
  ))}
  <polyline class="tail" points={tail} style={`--i: ${legs.length}`} />
  {pins.map((pin, i) => {
    const [x, y] = pin.at;
    const above = !vertical && i % 2 === 1;
    const label = vertical
      ? { x: x + 22, y: y + 5, anchor: "start" }
      : { x, y: above ? y - 30 : y + 40, anchor: "middle" };
    return (
      <g class={`pin ${pin.color}`} style={`--i: ${i}`} aria-hidden="true">
        <circle cx={x} cy={y} r="11" class="ring" />
        <circle cx={x} cy={y} r="5.5" class="dot" />
        <text x={label.x} y={label.y} text-anchor={label.anchor} class="label">{pin.label}</text>
        <text x={label.x} y={label.y + 17} text-anchor={label.anchor} class="year">{pin.year}</text>
      </g>
    );
  })}
</svg>
