---
// Each field as its own hand-drawn line wandering across the page; the lines cross.
import { bridge, points, random, type Point } from "../lib/walk";
interface Props { fields: string[]; seed: number; width?: number; height?: number }
const { fields, seed, width = 1200, height = 420 } = Astro.props;

const COLORS = ["#2346d1", "#d8321f", "#a3784f", "#1d6b63", "#e2a32b", "#5aa65a", "#cf5f9e"];
const { uniform, gauss } = random(seed);
const n = fields.length;
const threads = fields.map((field, i) => {
  // Start high and end low or the other way round, so neighbouring threads cross.
  const y0 = height * (0.12 + 0.76 * (i / Math.max(1, n - 1)));
  const y1 = height * (0.12 + 0.76 * uniform());
  const x0 = width * (0.02 + uniform() * 0.25), x1 = width * (0.75 + uniform() * 0.23);
  const line = bridge(gauss, [x0, y0] as Point, [x1, y1] as Point, 60, Math.min(width, height) * 0.012);
  return { field, line, start: line[0], color: COLORS[i % COLORS.length] };
});
---

<svg class="threads" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields: ${fields.join(", ")}`}>
  {threads.map((t, i) => (
    <g style={`--c: ${t.color}; --i: ${i}`}>
      <polyline class="thread" points={points(t.line)} pathLength="1" />
      <text class="thread-label" x={t.start[0]} y={t.start[1] - 12}>{t.field}</text>
    </g>
  ))}
</svg>
