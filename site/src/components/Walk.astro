---
// A sentence set along a seeded random walk, drawn at build time.
// On narrow screens the text is hidden and shown as a caption instead (see global.css).
interface Props { text: string; seed: number; width: number; height: number }
const { text, seed, width, height } = Astro.props;

function random(a: number) {  // mulberry32: small seeded PRNG, so the walk is stable between builds
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// Step right in equal steps, wandering up and down with some momentum.
const rand = random(seed);
const steps = 6, margin = height * 0.1;
let y = height / 2, velocity = 0;
const points: [number, number][] = [];
for (let i = 0; i <= steps; i++) {
  velocity = 0.45 * velocity + (rand() - 0.5) * height * 0.9;
  y = Math.min(height - margin, Math.max(margin, y + velocity));
  points.push([20 + (i / steps) * (width - 40), y]);
}

// Catmull-Rom spline through the points, as cubic Béziers.
const p = (i: number) => points[Math.max(0, Math.min(points.length - 1, i))];
let d = `M${p(0).join(",")}`;
for (let i = 0; i < points.length - 1; i++) {
  const [a, b, c, e] = [p(i - 1), p(i), p(i + 1), p(i + 2)];
  const c1 = [b[0] + (c[0] - a[0]) / 6, b[1] + (c[1] - a[1]) / 6];
  const c2 = [c[0] - (e[0] - b[0]) / 6, c[1] - (e[1] - b[1]) / 6];
  d += ` C${c1.join(",")} ${c2.join(",")} ${c.join(",")}`;
}

// Fit the text to the path: Space Mono advances 0.6em per character.
let length = 0;
for (let i = 1; i < points.length; i++) length += Math.hypot(points[i][0] - points[i - 1][0], points[i][1] - points[i - 1][1]);
const fontSize = Math.min(28, (length * 0.97) / (text.length * 0.6));
const id = `walk-${seed}`;
---

<svg class="walk" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={text}>
  <path id={id} d={d} class="walk-line" pathLength="1" />
  <text font-size={fontSize.toFixed(1)} dy={(-fontSize * 0.55).toFixed(1)} aria-hidden="true">
    <textPath href={`#${id}`}>{text}</textPath>
  </text>
</svg>
