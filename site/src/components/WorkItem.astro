---
import Related from "./Related.astro";
import { authors, markup, STATUS, workUrl, type Work } from "../lib/data";
interface Props { work: Work }
const { work } = Astro.props;
const url = workUrl(work);
---

<article class="row work" id={work.id}>
  <p class="meta">{work.year}</p>
  <div class="body">
    {(work.venue || STATUS[work.status]) && (
      <p class="venue">{work.venue}{STATUS[work.status] && <span class="pill tiny">{STATUS[work.status]}</span>}</p>
    )}
    <h4 class="title">
      {url ? <a href={url} set:html={markup(work.title)} /> : <span set:html={markup(work.title)} />}
    </h4>
    <p class="authors" set:html={authors(work.authors)} />
    <Related related={work.related} links={work.links} />
  </div>
</article>
