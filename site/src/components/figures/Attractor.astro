---
// A Lorenz attractor: one continuous curve looping between two wings; the fields sit along it.
import { place, separate } from "../../lib/figure";
import { points, type Point } from "../../lib/random";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, width, height } = Astro.props;

// Integrate the Lorenz system (σ = 10, ρ = 28, β = 8/3) with RK4 and project onto the x–z plane.
const derivative = ([x, y, z]: number[]) => [10 * (y - x), x * (28 - z) - y, x * y - (8 / 3) * z];
let s = [1, 1, 1];
const raw: [number, number][] = [];
for (let step = 0; step < 9000; step++) {
  const dt = 0.006;
  const k1 = derivative(s);
  const k2 = derivative(s.map((v, i) => v + (dt / 2) * k1[i]));
  const k3 = derivative(s.map((v, i) => v + (dt / 2) * k2[i]));
  const k4 = derivative(s.map((v, i) => v + dt * k3[i]));
  s = s.map((v, i) => v + (dt / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]));
  if (step > 300 && step % 2 === 0) raw.push([s[0], s[2]]);
}

// Fit uniformly into the figure.
const pad = 40;
const [minX, maxX] = [Math.min(...raw.map((p) => p[0])), Math.max(...raw.map((p) => p[0]))];
const [minZ, maxZ] = [Math.min(...raw.map((p) => p[1])), Math.max(...raw.map((p) => p[1]))];
const scale = Math.min((width - 2 * pad) / (maxX - minX), (height - 2 * pad) / (maxZ - minZ));
const [ox, oy] = [(width - scale * (maxX - minX)) / 2, (height - scale * (maxZ - minZ)) / 2];
const curve: Point[] = raw.map(([x, z]) => [ox + (x - minX) * scale, height - oy - (z - minZ) * scale]);
const chunks = Array.from({ length: Math.ceil(curve.length / 350) }, (_, k) => curve.slice(k * 350, k * 350 + 351));

// Spread the fields over the attractor: farthest-point sampling from the leftmost point.
const candidates = curve.filter((_, k) => k % 10 === 0);
const at: Point[] = [[...candidates.reduce((a, b) => (b[0] < a[0] ? b : a))] as Point];
while (at.length < fields.length) {
  const distance = (p: Point) => Math.min(...at.map((q) => Math.hypot(p[0] - q[0], (p[1] - q[1]) * 2)));
  at.push([...candidates.reduce((a, b) => (distance(b) > distance(a) ? b : a))] as Point);
}
separate(at, fields, width, height, 24);
---

<div class="fig attractor">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields along a Lorenz attractor: ${fields.join(", ")}`}>
    {chunks.map((chunk, i) => <polyline class="line" points={points(chunk)} style={`--i: ${i}`} pathLength="1" />)}
  </svg>
  {at.map((p, i) => <span class="node" data-node={i} style={place(p, width, height)}>{fields[i]}</span>)}
</div>
