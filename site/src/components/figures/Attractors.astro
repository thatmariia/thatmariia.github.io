---
// A flow with every field as a stable spiral attractor: trajectories from all over the figure
// spiral into the field whose basin they start in. Hovering a field highlights its basin.
import { ellipse, hoverCss, place, separate } from "../../lib/figure";
import { points, random, type Point } from "../../lib/random";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, seed, width, height } = Astro.props;

const uniform = random(seed);
const n = fields.length;
const centers = ellipse(n, width, height, Math.max(70, width * 0.13), 56, uniform).map((node) => node.at);
separate(centers, fields, width, height, 56);

// Each attractor pulls inwards and rotates; the nearest one dominates (softmax of squared distances,
// taken relative to the nearest so far-away points do not underflow to an equal pull from all).
const sigma = Math.min(width, height) * 0.1;
function velocity([x, y]: Point): Point {
  const d2 = centers.map(([cx, cy]) => (x - cx) ** 2 + (y - cy) ** 2), nearest = Math.min(...d2);
  const weights = d2.map((d) => Math.exp(-(d - nearest) / (2 * sigma ** 2)));
  const sum = weights.reduce((s, w) => s + w, 0);
  let vx = 0, vy = 0;
  centers.forEach(([cx, cy], i) => {
    const [dx, dy] = [x - cx, y - cy], w = weights[i] / sum;
    vx += w * (-dx - 1.1 * dy);
    vy += w * (-dy + 1.1 * dx);
  });
  return [vx, vy];
}

// Trajectories from a jittered grid of starting points, until they reach an attractor.
const [cols, rows] = width > height ? [16, 8] : [8, 11];
const trajectories: { path: Point[]; basin: number }[] = [];
for (let c = 0; c < cols; c++) {
  for (let r = 0; r < rows; r++) {
    let p: Point = [((c + 0.2 + uniform() * 0.6) / cols) * width, ((r + 0.2 + uniform() * 0.6) / rows) * height];
    const path = [p];
    let basin = -1;
    for (let step = 0; step < 900 && basin < 0; step++) {
      // Longer steps far from every attractor, shorter ones close in.
      const near = Math.min(...centers.map(([cx, cy]) => Math.hypot(p[0] - cx, p[1] - cy)));
      const [vx, vy] = velocity(p);
      const speed = Math.hypot(vx, vy) || 1, stride = Math.min(6, Math.max(1.2, near * 0.06));
      p = [p[0] + (stride * vx) / speed, p[1] + (stride * vy) / speed];
      path.push(p);
      basin = centers.findIndex(([cx, cy]) => Math.hypot(p[0] - cx, p[1] - cy) < 9);
    }
    if (basin >= 0) trajectories.push({ path, basin });
  }
}
const id = `at-${seed}-${width}`;
---

<div class:list={["fig attractors", id]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields as attractors: ${fields.join(", ")}`}>
    {trajectories.map((t, i) => <polyline class="line" data-touches={t.basin} points={points(t.path)} style={`--i: ${i % 9}`} pathLength="1" />)}
  </svg>
  {centers.map((p, i) => <span class="node" data-node={i} style={place(p, width, height)}>{fields[i]}</span>)}
  <style is:inline set:html={hoverCss(id, n)} />
</div>
