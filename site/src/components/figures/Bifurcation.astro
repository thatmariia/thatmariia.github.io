---
// The logistic map x → r·x(1−x): as r grows the stable state forks again and again (period
// doubling) and dissolves into chaos. Drawn as fine dots, dense enough that branches read as curves.
import { place, separate } from "../../lib/figure";
import type { Point } from "../../lib/random";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, width, height } = Astro.props;

// r runs along the longer side of the figure (left to right, or top to bottom on tall screens).
const [r0, r1, pad] = [2.85, 4, 18];
const vertical = height > width;
const [long, short] = vertical ? [height, width] : [width, height];
const point = (r: number, x: number): Point => {
  const along = pad + ((r - r0) / (r1 - r0)) * (long - 2 * pad), across = pad + (1 - x) * (short - 2 * pad);
  return vertical ? [across, along] : [along, across];
};
function attractor(r: number, samples: number) {
  let x = 0.5;
  for (let i = 0; i < 800; i++) x = r * x * (1 - x);
  return Array.from({ length: samples }, () => (x = r * x * (1 - x)));
}

// One column of dots per figure unit; fewer samples where it is chaotic, to keep the file small.
const seen = new Set<string>();
let dots = "";
for (let step = 0; step <= (long - 2 * pad) / 0.7; step++) {
  const r = r0 + ((step * 0.7) / (long - 2 * pad)) * (r1 - r0);
  for (const x of attractor(r, r < 3.57 ? 16 : 24)) {
    const [px, py] = point(r, x);
    const key = `${px.toFixed(0)},${py.toFixed(0)}`;
    if (seen.has(key)) continue;
    seen.add(key);
    dots += `M${px.toFixed(1)} ${py.toFixed(1)}h0`;
  }
}

// Fields sit on the diagram at evenly spaced r, alternating between upper and lower branches.
const at: Point[] = fields.map((_, i) => {
  const r = 2.95 + (i / Math.max(1, fields.length - 1)) * 1.0;
  const xs = attractor(r, 16).sort((a, b) => a - b);
  return point(r, i % 2 ? xs[0] : xs[xs.length - 1]);
});
separate(at, fields, width, height, 24);
---

<div class="fig bifurcation">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields along a bifurcation diagram: ${fields.join(", ")}`}>
    <path class="dots" d={dots} />
  </svg>
  {at.map((p, i) => <span class="node" data-node={i} style={place(p, width, height)}>{fields[i]}</span>)}
</div>
