---
// Flip the bits: set eight bits to the target number before the time runs out (click them, or
// press 1–8). Targets come in decimal, then hexadecimal, then as signed two's complement; the
// time scales with the flips needed and slowly shrinks. A miss ends it, with one of the website's
// items as the prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="bits" width={width} height={Math.round(width * (width > 600 ? 0.34 : 0.75))}
  label="Bits: click the eight bits, or press 1 to 8, to make the binary number shown before the time runs out"
  rules={["Flip the bits", "Make the number in binary before the time runs out: click the bits or press 1–8.", "Bigger flips get more time. Later numbers come in hexadecimal and two's complement."]} />

<script>
  import { begin, best, corners, gameOver, loop, pointer, setup, type Game } from "../../lib/game";

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.bits")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, size = Math.min(W / 11, 64), gap = size * 0.18;
    const x0 = W / 2 - (8 * size + 7 * gap) / 2, y0 = H * 0.5;
    let state: "idle" | "running" | "over" = "idle";
    let bits = Array(8).fill(0), target = 0, form: "dec" | "hex" | "signed" = "dec", clock = 0, limit = 9, solved = 0, flash = 0;
    const value = () => bits.reduce((s, b, i) => s + b * 2 ** (7 - i), 0);
    const signed = (v: number) => (v >= 128 ? v - 256 : v);
    const shown = () => (form === "hex" ? `0x${target.toString(16).toUpperCase().padStart(2, "0")}` : form === "signed" ? `${signed(target)} (signed)` : String(target));

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      c.textAlign = "center";
      if (state !== "idle") { c.fillStyle = ink; c.font = `600 ${Math.round(size * 0.55)}px ${mono}`; c.fillText(shown(), W / 2, H * 0.3); }
      bits.forEach((b, i) => {
        const x = x0 + i * (size + gap);
        c.fillStyle = b ? ink : bg; c.strokeStyle = ink; c.lineWidth = 1.4;
        c.beginPath(); c.roundRect(x, y0, size, size, size / 2); c.fill(); c.stroke();
        c.fillStyle = b ? bg : ink; c.font = `600 ${Math.round(size * 0.4)}px ${mono}`;
        c.fillText(String(b), x + size / 2, y0 + size * 0.64);
        c.fillStyle = muted; c.font = `10px ${mono}`;
        c.fillText(String(2 ** (7 - i)), x + size / 2, y0 + size + 14);
      });
      if (state === "running") {
        const left = Math.max(0, 1 - clock / limit);
        c.strokeStyle = muted; c.lineWidth = 2;
        c.beginPath(); c.moveTo(W / 2 - W * 0.3 * left, H * 0.38); c.lineTo(W / 2 + W * 0.3 * left, H * 0.38); c.stroke();
        c.fillStyle = muted; c.font = `11px ${mono}`;
        c.fillText(`= ${value()}${form === "signed" ? ` = ${signed(value())} signed` : form === "hex" ? ` = 0x${value().toString(16).toUpperCase()}` : ""}`, W / 2, y0 + size + 34);
      }
      if (flash > 0) { c.globalAlpha = flash; c.strokeStyle = ink; c.lineWidth = 3; c.beginPath(); c.roundRect(x0 - 8, y0 - 8, 8 * size + 7 * gap + 16, size + 16, size / 2 + 8); c.stroke(); c.globalAlpha = 1; }
      corners(game, "bits", `${solved} solved`);
    }

    const next = () => {
      form = solved < 5 ? "dec" : solved < 10 ? (Math.random() < 0.5 ? "hex" : "dec") : (["dec", "hex", "signed"] as const)[Math.floor(Math.random() * 3)];
      do target = 1 + Math.floor(Math.random() * 255); while (target === value());
      // Time for the work: a base that shrinks slowly, plus time per bit to flip, plus time to convert.
      const flips = (target ^ value()).toString(2).split("").filter((b) => b === "1").length;
      [clock, limit] = [0, Math.max(2.5, 5 - solved * 0.12) + 1.3 * flips + (form === "dec" ? 0 : 3)];
    };
    const flip = (i: number) => {
      if (state !== "running") return;
      bits[i] = 1 - bits[i];
      if (value() === target) { solved += 1; flash = 1; next(); }
    };
    const step = (dt: number) => {
      clock += dt; flash = Math.max(0, flash - dt * 3);
      if (clock > limit) {
        state = "over";
        const record = best("bits", solved);
        gameOver(game, `<strong>Out of time at ${solved} solved</strong> · ${shown()} is ${target.toString(2).padStart(8, "0")}${solved >= record && solved > 0 ? " · new best!" : ""}`);
      }
      draw();
      return state === "running";
    };
    const start = () => {
      [state, bits, solved] = ["running", Array(8).fill(0), 0];
      begin(game, "Flip the bits to make the number");
      next();
      loop(step);
    };
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      if (state !== "running") return start();
      const [x, y] = pointer(game, event), i = Math.floor((x - x0) / (size + gap));
      if (i >= 0 && i < 8 && y >= y0 && y <= y0 + size && x - x0 - i * (size + gap) <= size) flip(i);
    });
    game.element.addEventListener("keydown", (event) => {
      if (state !== "running") { if (event.key.length === 1 || event.key === "Enter") { event.preventDefault(); start(); } return; }
      if (/^[1-8]$/.test(event.key)) { event.preventDefault(); flip(Number(event.key) - 1); }
    });
    draw();
  }
</script>
