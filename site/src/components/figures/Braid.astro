---
// The path as a braid: every role is a strand that exists while the role lasts. At any moment the
// active strands share the width, so strands make room as roles start and end and weave past each
// other. Labels name each strand where it begins; pulses run along them.
import { firstYear, month, now } from "../../lib/career";
import { data, type Entry } from "../../lib/data";
import { points, random, type Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const uniform = random(seed);
const SECTIONS = ["research", "teaching", "leadership", "service", "other"];
const strands = SECTIONS.flatMap((s) => ((data as any)[s] as Entry[])).map((e) => ({
  title: e.title!, from: Math.min(...e.periods.map((p) => month(p.start!))),
  to: Math.max(...e.periods.map((p) => (p.end === "present" ? now + 1 : p.end ? month(p.end) + 1 : month(p.start!) + 2))),
})).sort((a, b) => a.from - b.from);
const vertical = height > width;
const [start, end] = [Math.min(...strands.map((s) => s.from)), now + 1];
const [a0, a1] = vertical ? [20, height - 12] : [16, width - 16];  // along time
const [c0, c1] = vertical ? [20, width - 20] : [30, height - 20];  // across
const along = (t: number) => a0 + ((t - start) / (end - start)) * (a1 - a0);
const xy = (t: number, c: number): Point => (vertical ? [c, along(t)] : [along(t), c]);
const f = (v: number) => v.toFixed(1);

// Position of each strand at each moment: active strands share the width in order of start.
const paths = strands.map(() => [] as Point[]);
for (let t = start; t <= end; t += 0.5) {
  const active = strands.map((s, i) => [s, i] as const).filter(([s]) => s.from <= t && t <= s.to);
  active.forEach(([, i], k) => {
    const c = c0 + ((k + 0.5) / active.length) * (c1 - c0);
    paths[i].push(xy(t, c));
  });
}
---

<div class:list={["fig braid", { vertical }]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${strands.length} roles as strands of a braid since ${firstYear}`}>
    {paths.map((p, i) => p.length > 1 && (
      <g>
        <title>{strands[i].title}</title>
        <polyline class="strand" points={points(p)} />
        <polyline class="pulse" points={points(p)} pathLength="1" style={`animation-delay: ${(-uniform() * 6).toFixed(2)}s`} />
      </g>
    ))}
    {paths.map((p, i) => p.length > 1 && strands[i].to - strands[i].from >= 18 && (
      <text x={f(p[0][0] + (vertical ? 4 : 2))} y={f(p[0][1] - (vertical ? -10 : 5))}>{strands[i].title.length > 20 ? `${strands[i].title.slice(0, 18)}…` : strands[i].title}</text>
    ))}
  </svg>
</div>
