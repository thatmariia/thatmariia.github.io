---
// Path as an electronic schematic, time running along the wires. Each kind of role is a bus, and
// each role a component on it, as long as the role lasted: research a resistor, teaching a
// capacitor, leadership an inductor (more turns the longer it lasted), anything else a diode.
// Roles held at the same time sit in parallel. Linked outputs and events are LEDs to ground that
// blink; links between roles of different kinds are wires with junctions. Current keeps flowing.
import { dated, firstYear, now, roleEntries, shortName } from "../../lib/career";
import { pathSections, refs } from "../../lib/data";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

const vertical = height > width;
const f = (v: number) => v.toFixed(1);
const [start, end] = [firstYear * 12 - 4, now + 4];
const [a0, a1] = vertical ? [44, height - 16] : [112, width - 16];  // the time axis
const along = (t: number) => a0 + ((t - start) / (end - start)) * (a1 - a0);
const buses = pathSections.filter((p) => roleEntries.some((r) => r.section === p.id));
const [c0, c1] = vertical ? [30, width - 30] : [44, height - 36];
const busAt = (k: number) => c0 + ((k + 0.5) / buses.length) * (c1 - c0);
// (along time, across) → screen.
const P = (a: number, c: number) => (vertical ? `${f(c)},${f(a)}` : `${f(a)},${f(c)}`);
const SYMBOL: Record<string, string> = { research: "R", teaching: "C", leadership: "L", service: "S", other: "D" };

// Parallel branches: roles of one kind that overlap in time get separate lanes around the bus.
const parts = buses.flatMap((bus, k) => {
  const roles = roleEntries.filter((r) => r.section === bus.id).sort((a, b) => a.from - b.from), lanes: number[] = [];
  return roles.map((r, i) => {
    let lane = lanes.findIndex((busyUntil) => busyUntil < r.from - 1);
    if (lane < 0) lane = lanes.length;
    lanes[lane] = r.to;
    const offset = lane === 0 ? 0 : (lane % 2 ? -1 : 1) * Math.ceil(lane / 2) * (vertical ? 14 : 15);
    return { r, k, bus: busAt(k), c: busAt(k) + offset, x1: along(r.from), x2: Math.max(along(r.from) + 18, along(r.to)), name: `${SYMBOL[bus.id] ?? "X"}${i + 1}` };
  });
});
// One component between a and b on the line at c, drawn in (along, across) coordinates.
const component = (section: string, a: number, b: number, c: number) => {
  const mid = (a + b) / 2, span = b - a;
  if (section === "research") {
    const teeth = Math.max(3, Math.min(14, Math.round((span - 8) / 7))), w = (span - 8) / teeth;
    let d = `M${P(a, c)} L${P(a + 4, c)}`;
    for (let i = 0; i < teeth; i++) d += ` L${P(a + 4 + (i + 0.25) * w, c - 4)} L${P(a + 4 + (i + 0.75) * w, c + 4)}`;
    return `${d} L${P(b - 4, c)} L${P(b, c)}`;
  }
  if (section === "leadership") {
    const turns = Math.max(2, Math.min(16, Math.round(span / 9))), w = span / turns;
    let d = `M${P(a, c)}`;
    for (let i = 0; i < turns; i++) d += ` C${P(a + i * w, c - 7)} ${P(a + (i + 1) * w, c - 7)} ${P(a + (i + 1) * w, c)}`;
    return d;
  }
  if (section === "teaching") return `M${P(a, c)} L${P(mid - 2.5, c)} M${P(mid - 2.5, c - 6)} L${P(mid - 2.5, c + 6)} M${P(mid + 2.5, c - 6)} L${P(mid + 2.5, c + 6)} M${P(mid + 2.5, c)} L${P(b, c)}`;
  return `M${P(a, c)} L${P(mid - 4, c)} M${P(mid - 4, c - 5)} L${P(mid - 4, c + 5)} L${P(mid + 4, c)} Z M${P(mid + 4, c - 5)} L${P(mid + 4, c + 5)} M${P(mid + 4, c)} L${P(b, c)}`;
};
// Branch to a parallel lane and back.
const jog = (p: (typeof parts)[number]) => p.c === p.bus ? "" : `M${P(p.x1 - 5, p.bus)} L${P(p.x1 - 5, p.c)} L${P(p.x1, p.c)} M${P(p.x2, p.c)} L${P(p.x2 + 5, p.c)} L${P(p.x2 + 5, p.bus)}`;
// LEDs: every linked output or event, off the role's line at its time, down to ground.
const leds = parts.flatMap((p) => p.r.related.filter((id) => id in dated && refs[id]).map((id, i) => {
  const a = Math.min(p.x2 - 3, Math.max(p.x1 + 3, along(dated[id].t))), dir = p.c >= p.bus ? 1 : -1;
  return { id, a, c: p.c, dir, delay: (i * 0.37 + a * 0.013) % 3 };
}));
// Junctions: roles of different kinds that are linked, joined when the later one began.
const index = Object.fromEntries(parts.filter((p) => p.r.id).map((p) => [p.r.id!, p]));
const seen = new Set<string>();
const junctions = parts.flatMap((p) => p.r.related.filter((id) => index[id] && index[id].k !== p.k).flatMap((id) => {
  const key = [p.r.id, id].sort().join();
  if (seen.has(key)) return [];
  seen.add(key);
  const q = index[id], a = Math.max(Math.min(p.x1, p.x2 - 6), Math.min(q.x1, q.x2 - 6)) + 3;
  return [{ a, from: p.c, to: q.c }];
}));
const years = Array.from({ length: Math.floor(now / 12) - firstYear + 1 }, (_, i) => firstYear + i).filter((y) => (y - firstYear) % (vertical ? 2 : 1) === 0);
---

<div class="fig circuit">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Path since ${firstYear} as a circuit: roles as components on one bus per kind, linked work as LEDs`}>
    {years.map((y) => <text class="year" {...(vertical ? { x: 4, y: f(along(y * 12) + 3) } : { x: f(along(y * 12)), y: height - 6, "text-anchor": "middle" })}>{y}</text>)}
    {buses.map((bus, k) => (
      <g>
        <path class="wire" d={`M${P(a0 - 14, busAt(k))} L${P(a1, busAt(k))}`} />
        <path class="current" d={`M${P(a0 - 14, busAt(k))} L${P(a1, busAt(k))}`} />
        {/* A source at the start of each bus. */}
        <path class="wire" d={`M${P(a0 - 22, busAt(k) - 7)} L${P(a0 - 22, busAt(k) + 7)} M${P(a0 - 17, busAt(k) - 4)} L${P(a0 - 17, busAt(k) + 4)}`} />
        {vertical
          ? <text class="bus" x={f(busAt(k))} y="12" text-anchor="middle">{bus.title}</text>
          : <text class="bus" x={a0 - 30} y={f(busAt(k) + 3.5)} text-anchor="end">{bus.title}</text>}
      </g>
    ))}
    {junctions.map((j) => (
      <g class="junction">
        <path d={`M${P(j.a, j.from)} L${P(j.a, j.to)}`} />
        <circle cx={vertical ? j.from : j.a} cy={vertical ? j.a : j.from} r="2.6" />
        <circle cx={vertical ? j.to : j.a} cy={vertical ? j.a : j.to} r="2.6" />
      </g>
    ))}
    {parts.map((p) => (
      <a href={p.r.id && refs[p.r.id] ? refs[p.r.id].href : `/path/#${p.r.section}`} class="part">
        <title>{p.name} · {p.r.org} · {p.r.role} · {p.r.to - p.r.from} months</title>
        <rect class="gap" {...(vertical ? { x: f(p.c - 8), y: f(p.x1), width: 16, height: f(p.x2 - p.x1) } : { x: f(p.x1), y: f(p.c - 8), width: f(p.x2 - p.x1), height: 16 })} />
        <path class="wire" d={jog(p)} />
        <path class="component" d={component(p.r.section, p.x1, p.x2, p.c)} />
        {!vertical && p.x2 - p.x1 > 26 && <text class="designator" x={f((p.x1 + p.x2) / 2)} y={f(p.c - (p.c < p.bus ? 26 : 10))} text-anchor="middle">{p.x2 - p.x1 > 70 ? `${p.name} ${shortName(p.r.org, Math.floor((p.x2 - p.x1) / 7) - 3)}` : p.name}</text>}
      </a>
    ))}
    {leds.map((l) => {
      const [c1, c2] = [l.c + l.dir * 6, l.c + l.dir * 16];
      return (
        <a href={refs[l.id].href} class="led" style={`animation-delay: ${l.delay.toFixed(2)}s`}>
          <title>{refs[l.id].kind}: {refs[l.id].title}</title>
          <path class="wire" d={`M${P(l.a, l.c)} L${P(l.a, c1)} M${P(l.a, c2 + l.dir * 4)} L${P(l.a, c2 + l.dir * 6)} M${P(l.a - 3, c2 + l.dir * 6)} L${P(l.a + 3, c2 + l.dir * 6)}`} />
          <circle cx={vertical ? (c1 + c2) / 2 : l.a} cy={vertical ? l.a : (c1 + c2) / 2} r="4.4" />
        </a>
      );
    })}
  </svg>
  <p class="key">Each kind of role is a bus; each role a component, as long as it lasted (R resistor: research, C capacitor: teaching, L inductor: leadership, D diode: other). Parallel branches are roles held at the same time; blinking LEDs are linked outputs and events; junctions join linked roles.</p>
</div>
