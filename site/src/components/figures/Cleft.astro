---
// Frogger across the synaptic cleft: you are a dopamine molecule, released at the presynaptic
// membrane (bottom). Hop across the cleft (arrow keys, WASD or tap) past degrading enzymes to a free
// receptor on the postsynaptic membrane (top). Bind them all to transmit the signal; then it gets
// faster. Being degraded, missing a receptor or diffusing away costs a life (of 3).
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="cleft" width={width} height={Math.round(width * (width > 600 ? 0.5 : 1.15))}
  label="Cleft: move a dopamine molecule across the synaptic cleft with the arrow keys or by tapping, past enzymes, to a free receptor"
  rules={["The synaptic cleft", "You are dopamine. Hop up across the cleft (arrow keys, WASD, or tap where to go) to a free receptor.", "Dodge COMT and MAO: they degrade you. Bind every receptor to transmit the signal.", "Being degraded, missing a receptor or diffusing away costs a life. You have 3."]} />

<script>
  import { begin, best, corners, gameOver, loop, pointer, setup, type Game } from "../../lib/game";

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.cleft")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, LANES = W > 600 ? 5 : 6, rows = LANES + 2, rowH = (H - 34) / rows, top = 30;
    const cols = Math.max(9, Math.floor(W / 46)), colW = W / cols;
    const slots = Array.from({ length: 5 }, (_, k) => Math.round(((k + 0.5) / 5) * cols - 0.5));
    type Enzyme = { lane: number; x: number; w: number; name: string };
    let state: "idle" | "running" | "over" = "idle";
    let pos = [Math.floor(cols / 2), rows - 1], bound: boolean[] = [], enzymes: Enzyme[] = [], speeds: number[] = [];
    let level = 1, signals = 0, lives = 3, timer = 0, note = "", noteLeft = 0, hop = 0;
    const rowY = (r: number) => top + r * rowH + rowH / 2;

    const setupLanes = () => {
      speeds = Array.from({ length: LANES }, (_, k) => (k % 2 ? -1 : 1) * W * (0.06 + Math.random() * 0.06 + level * 0.025));
      enzymes = [];
      for (let lane = 0; lane < LANES; lane++) {
        const n = 2 + Math.floor(Math.random() * 2) + (level > 2 ? 1 : 0), w = colW * (1.2 + Math.random() * 0.9);
        for (let k = 0; k < n; k++) enzymes.push({ lane, x: (k / n) * (W + w) + Math.random() * colW, w, name: Math.random() < 0.5 ? "COMT" : "MAO" });
      }
    };
    const membrane = (c: CanvasRenderingContext2D, y: number, ink: string, bg: string) => {
      c.strokeStyle = ink; c.lineWidth = 0.8;
      for (let x = 4; x < W; x += 7) for (const side of [-1, 1]) {
        c.beginPath(); c.moveTo(x, y + side * 9); c.lineTo(x + 1, y + side * 2); c.stroke();
        c.fillStyle = bg; c.beginPath(); c.arc(x, y + side * 11, 2.6, 0, Math.PI * 2); c.fill(); c.stroke();
      }
    };

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      membrane(c, top + rowH * 0.3, ink, bg);
      membrane(c, top + rowH * (rows - 0.3), ink, bg);
      // Receptors: cups on the postsynaptic membrane, filled once bound.
      slots.forEach((col, k) => {
        const [x, y] = [(col + 0.5) * colW, rowY(0) + 4];
        c.strokeStyle = ink; c.lineWidth = 2; c.fillStyle = bound[k] ? ink : bg;
        c.beginPath(); c.moveTo(x - 12, y - 10); c.lineTo(x - 12, y + 6); c.quadraticCurveTo(x, y + 14, x + 12, y + 6); c.lineTo(x + 12, y - 10); c.stroke();
        if (bound[k]) { c.beginPath(); c.arc(x, y + 2, 7, 0, Math.PI * 2); c.fill(); }
      });
      // Enzymes: blobs with an open active site, named.
      for (const e of enzymes) {
        const y = rowY(e.lane + 1), dir = Math.sign(speeds[e.lane]);
        c.fillStyle = bg; c.strokeStyle = ink; c.lineWidth = 1.3;
        c.beginPath(); c.roundRect(e.x, y - rowH * 0.32, e.w, rowH * 0.64, rowH * 0.32); c.fill(); c.stroke();
        const mouth = dir > 0 ? e.x + e.w : e.x;
        c.fillStyle = bg; c.beginPath(); c.moveTo(mouth, y - 5); c.lineTo(mouth - dir * 9, y); c.lineTo(mouth, y + 5); c.fill(); c.stroke();
        c.fillStyle = muted; c.font = `9px ${mono}`; c.textAlign = "center"; c.fillText(e.name, e.x + e.w / 2, y + 3);
      }
      // Dopamine.
      if (state !== "idle") {
        const [x, y] = [(pos[0] + 0.5) * colW, rowY(pos[1]) - Math.sin(hop * Math.PI) * 6];
        c.fillStyle = ink; c.beginPath(); c.roundRect(x - 14, y - 9, 28, 18, 9); c.fill();
        c.fillStyle = bg; c.font = `600 10px ${mono}`; c.textAlign = "center"; c.fillText("DA", x, y + 3.5);
        // Diffusion timer.
        c.strokeStyle = muted; c.lineWidth = 2;
        const left = Math.max(0, 1 - timer / 14);
        c.beginPath(); c.moveTo(W / 2 - W * 0.25 * left, H - 4); c.lineTo(W / 2 + W * 0.25 * left, H - 4); c.stroke();
      }
      if (noteLeft > 0) { c.fillStyle = ink; c.font = `600 12px ${mono}`; c.textAlign = "left"; c.fillText(note, 8, rowY(rows - 1) + 4); }
      corners(game, "cleft", `${signals} signals · lives ${"●".repeat(lives)}${"○".repeat(3 - lives)}`);
    }

    const release = () => { [pos, timer] = [[Math.floor(cols / 2), rows - 1], 0]; };
    const lose = (why: string) => {
      lives -= 1;
      [note, noteLeft] = [why, 1.4];
      if (lives <= 0) {
        state = "over";
        const record = best("cleft", signals);
        gameOver(game, `${why} · ${signals} signals transmitted${signals >= record && signals > 0 ? " · new best!" : ""}`);
      } else release();
    };
    const go = (dc: number, dr: number) => {
      if (state !== "running") return;
      pos = [Math.max(0, Math.min(cols - 1, pos[0] + dc)), Math.max(0, Math.min(rows - 1, pos[1] + dr))];
      hop = 1;
      if (pos[1] === 0) {
        const k = slots.indexOf(pos[0]);
        if (k < 0 || bound[k]) return lose(k < 0 ? "No receptor there" : "That receptor is taken");
        bound[k] = true;
        [note, noteLeft] = ["bound!", 0.8];
        if (bound.every(Boolean)) { signals += 1; level += 1; bound = slots.map(() => false); setupLanes(); [note, noteLeft] = [`signal transmitted · level ${level}`, 1.6]; }
        release();
      }
    };
    const step = (dt: number) => {
      timer += dt; noteLeft -= dt; hop = Math.max(0, hop - dt * 6);
      for (const e of enzymes) {
        e.x += speeds[e.lane] * dt;
        if (speeds[e.lane] > 0 && e.x > W) e.x = -e.w;
        if (speeds[e.lane] < 0 && e.x + e.w < 0) e.x = W;
      }
      const lane = pos[1] - 1, x = (pos[0] + 0.5) * colW;
      if (state === "running" && lane >= 0 && lane < LANES && enzymes.some((e) => e.lane === lane && x > e.x - 10 && x < e.x + e.w + 10)) lose("Degraded by an enzyme");
      if (state === "running" && timer > 14) lose("Diffused away");
      draw();
      return state === "running";
    };
    const start = () => {
      [state, level, signals, lives, bound] = ["running", 1, 0, 3, slots.map(() => false)];
      setupLanes();
      release();
      begin(game, "Hop across to a free receptor");
      loop(game, step);
    };
    const KEYS: Record<string, [number, number]> = { ArrowUp: [0, -1], ArrowDown: [0, 1], ArrowLeft: [-1, 0], ArrowRight: [1, 0], w: [0, -1], s: [0, 1], a: [-1, 0], d: [1, 0] };
    game.element.addEventListener("keydown", (event) => {
      if (event.repeat) return;
      if (state !== "running") { if (event.key.length === 1 || event.key in KEYS || event.key === "Enter") { event.preventDefault(); start(); } return; }
      if (event.key in KEYS) { event.preventDefault(); go(...KEYS[event.key]); }
    });
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      if (state !== "running") return start();
      const [x, y] = pointer(game, event), [dx, dy] = [x - (pos[0] + 0.5) * colW, y - rowY(pos[1])];
      if (Math.abs(dx) > Math.abs(dy)) go(Math.sign(dx), 0); else go(0, Math.sign(dy));
    });
    draw();
  }
</script>
