---
// The co-author network as neurons: one neuron per recurring collaborator (at least two shared
// works) plus one for me, axons for co-authorship, and spikes that fire more often along stronger
// collaborations. Hovering a neuron shows the name and the number of shared works.
import { myWorks } from "../../lib/career";
import { isMe } from "../../lib/data";
import { curve, forceLayout } from "../../lib/figure";
import { random } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

// The same person can be written differently ("A. Mendes", "A.I. da Silva Mendes"): key on the
// first initial and the last word of the surname, and show the most common spelling.
const key = (name: string) => (isMe(name) ? "me" : `${name[0]} ${name.split(/[\s.]+/).filter(Boolean).at(-1)}`);
// A preprint and its dataset can share a title and authors: count each title once.
const distinct = [...new Map(myWorks.map((w) => [w.title.toLowerCase(), w])).values()];
const spellings = new Map<string, Map<string, number>>();
const shared = new Map<string, number>();
for (const work of distinct) {
  for (const author of new Set(work.authors.map(key))) shared.set(author, (shared.get(author) ?? 0) + 1);
  for (const author of work.authors) {
    const counts = spellings.get(key(author)) ?? new Map();
    spellings.set(key(author), counts.set(author, (counts.get(author) ?? 0) + 1));
  }
}
const people = ["me", ...[...shared].filter(([k, n]) => k !== "me" && n >= 2).sort((a, b) => b[1] - a[1]).map(([k]) => k)];
const name = (k: string) => [...spellings.get(k)!].sort((a, b) => b[1] - a[1])[0][0];

// Edges: pairs of these people who appear on the same work, weighted by how often.
const weights = new Map<string, number>();
for (const work of distinct) {
  const present = [...new Set(work.authors.map(key))].filter((k) => people.includes(k)).map((k) => people.indexOf(k));
  for (let a = 0; a < present.length; a++) {
    for (let b = a + 1; b < present.length; b++) {
      const pair = [present[a], present[b]].sort((x, y) => x - y).join(" ");
      weights.set(pair, (weights.get(pair) ?? 0) + 1);
    }
  }
}
const edges = [...weights].map(([pair, w]) => ({ pair: pair.split(" ").map(Number), w }));

const uniform = random(seed);
const at = forceLayout(people.length, edges, width, height, 40, uniform);
const radius = people.map((p) => 3.5 + Math.sqrt(shared.get(p) ?? 1) * 1.1);

const f = (v: number) => v.toFixed(1);
const axons = edges.map(({ pair: [i, j], w }) => ({ d: curve(at[i], at[j], (uniform() - 0.5) * 0.5), w, delay: uniform() * 6 }));
const dendrites = at.map(([x, y], i) => Array.from({ length: 4 }, (_, n) => {
  const a = (2 * Math.PI * n) / 4 + uniform() * 1.2, l = radius[i] + 6 + uniform() * 7;
  return `M${f(x)},${f(y)} Q${f(x + Math.cos(a + 0.4) * l * 0.6)},${f(y + Math.sin(a + 0.4) * l * 0.6)} ${f(x + Math.cos(a) * l)},${f(y + Math.sin(a) * l)}`;
}).join(" "));
---

<div class="fig collaborators">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Co-author network with ${people.length - 1} recurring collaborators`}>
    {axons.map((axon) => <path class="axon" d={axon.d} stroke-width={(0.5 + axon.w * 0.25).toFixed(2)} />)}
    {axons.map((axon) => (
      <path class="spike" d={axon.d} pathLength="1" style={`animation-duration: ${(9 / (1 + axon.w)).toFixed(2)}s; animation-delay: ${axon.delay.toFixed(2)}s`} />
    ))}
    {dendrites.map((d) => <path class="dendrite" d={d} />)}
    {at.map(([x, y], i) => (
      <circle class:list={["soma", { me: i === 0 }]} cx={f(x)} cy={f(y)} r={radius[i].toFixed(1)}>
        <title>{i === 0 ? "Me" : `${name(people[i])} · ${shared.get(people[i])} shared works`}</title>
      </circle>
    ))}
  </svg>
</div>
