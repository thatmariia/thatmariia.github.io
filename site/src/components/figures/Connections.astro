---
// The portfolio in date order: every item is a small mark (shape shows its kind), and the
// cross-links between items arc above the axis, so a preprint can be seen leading to a paper, a
// poster and a talk. Pulses travel along the arcs. Hover lights up an item's links; click opens it.
import { month } from "../../lib/career";
import { data, PAGE_OF, refs, type Entry, type Work } from "../../lib/data";
import { hoverCss } from "../../lib/figure";
import { random } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const GROUP: Record<string, string> = {
  publications: "paper", preprints: "paper", events: "event", outreach: "event",
  software: "output", datasets: "output", posters: "output", presentations: "output", reports: "output", websites: "output", theses: "output",
};
const uniform = random(seed);
// Every dated item: works by year (spread over the year), entries by their first start. Education
// has no public dates and is left out.
const items = Object.keys(PAGE_OF).flatMap((section) =>
  ((data as any)[section] as (Work & Entry)[]).filter((item) => "year" in item || item.periods[0].start).map((item) => ({
    id: item.id, related: item.related ?? [], group: GROUP[section] ?? "role",
    at: "year" in item ? item.year * 12 + 2 + Math.floor(uniform() * 8) : month(item.periods[0].start!),
  })));
const linked = items.filter((i) => i.id && i.related.length);
const index = new Map(linked.map((item, k) => [item.id!, k]));
const arcsData = new Set<string>();
linked.forEach((item, k) => item.related.forEach((r) => index.has(r) && arcsData.add([k, index.get(r)!].sort((a, b) => a - b).join(" "))));

// Linked items are spaced evenly in date order rather than on a linear time axis: most links are
// recent, and a linear axis would squeeze them together. On tall screens the axis runs down the
// left and the arcs bulge to the right.
const vertical = height > width;
const [from, to] = vertical ? [16, height - 28] : [16, width - 16];
const base = vertical ? 46 : height - 40;
const order = [...linked].sort((a, b) => a.at - b.at);
const along = (item: (typeof linked)[number]) => from + (order.indexOf(item) / (order.length - 1)) * (to - from);
const point = (t: number, lift = 0): [number, number] => (vertical ? [base + lift, t] : [t, base - lift]);
const f = (v: number) => v.toFixed(1);
const room = vertical ? width - base - 12 : base - 12;
const arcs = [...arcsData].map((pair) => {
  const [a, b] = pair.split(" ").map(Number), [ta, tb] = [along(linked[a]), along(linked[b])].sort((p, q) => p - q);
  const rise = Math.min(room, 12 + (tb - ta) * 0.9) * 1.33;
  const [p0, c1, c2, p1] = [point(ta), point(ta, rise), point(tb, rise), point(tb)];
  return { d: `M${f(p0[0])},${f(p0[1])} C${f(c1[0])},${f(c1[1])} ${f(c2[0])},${f(c2[1])} ${f(p1[0])},${f(p1[1])}`, touches: pair, delay: uniform() * 5 };
});
// A year label where each year's first item sits, skipping labels that would collide.
const years: { year: number; t: number }[] = [];
for (const item of order) {
  const year = Math.floor(item.at / 12);
  if (years.at(-1)?.year !== year && (years.length === 0 || along(item) - years.at(-1)!.t > (vertical ? 16 : 36))) years.push({ year, t: along(item) });
}
const mark = (group: string, [cxv, cyv]: [number, number], r: number) =>
  group === "paper" || group === "event" ? { tag: "circle", cx: f(cxv), cy: f(cyv), r: f(r) } : { tag: "rect", x: f(cxv - r), y: f(cyv - r), width: f(2 * r), height: f(2 * r) };
const id = `cn-${seed}-${width}`;
---

<div class:list={["fig connections", id]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${linked.length} linked items in date order, with ${arcs.length} links between them`}>
    {arcs.map((arc, i) => (
      <g class="line" data-touches={arc.touches} style={`--i: ${i % 9}`}>
        <path class="arc" d={arc.d} />
        <path class="pulse" d={arc.d} pathLength="1" style={`animation-delay: ${arc.delay.toFixed(2)}s`} />
      </g>
    ))}
    <line class="axis" x1={point(from)[0]} y1={point(from)[1]} x2={point(to)[0]} y2={point(to)[1]} />
    {linked.map((item, k) => {
      const m = mark(item.group, point(along(item)), 4.5);
      return (
        <a href={refs[item.id!].href} data-node={k} class:list={["item", item.group]}>
          <title>{refs[item.id!].kind}: {refs[item.id!].title}</title>
          {m.tag === "circle" ? <circle cx={m.cx} cy={m.cy} r={m.r} /> : <rect x={m.x} y={m.y} width={m.width} height={m.height} />}
        </a>
      );
    })}
    {years.map(({ year, t }) => vertical
      ? <text x={f(base - 10)} y={f(t + 3)} text-anchor="end">{year}</text>
      : <text x={f(t)} y={f(base + 22)} text-anchor="middle">{year}</text>)}
    <text class="key" x={vertical ? width - 6 : to} y={height - 6} text-anchor="end">● paper  ■ output  ○ event  □ role</text>
  </svg>
  <style is:inline set:html={hoverCss(id, linked.length)} />
</div>
