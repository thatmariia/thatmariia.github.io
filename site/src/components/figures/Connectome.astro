---
// Fields around a ring, every pair joined by a small bundle of curved fibres (a connectome).
import { ellipse, hoverCss, place, separate } from "../../lib/figure";
import { random } from "../../lib/random";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, seed, width, height } = Astro.props;

const uniform = random(seed);
const n = fields.length;
const at = ellipse(n, width, height, Math.max(70, width * 0.13), 50, uniform).map((node) => node.at);
separate(at, fields, width, height, 50);
const [cx, cy] = [width / 2, height / 2];
const f = (v: number) => v.toFixed(1);
const fibres: { d: string; touches: string }[] = [];
for (let i = 0; i < n; i++) {
  for (let j = i + 1; j < n; j++) {
    const [a, b] = [at[i], at[j]];
    for (const pull of [0.35, 0.5, 0.65]) {
      // Control point between the pair's midpoint and the centre, jittered a little per fibre.
      const qx = (a[0] + b[0]) / 2 + (cx - (a[0] + b[0]) / 2) * pull + (uniform() - 0.5) * 16;
      const qy = (a[1] + b[1]) / 2 + (cy - (a[1] + b[1]) / 2) * pull + (uniform() - 0.5) * 16;
      fibres.push({ d: `M${f(a[0])},${f(a[1])} Q${f(qx)},${f(qy)} ${f(b[0])},${f(b[1])}`, touches: `${i} ${j}` });
    }
  }
}
const id = `cn-${seed}-${width}`;
---

<div class:list={["fig connectome", id]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields connected to each other: ${fields.join(", ")}`}>
    {fibres.map((fibre, i) => <path class="line" data-touches={fibre.touches} d={fibre.d} style={`--i: ${i % 9}`} pathLength="1" />)}
  </svg>
  {at.map((p, i) => <span class="node" data-node={i} style={place(p, width, height)}>{fields[i]}</span>)}
  <style is:inline set:html={hoverCss(id, n)} />
</div>
