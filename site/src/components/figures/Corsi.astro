---
// The Corsi block-tapping task, a classic test of spatial working memory: blocks light up one by
// one; tap them back in the same order (or press their numbers). Each success adds a block to the
// sequence; one mistake ends it, with your span and one of the website's items as the prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="corsi" width={width} height={Math.round(width * (width > 600 ? 0.42 : 0.95))}
  label="Corsi blocks: watch the blocks light up, then tap them, or press their numbers, in the same order"
  hint="Watch, then tap the blocks in order (or press 1–9)" />

<script>
  import { banner, best, corners, gameOver, loop, pointer, setup, type Game } from "../../lib/game";

  // The nine blocks of the original board (Corsi, 1972), roughly, on a unit square.
  const BOARD = [[0.12, 0.72], [0.3, 0.42], [0.22, 0.12], [0.5, 0.62], [0.47, 0.25], [0.68, 0.84], [0.75, 0.4], [0.88, 0.14], [0.86, 0.68]];
  for (const figure of document.querySelectorAll<HTMLElement>(".fig.corsi")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, size = Math.min(W, H) * 0.11;
    const [ox, oy, bw, bh] = [W / 2 - Math.min(W * 0.8, H * 1.6) / 2, 44, Math.min(W * 0.8, H * 1.6), H - 44 - size - 20];
    const blocks = BOARD.map(([u, v]) => [ox + u * (bw - size), oy + v * bh]);
    let state: "idle" | "showing" | "answer" | "over" = "idle";
    let sequence: number[] = [], given: number[] = [], lit = -1, clock = 0, span = 2, note = "", noteLeft = 0;

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      blocks.forEach(([x, y], i) => {
        const on = i === lit;
        c.fillStyle = on ? ink : bg; c.strokeStyle = ink; c.lineWidth = 1.4;
        c.beginPath(); c.roundRect(x, y, size, size, 8); c.fill(); c.stroke();
        c.fillStyle = on ? bg : muted; c.font = `10px ${mono}`; c.textAlign = "left";
        c.fillText(String(i + 1), x + 5, y + 13);
      });
      c.fillStyle = ink; c.font = `600 12px ${mono}`; c.textAlign = "center";
      const status = state === "showing" ? "watch…" : state === "answer" ? `your turn: ${given.length} / ${sequence.length}` : "";
      c.fillText(noteLeft > 0 ? note : status, W / 2, 24);
      corners(game, "corsi", `span ${span}`);
      if (state === "idle") banner(game, ["Corsi block-tapping task", "blocks light up in a sequence", "tap them back in order (or press 1–9)", "each round adds one · one mistake ends it"]);
      if (state === "over") banner(game, [`Your Corsi span: ${span - 1}`, "most people manage 5 to 7", "press a key or tap to try again"]);
    }

    const round = () => {
      sequence = [];
      while (sequence.length < span) { const b = Math.floor(Math.random() * 9); if (b !== sequence[sequence.length - 1]) sequence.push(b); }
      [given, state, clock, lit] = [[], "showing", -0.6, -1];
    };
    const step = (dt: number) => {
      clock += dt; noteLeft -= dt;
      if (state === "showing") {
        // Each block lights for 0.6 s, with 0.25 s between.
        const k = Math.floor(clock / 0.85), within = clock - k * 0.85;
        lit = clock >= 0 && k < sequence.length && within < 0.6 ? sequence[k] : -1;
        if (clock >= 0 && k >= sequence.length) [state, lit] = ["answer", -1];
      } else if (state === "answer" && lit >= 0 && clock > 0.25) lit = -1;
      draw();
      return state !== "over";
    };
    const tap = (b: number) => {
      if (state !== "answer") return;
      [lit, clock] = [b, 0];
      given.push(b);
      if (sequence[given.length - 1] !== b) {
        state = "over";
        const record = best("corsi", span - 1);
        gameOver(game.readout, game.pool, `<strong>Corsi span ${span - 1}</strong> · the sequence was ${sequence.map((s) => s + 1).join("–")}${span - 1 >= record && span > 2 ? " · new best!" : ""}`);
        draw();
      } else if (given.length === sequence.length) {
        span += 1;
        [note, noteLeft] = [`correct: span ${span - 1}`, 1];
        setTimeout(round, 700);
      }
    };
    const start = () => {
      span = 2;
      game.readout.innerHTML = '<span class="hint">Watch the sequence, then repeat it</span>';
      round();
      loop(step);
    };
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      if (state === "idle" || state === "over") return start();
      const [x, y] = pointer(game, event), b = blocks.findIndex(([bx, by]) => x >= bx && x <= bx + size && y >= by && y <= by + size);
      if (b >= 0) tap(b);
    });
    game.element.addEventListener("keydown", (event) => {
      if (state === "idle" || state === "over") { if (event.key.length === 1 || event.key === "Enter") { event.preventDefault(); start(); } return; }
      if (/^[1-9]$/.test(event.key)) { event.preventDefault(); tap(Number(event.key) - 1); }
    });
    draw();
  }
</script>
