---
// Beat Dijkstra: click (or type) nodes to walk from S to T along the cheapest path in a weighted
// graph, before the time runs out. Find the optimum and the next graph is bigger; a costlier path
// or a timeout ends it, with Dijkstra's answer shown and one of the website's items as the prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="dijkstra" width={width} height={Math.round(width * (width > 600 ? 0.42 : 1))}
  label="Dijkstra: click or type the letters of nodes to build the cheapest path from S to T in a weighted graph"
  hint="Click nodes (or type their letters) from S to T · Backspace to undo" />

<script>
  import { banner, best, corners, gameOver, loop, pointer, setup, type Game } from "../../lib/game";

  type Graph = { nodes: number[][]; edges: Map<string, number>; s: number; t: number; best: number; route: number[] };
  const key = (a: number, b: number) => (a < b ? `${a}-${b}` : `${b}-${a}`);
  const LETTERS = "ABCDEFGHIJKLMNOPQRUVWXYZ";

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.dijkstra")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, r = 13;
    let state: "idle" | "running" | "solved" | "over" = "idle";
    let graph: Graph | null = null, path: number[] = [], level = 0, clock = 0, limit = 25, note = "";

    const build = (n: number): Graph => {
      // Points kept apart, then each joined to its nearest neighbours, plus a spanning tree.
      const nodes: number[][] = [];
      for (let tries = 0; nodes.length < n && tries < 4000; tries++) {
        const p = [30 + Math.random() * (W - 60), 50 + Math.random() * (H - 80)];
        if (nodes.every((q) => Math.hypot(p[0] - q[0], p[1] - q[1]) > Math.min(W, H) * 0.16)) nodes.push(p);
      }
      const d = (a: number, b: number) => Math.hypot(nodes[a][0] - nodes[b][0], nodes[a][1] - nodes[b][1]);
      const edges = new Map<string, number>(), weight = () => 1 + Math.floor(Math.random() * 9);
      nodes.forEach((_, a) => nodes.map((_, b) => b).filter((b) => b !== a).sort((x, y) => d(a, x) - d(a, y)).slice(0, 2 + (Math.random() < 0.4 ? 1 : 0)).forEach((b) => edges.set(key(a, b), weight())));
      const tree = new Set([0]);
      while (tree.size < nodes.length) {
        let pick = [0, 0, Infinity];
        for (const a of tree) for (let b = 0; b < nodes.length; b++) if (!tree.has(b) && d(a, b) < pick[2]) pick = [a, b, d(a, b)];
        if (!edges.has(key(pick[0], pick[1]))) edges.set(key(pick[0], pick[1]), weight());
        tree.add(pick[1]);
      }
      // S and T: the two nodes furthest apart. Dijkstra gives the answer to beat.
      let [s, t] = [0, 1];
      for (let a = 0; a < nodes.length; a++) for (let b = a + 1; b < nodes.length; b++) if (d(a, b) > d(s, t)) [s, t] = [a, b];
      const dist = nodes.map(() => Infinity), prev = nodes.map(() => -1), done = new Set<number>();
      dist[s] = 0;
      while (done.size < nodes.length) {
        const u = dist.map((v, i) => [v, i]).filter(([, i]) => !done.has(i)).sort((a, b) => a[0] - b[0])[0][1];
        done.add(u);
        for (const [k, w] of edges) { const [a, b] = k.split("-").map(Number); const v = a === u ? b : b === u ? a : -1; if (v >= 0 && dist[u] + w < dist[v]) { dist[v] = dist[u] + w; prev[v] = u; } }
      }
      const route = [t];
      while (route[0] !== s) route.unshift(prev[route[0]]);
      return { nodes, edges, s, t, best: dist[t], route };
    };
    const cost = (p: number[]) => p.slice(1).reduce((sum, b, i) => sum + graph!.edges.get(key(p[i], b))!, 0);

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      if (graph) {
        const onPath = new Set(path.slice(1).map((b, i) => key(path[i], b)));
        const optimal = new Set(state === "over" ? graph.route.slice(1).map((b, i) => key(graph!.route[i], b)) : []);
        for (const [k, w] of graph.edges) {
          const [a, b] = k.split("-").map(Number), [p, q] = [graph.nodes[a], graph.nodes[b]];
          c.strokeStyle = ink; c.lineWidth = onPath.has(k) ? 4 : 1; c.globalAlpha = onPath.has(k) ? 1 : 0.45;
          c.setLineDash(optimal.has(k) ? [6, 4] : []);
          if (optimal.has(k)) { c.lineWidth = 2.5; c.globalAlpha = 1; }
          c.beginPath(); c.moveTo(p[0], p[1]); c.lineTo(q[0], q[1]); c.stroke();
          c.setLineDash([]); c.globalAlpha = 1;
          const [mx, my] = [(p[0] + q[0]) / 2, (p[1] + q[1]) / 2];
          c.fillStyle = bg; c.beginPath(); c.arc(mx, my, 8, 0, Math.PI * 2); c.fill();
          c.fillStyle = ink; c.font = `600 11px ${mono}`; c.textAlign = "center"; c.textBaseline = "middle"; c.fillText(String(w), mx, my + 1);
        }
        graph.nodes.forEach(([x, y], i) => {
          const special = i === graph!.s || i === graph!.t, here = i === path[path.length - 1];
          c.fillStyle = special || here ? ink : bg; c.strokeStyle = ink; c.lineWidth = 1.6;
          c.beginPath(); c.arc(x, y, r, 0, Math.PI * 2); c.fill(); c.stroke();
          c.fillStyle = special || here ? bg : ink; c.font = `600 12px ${mono}`;
          c.fillText(i === graph!.s ? "S" : i === graph!.t ? "T" : LETTERS[i], x, y + 1);
        });
        c.textBaseline = "alphabetic";
        if (state === "running") {
          const left = Math.max(0, 1 - clock / limit);
          c.strokeStyle = muted; c.lineWidth = 2;
          c.beginPath(); c.moveTo(W / 2 - W * 0.3 * left, H - 8); c.lineTo(W / 2 + W * 0.3 * left, H - 8); c.stroke();
        }
      }
      c.fillStyle = ink; c.font = `600 12px ${mono}`; c.textAlign = "center";
      if (state === "running" || state === "solved") c.fillText(state === "solved" ? note : `cost so far ${cost(path)}`, W / 2, 24);
      corners(game, "dijkstra", `level ${level}`);
      if (state === "idle") banner(game, ["Beat Dijkstra", "walk from S to T along the cheapest path", "click nodes or type their letters · backspace undoes", "match Dijkstra's optimum before the time runs out"]);
      if (state === "over") banner(game, [note, "dashed: Dijkstra's path · press a key or tap"], 30);
    }

    const next = () => {
      level += 1;
      graph = build(Math.min(W > 600 ? 16 : 11, 6 + level));
      [path, clock, limit, state] = [[graph.s], 0, Math.max(9, 26 - level * 1.4), "running"];
    };
    const end = (why: string) => {
      state = "over"; note = why;
      const record = best("dijkstra", level - 1);
      gameOver(game.readout, game.pool, `<strong>${why}</strong> · Dijkstra's path costs ${graph!.best} · reached level ${level}${level - 1 >= record && level > 1 ? " · new best!" : ""}`);
    };
    const choose = (i: number) => {
      if (state !== "running" || !graph) return;
      const last = path[path.length - 1];
      if (i === last || !graph.edges.has(key(last, i)) || (path.includes(i) && i !== path[path.length - 2])) return;
      if (i === path[path.length - 2]) { path.pop(); return; }
      path.push(i);
      if (i === graph.t) {
        if (cost(path) === graph.best) { [state, clock, note] = ["solved", 0, `optimal: ${graph.best}`]; }
        else end(`Your path costs ${cost(path)}`);
      }
    };
    const step = (dt: number) => {
      clock += dt;
      if (state === "running" && clock > limit) end("Out of time");
      if (state === "solved" && clock > 0.9) next();
      draw();
      return state !== "over";
    };
    const start = () => {
      level = 0;
      game.readout.innerHTML = '<span class="hint">Find the cheapest path from S to T</span>';
      next();
      loop(step);
    };
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      if (state === "idle" || state === "over") return start();
      const [x, y] = pointer(game, event), i = graph!.nodes.findIndex(([nx, ny]) => Math.hypot(nx - x, ny - y) < r + 8);
      if (i >= 0) choose(i);
    });
    game.element.addEventListener("keydown", (event) => {
      if (state === "idle" || state === "over") { if (event.key.length === 1 || event.key === "Enter") { event.preventDefault(); start(); } return; }
      if (event.key === "Backspace" && path.length > 1) { event.preventDefault(); path.pop(); return; }
      const k = event.key.toUpperCase(), i = k === "T" ? graph!.t : LETTERS.indexOf(k);
      if (k.length === 1 && i >= 0 && i < graph!.nodes.length && i !== graph!.s) { event.preventDefault(); choose(i); }
    });
    draw();
  }
</script>
