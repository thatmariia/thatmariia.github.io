---
// Path as an EEG recording: one channel per kind of role, plus one for events. A channel
// oscillates while I held roles of its kind (more roles, larger waves) and lies flat otherwise;
// every output or event linked to those roles fires a spike. The recording sweeps on a loop.
import { dated, firstYear, month, now, roleEntries } from "../../lib/career";
import { data, pathSections, type Entry } from "../../lib/data";
import { random } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const uniform = random(seed);
const f = (v: number) => v.toFixed(1);
const [start, end] = [firstYear * 12, now + 2];
const [left, right, top, bottom] = [width < 600 ? 84 : 104, width - 14, 18, height - 36];
const x = (t: number) => left + ((t - start) / (end - start)) * (right - left);

// Channels: kinds of role with their spikes, then events and outreach.
const sections = ["research", "teaching", "leadership", "service", "other"].filter((s) => roleEntries.some((r) => r.section === s));
const channels = [
  ...sections.map((s) => ({
    name: pathSections.find((p) => p.id === s)!.title.toLowerCase(), roles: roleEntries.filter((r) => r.section === s),
    spikes: [...new Set(roleEntries.filter((r) => r.section === s).flatMap((r) => r.related.filter((id) => id in dated)))].map((id) => dated[id].t),
  })),
  { name: "events", roles: [], spikes: (["events", "outreach"] as const).flatMap((s) => (data[s] as Entry[]).map((e) => month(e.periods[0].start!))) },
];
const gap = (bottom - top) / channels.length;
const traces = channels.map((c, k) => {
  const base = top + gap * (k + 0.5), amplitude = gap * 0.2;
  const [p1, p2, p3] = [uniform() * 6, uniform() * 6, uniform() * 6];
  const step = (end - start) / ((right - left) / 1.5);
  const samples = Array.from({ length: Math.ceil((end - start) / step) + 1 }, (_, i) => {
    const t = start + i * step, active = c.roles.filter((r) => r.from <= t && t <= r.to).length;
    const envelope = Math.min(1.6, active * 0.55) + 0.05;
    let v = envelope * (Math.sin(t * 2.1 + p1) * 0.6 + Math.sin(t * 5.3 + p2) * 0.3 + Math.sin(t * 0.7 + p3) * 0.25) + (uniform() - 0.5) * 0.12;
    // Spikes: a sharp biphasic deflection at each linked output or event.
    // (Spikes at the same time do not add up.)
    let spike = 0;
    for (const s of c.spikes) { const d = (t - s) / 0.35; if (Math.abs(d) < 3) spike = Math.max(spike, 2 * Math.exp(-d * d) - 1.1 * Math.exp(-((d - 1.4) ** 2))); }
    v -= spike;
    return `${f(x(t))},${f(base - v * amplitude)}`;
  });
  return { name: c.name, base, points: samples.join(" ") };
});
const years = Array.from({ length: Math.floor(now / 12) - firstYear + 1 }, (_, i) => firstYear + i).filter((y) => (y - firstYear) % (width < 600 ? 3 : 1) === 0);
const clip = `eeg-${width}`;
---

<div class="fig eeg" style={`--sweep: 14s; --span: ${right - left}`}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Path since ${firstYear} as an EEG: one channel per kind of role, spikes for linked outputs and events`}>
    <defs><clipPath id={clip}><rect class="sweep-window" x={left} y="0" width={right - left} height={height} /></clipPath></defs>
    {years.map((y) => (
      <g>
        <line class="grid" x1={f(x(y * 12))} x2={f(x(y * 12))} y1={top} y2={bottom} />
        <text class="year" x={f(x(y * 12))} y={bottom + 16} text-anchor="middle">{y}</text>
      </g>
    ))}
    {traces.map((t) => (
      <g>
        <text x={left - 10} y={f(t.base + 3.5)} text-anchor="end">{t.name}</text>
        <polyline class="trace ghost" points={t.points} />
      </g>
    ))}
    <g clip-path={`url(#${clip})`}>{traces.map((t) => <polyline class="trace" points={t.points} />)}</g>
    <line class="playhead" x1={left} x2={left} y1={top} y2={bottom} />
    <path class="scale" d={`M${left - 10},${bottom + 30} L${left - 10},${f(bottom + 30 - gap * 0.2 * 0.6)}`} />
    <text class="year" x={left - 16} y={bottom + 30} text-anchor="end">1 role</text>
  </svg>
</div>
