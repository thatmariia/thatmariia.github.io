---
// Path as a Feynman diagram, time running left to right. Each organisation is a fermion line (with
// its arrow) from my first to my last role there, a vertex where each role began. Organisations
// linked to each other exchange a gluon (a coil), and every linked output or event leaves its role
// as a photon (a wavy line) out to an external dot. The photons keep propagating.
import { dated, firstYear, now, roleEntries, shortName } from "../../lib/career";
import { refs } from "../../lib/data";
import type { Point } from "../../lib/random";
import { points } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

const vertical = height > width;
const [start, end] = [firstYear * 12 - 2, now + 3];
const f = (v: number) => v.toFixed(1);
const orgs = [...new Set([...roleEntries].sort((a, b) => a.from - b.from).map((r) => r.org))];
const [t0, t1, l0, l1] = vertical ? [30, height - 24, 64, width - 24] : [150, width - 30, 30, height - 44];
const spacing = (l1 - l0) / Math.max(1, orgs.length - 1);
// (time, organisation lane) → screen.
const at = (t: number, lane: number, offset = 0): Point => {
  const [along, across] = [t0 + ((t - start) / (end - start)) * (t1 - t0), l0 + lane * spacing + offset];
  return vertical ? [across, along] : [along, across];
};
const lines = orgs.map((org, lane) => {
  const entries = roleEntries.filter((r) => r.org === org);
  return { org, lane, entries, from: Math.min(...entries.map((e) => e.from)), to: Math.max(...entries.map((e) => e.to)) };
});
const laneOf = Object.fromEntries(roleEntries.filter((r) => r.id).map((r) => [r.id!, orgs.indexOf(r.org)]));

// Gluons between organisations whose roles are linked, when the later of the two began.
const seen = new Set<string>();
const gluons = roleEntries.flatMap((r) => r.related.filter((id) => id in laneOf && laneOf[id] !== orgs.indexOf(r.org)).flatMap((id) => {
  const other = roleEntries.find((e) => e.id === id)!, key = [r.id, id].sort().join();
  if (seen.has(key)) return [];
  seen.add(key);
  return [{ t: Math.max(r.from, other.from), a: orgs.indexOf(r.org), b: laneOf[id], title: `${r.org} ↔ ${other.org}` }];
}));
const coil = (t: number, a: number, b: number) => {
  const [p, q] = [at(t, a), at(t, b)], length = Math.abs(q[1 - +vertical] - p[1 - +vertical]), turns = Math.max(2, Math.round(length / 9)), r = 3.2;
  return Array.from({ length: turns * 16 + 1 }, (_, k) => {
    const s = k / (turns * 16), angle = 2 * Math.PI * turns * s;
    const along = (1 - s) * (vertical ? p[0] : p[1]) + s * (vertical ? q[0] : q[1]) - r * Math.sin(angle) * Math.sign(b - a);
    const across = (vertical ? p[1] : p[0]) + r * (Math.cos(angle) - 1) * 0.9;
    return (vertical ? [along, across] : [across, along]) as Point;
  });
};
// Photons: every linked output or event leaves its role at its time, alternately up and down.
const photons = roleEntries.flatMap((r) => r.related.filter((id) => id in dated && refs[id]).map((id) => ({ id, t: dated[id].t, lane: orgs.indexOf(r.org) })))
  .sort((a, b) => a.t - b.t)
  .map((p, k, all) => {
    // Photons of the same role and year fan out evenly, alternately to either side of the line.
    const group = all.filter((q) => q.lane === p.lane && Math.floor(q.t / 12) === Math.floor(p.t / 12)), i = group.indexOf(p);
    const side = i % 2 ? 1 : -1, half = Math.ceil(group.length / 2), angle = half > 1 ? -1.1 + (2.2 * (i >> 1)) / (half - 1) : 0;
    const length = Math.min(spacing * 1.8, 46) * (0.7 + 0.3 * ((k * 0.618) % 1));
    const s0 = at(p.t, p.lane), [ax, ay] = vertical ? [0, 1] : [1, 0], [px, py] = vertical ? [1, 0] : [0, 1];
    const [dx, dy] = [(px * side * Math.cos(angle) + ax * Math.sin(angle)) * length, (py * side * Math.cos(angle) + ay * Math.sin(angle)) * length];
    const [nx, ny] = [-dy / length, dx / length];
    const wave = Array.from({ length: 41 }, (_, j) => {
      const u = j / 40, w = 2.2 * Math.sin(u * Math.PI * 2 * Math.max(2, Math.round(length / 7)));
      return [s0[0] + dx * u + nx * w, s0[1] + dy * u + ny * w] as Point;
    });
    return { ...p, wave, end: [s0[0] + dx, s0[1] + dy] as Point };
  });
const years = Array.from({ length: Math.floor(now / 12) - firstYear + 1 }, (_, i) => firstYear + i).filter((y) => (y - firstYear) % (vertical ? 2 : 1) === 0);
const arrow = (t: number, lane: number) => {
  const [x, y] = at(t, lane);
  return vertical ? `M${f(x - 3.5)},${f(y - 3)} L${f(x)},${f(y + 3)} L${f(x + 3.5)},${f(y - 3)}` : `M${f(x - 3)},${f(y - 3.5)} L${f(x + 3)},${f(y)} L${f(x - 3)},${f(y + 3.5)}`;
};
---

<div class="fig feynman">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Path since ${firstYear} as a Feynman diagram: organisations as particle lines, links as gluons, outputs and events as photons`}>
    {gluons.map((g) => <polyline class="gluon" points={points(coil(g.t, g.a, g.b))}><title>{g.title}</title></polyline>)}
    {photons.map((p, k) => (
      <a href={refs[p.id].href}>
        <title>{refs[p.id].kind}: {refs[p.id].title}</title>
        <polyline class="photon" points={points(p.wave)} />
        <polyline class="quantum" points={points(p.wave)} pathLength="1" style={`animation-delay: ${(-k * 0.37).toFixed(2)}s`} />
        <circle class="leg" cx={f(p.end[0])} cy={f(p.end[1])} r="2.2" />
      </a>
    ))}
    {lines.map((l) => {
      const [a, b] = [at(l.from, l.lane), at(l.to, l.lane)], [lx, ly] = at(l.from, l.lane);
      return (
        <g class="fermion">
          <title>{l.org}</title>
          <line x1={f(a[0])} y1={f(a[1])} x2={f(b[0])} y2={f(b[1])} />
          {l.to - l.from > 6 && <path class="arrow" d={arrow((l.from + l.to) / 2, l.lane)} />}
          {l.entries.map((e) => { const [x, y] = at(e.from, l.lane); return <circle class="vertex" cx={f(x)} cy={f(y)} r="2.6"><title>{e.role}</title></circle>; })}
          {vertical
            ? <text x={f(lx + 6)} y={f(ly + 8)} transform={`rotate(90 ${f(lx + 6)} ${f(ly + 8)})`}>{shortName(l.org, 16)}</text>
            : <text x={f(lx - 8)} y={f(ly + 3)} text-anchor="end">{shortName(l.org, 19)}</text>}
        </g>
      );
    })}
    {years.map((y) => {
      const along = at(y * 12, 0)[vertical ? 1 : 0];
      return vertical
        ? <text class="year" x="6" y={f(along + 3)}>{y}</text>
        : <text class="year" x={f(along)} y={f(l1 + 24)} text-anchor="middle">{y}</text>;
    })}
    {!vertical && <path class="time" d={`M${t0},${f(l1 + 32)} L${t1},${f(l1 + 32)} M${t1 - 6},${f(l1 + 28)} L${t1},${f(l1 + 32)} L${t1 - 6},${f(l1 + 36)}`} />}
  </svg>
</div>
