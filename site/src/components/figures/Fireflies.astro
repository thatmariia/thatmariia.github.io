---
// Synchronise with fireflies: a ring of coupled oscillators (the Kuramoto model) flashes together,
// and you are the one in the middle. Flash (Space or tap) with them; their tempo drifts. Three
// misses, or flashes out of time, end it, with a prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="fireflies" width={width} height={Math.round(width * (width > 600 ? 0.38 : 0.85))}
  label="Fireflies: press Space or tap to flash in time with a ring of synchronising fireflies"
  hint="Space or tap to flash with the fireflies" />

<script>
  import { banner, best, corners, gameOver, loop, setup, type Game } from "../../lib/game";

  const N = 28, WINDOW = 0.15;
  for (const figure of document.querySelectorAll<HTMLElement>(".fig.fireflies")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, [cx, cy, R] = [W / 2, H * 0.54, Math.min(W, H) * 0.34];
    let state: "idle" | "running" | "over" = "idle";
    let phase: number[] = [], omega: number[] = [], glow: number[] = [], me = 0, period = 1.1, drift = 0, time = 0;
    // A swarm flash waits WINDOW seconds for my flash, and my flash waits as long for theirs.
    let swarm: number | null = null, mine: number | null = null, lastMean = 0, hits = 0, lives = 3, streak = 0, order = 0, note = "", noteAt = -9;

    const reset = () => {
      phase = Array.from({ length: N }, () => Math.random() * 2 * Math.PI);
      omega = Array.from({ length: N }, () => 1 + (Math.random() - 0.5) * 0.12);
      glow = phase.map(() => 0);
    };
    reset();

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      // Coupling: faint lines from each firefly to the mean field in the middle.
      c.strokeStyle = ink;
      for (let i = 0; i < N; i++) {
        const a = (i / N) * Math.PI * 2, [x, y] = [cx + Math.cos(a) * R, cy + Math.sin(a) * R];
        c.globalAlpha = 0.06 + 0.2 * order; c.lineWidth = 0.6;
        c.beginPath(); c.moveTo(cx, cy); c.lineTo(x, y); c.stroke();
        c.globalAlpha = 1; c.lineWidth = 1.2;
        c.fillStyle = glow[i] > 0 ? ink : bg;
        c.beginPath(); c.arc(x, y, 4 + 4 * glow[i], 0, Math.PI * 2); c.fill(); c.stroke();
        // Each firefly's phase as a tick.
        const p = phase[i];
        c.beginPath(); c.moveTo(x, y); c.lineTo(x + Math.cos(p - Math.PI / 2) * 9, y + Math.sin(p - Math.PI / 2) * 9); c.stroke();
      }
      // Me, in the middle.
      c.fillStyle = me > 0 ? ink : bg; c.lineWidth = 2;
      c.beginPath(); c.arc(cx, cy, 11 + 8 * me, 0, Math.PI * 2); c.fill(); c.stroke();
      c.fillStyle = muted; c.font = `11px ${mono}`; c.textAlign = "center";
      c.fillText(`order r = ${order.toFixed(2)}`, cx, cy + R + 26);
      if (time - noteAt < 0.6 && note) { c.fillStyle = ink; c.font = `600 12px ${mono}`; c.fillText(note, cx, cy - 22); }
      corners(game, "fireflies", `${hits} in sync  ${"●".repeat(lives)}${"○".repeat(3 - lives)}`);
      if (state === "idle") banner(game, ["Kuramoto fireflies", "coupled oscillators fall into sync", "flash with them: space or tap", "their tempo drifts · stay locked"], H * 0.5);
      if (state === "over") banner(game, [`Phase lost after ${hits} flashes`, "space or tap to sync again"], H * 0.5);
    }

    const miss = (why: string) => {
      lives -= 1; streak = 0; [note, noteAt] = [why, time];
      if (lives <= 0) {
        state = "over";
        const record = best("fireflies", hits);
        gameOver(game.readout, game.pool, `<strong>Phase lost after ${hits} flashes in sync</strong> · order r = ${order.toFixed(2)}${hits >= record && hits > 0 ? " · new best!" : ""}`);
      }
    };
    const step = (dt: number) => {
      time += dt;
      // The tempo drifts slowly between quick and slow.
      drift += (Math.random() - 0.5) * dt * 0.8;
      drift = Math.max(-1, Math.min(1, drift * (1 - dt * 0.1)));
      period = 1.05 + 0.3 * Math.sin(time * 0.17) + 0.15 * drift - Math.min(0.25, hits * 0.006);
      // Kuramoto: dθ/dt = ω + (K/N) Σ sin(θj − θi).
      const [mx, my] = [phase.reduce((s, p) => s + Math.cos(p), 0) / N, phase.reduce((s, p) => s + Math.sin(p), 0) / N];
      order = Math.hypot(mx, my);
      const mean = Math.atan2(my, mx), K = 2.4;
      for (let i = 0; i < N; i++) {
        phase[i] += dt * ((2 * Math.PI) / period * omega[i] + K * order * Math.sin(mean - phase[i]));
        if (phase[i] >= 2 * Math.PI) { phase[i] -= 2 * Math.PI; glow[i] = 1; }
        glow[i] = Math.max(0, glow[i] - dt * 4);
      }
      me = Math.max(0, me - dt * 4);
      // The swarm flashes when its mean phase wraps around (once it is mostly in sync).
      const meanPhase = (mean + 2 * Math.PI) % (2 * Math.PI), wrapped = lastMean > 5 && meanPhase < 1.3;
      lastMean = meanPhase;
      const warm = time > 5;
      if (state === "running" && wrapped && order > 0.6) {
        if (mine !== null && time - mine <= WINDOW) { mine = null; hit(); } else swarm = time;
      }
      if (state === "running" && swarm !== null && time - swarm > WINDOW) { swarm = null; if (warm) miss("missed a flash"); }
      if (state === "running" && mine !== null && time - mine > WINDOW) { mine = null; if (warm) miss("out of time"); }
      draw();
      return state === "running";
    };
    const hit = () => { hits += 1; streak += 1; [note, noteAt] = [streak > 4 ? `locked ×${streak}` : "in sync", time]; };
    const flash = () => {
      if (state !== "running") {
        [state, hits, lives, streak, time, swarm, mine] = ["running", 0, 3, 0, 0, null, null];
        reset();
        game.readout.innerHTML = '<span class="hint">Watch them fall into sync, then flash with them</span>';
        loop(step);
        return;
      }
      me = 1;
      if (swarm !== null) { swarm = null; hit(); } else if (mine === null) mine = time;
    };
    game.element.addEventListener("keydown", (event) => { if (event.key === " " || event.key === "Enter") { event.preventDefault(); flash(); } });
    game.element.addEventListener("pointerdown", (event) => { event.preventDefault(); game.element.focus(); flash(); });
    draw();
  }
</script>
