---
// Interacting attractors: particles spiral around one attractor for a while, then escape to
// another (metastable switching, as in itinerant brain dynamics). Unlabelled.
import { points, random, type Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const uniform = random(seed);
const pad = 50, count = Math.max(5, Math.round((width * height) / 60000));
const attractors: Point[] = [];
for (let tries = 0; attractors.length < count && tries < 5000; tries++) {
  const p: Point = [pad + uniform() * (width - 2 * pad), pad + uniform() * (height - 2 * pad)];
  if (attractors.every((q) => Math.hypot(p[0] - q[0], p[1] - q[1]) > Math.min(width, height) * 0.3)) attractors.push(p);
}

// Each particle is pulled towards its current attractor with a sideways swirl and some damping.
// After dwelling near it for a while it switches to one of the nearby attractors.
const paths = Array.from({ length: 6 }, () => {
  let target = Math.floor(uniform() * attractors.length);
  let p: Point = [attractors[target][0] + (uniform() - 0.5) * 120, attractors[target][1] + (uniform() - 0.5) * 120];
  let v: Point = [0, 0], dwell = 0;
  const spin = uniform() < 0.5 ? -1 : 1;
  const path: Point[] = [];
  for (let step = 0; step < 2600; step++) {
    // A damped spring towards the attractor plus a gentle swirl: the particle spirals in.
    // (The swirl must stay below damping × √spring, otherwise the spiral grows instead.)
    const [dx, dy] = [attractors[target][0] - p[0], attractors[target][1] - p[1]];
    const r = Math.hypot(dx, dy);
    v = [
      v[0] + 0.004 * dx - spin * 0.0012 * dy - 0.03 * v[0],
      v[1] + 0.004 * dy + spin * 0.0012 * dx - 0.03 * v[1],
    ];
    p = [p[0] + v[0], p[1] + v[1]];
    if (step % 2 === 0) path.push(p);
    if (r < 45 && ++dwell > 120 + uniform() * 160) {
      const others = attractors.map((a, i) => ({ i, d: Math.hypot(a[0] - p[0], a[1] - p[1]) }))
        .filter((o) => o.i !== target).sort((a, b) => a.d - b.d).slice(0, 3);
      target = others[Math.floor(uniform() * others.length)].i;
      dwell = 0;
    }
  }
  return path;
});
---

<div class="fig itinerancy">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Trajectories switching between interacting attractors">
    <clipPath id={`it-${seed}-${width}`}><rect width={width} height={height} /></clipPath>
    <g clip-path={`url(#it-${seed}-${width})`}>
      {paths.map((path, i) => <polyline class="line" points={points(path)} style={`--i: ${i}`} pathLength="1" />)}
    </g>
    {attractors.map(([x, y]) => <circle class="attractor" cx={x.toFixed(1)} cy={y.toFixed(1)} r="3.5" />)}
  </svg>
</div>
