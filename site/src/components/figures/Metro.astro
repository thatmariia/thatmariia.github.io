---
// The path as a metro map: one line per kind of role, running along time. Lines are thick while a
// role is active and thin in between; each role is a station where it began; interchanges join
// stations of the same organisation on different lines. Trains keep running along the lines.
// Horizontal on wide screens, vertical (time downwards) on narrow ones, where station names are
// shown on hover only.
import { firstYear, month, now } from "../../lib/career";
import { data, refs, type Entry } from "../../lib/data";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

const LINES = [
  { label: "research", sections: ["research"] },
  { label: "teaching", sections: ["teaching"] },
  { label: "leadership & service", sections: ["leadership", "service"] },
  { label: "other", sections: ["other"] },
];
const vertical = height > width;
const [start, end] = [firstYear * 12, now + 1];
const [along0, along1] = vertical ? [56, height - 16] : [16, width - 16];
const [across0, across1] = vertical ? [26, width - 150] : [70, height - 30];
const time = (t: number) => along0 + ((t - start) / (end - start)) * (along1 - along0);
const lane = (i: number) => across0 + (i / (LINES.length - 1)) * (across1 - across0);
const xy = (t: number, i: number): [number, number] => (vertical ? [lane(i), time(t)] : [time(t), lane(i)]);
const f = (v: number) => v.toFixed(1);

const lines = LINES.map((line, i) => {
  const stations = line.sections.flatMap((s) => ((data as any)[s] as Entry[]).map((e) => ({
    e, from: Math.min(...e.periods.map((p) => month(p.start!))),
    to: Math.max(...e.periods.map((p) => (p.end === "present" ? now + 1 : p.end ? month(p.end) + 1 : month(p.start!) + 1))),
  }))).sort((a, b) => a.from - b.from);
  return { ...line, i, stations };
}).filter((l) => l.stations.length);
const years = Array.from({ length: Math.floor(now / 12) - firstYear + 1 }, (_, i) => firstYear + i).filter((y) => (y - firstYear) % 2 === 0);
const segment = (a: number, b: number, i: number) => { const [p, q] = [xy(a, i), xy(b, i)]; return `M${f(p[0])},${f(p[1])}L${f(q[0])},${f(q[1])}`; };

// Interchanges: the same organisation on two lines, joined between its first stations.
const interchanges = lines.flatMap((a, k) => lines.slice(k + 1).flatMap((b) =>
  a.stations.flatMap((s) => {
    const other = b.stations.find((t) => t.e.title === s.e.title);
    return other ? [{ p: xy(s.from, a.i), q: xy(other.from, b.i) }] : [];
  })));
---

<div class:list={["fig metro", { vertical }]}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Roles since ${firstYear} as a metro map: ${lines.map((l) => l.label).join(", ")}`}>
    {years.map((y) => {
      const t = time(y * 12);
      return vertical
        ? <text class="year" x={across1 + 46} y={f(t + 3)} text-anchor="end">{y}</text>
        : <text class="year" x={f(t)} y={height - 8} text-anchor="middle">{y}</text>;
    })}
    {lines.map((l) => (
      <g class="line">
        <path class="track" d={segment(l.stations[0].from, end - 1, l.i)} />
        {l.stations.map((s) => <path class="active" d={segment(s.from, s.to, l.i)} />)}
        <path class="train" d={segment(l.stations[0].from, end - 1, l.i)} pathLength="1" style={`animation-delay: ${(-l.i * 2.3).toFixed(1)}s`} />
        <text class="line-label" x={f(vertical ? lane(l.i) : along0)} y={f(vertical ? along0 - 40 + (l.i % 2) * 14 : lane(l.i) - 14)} text-anchor={vertical ? "middle" : "start"}>{vertical ? l.label.split(" ")[0] : l.label}</text>
      </g>
    ))}
    {interchanges.map(({ p, q }) => <path class="interchange" d={`M${f(p[0])},${f(p[1])} C${f(vertical ? (p[0] + q[0]) / 2 : p[0])},${f(vertical ? p[1] : (p[1] + q[1]) / 2)} ${f(vertical ? (p[0] + q[0]) / 2 : q[0])},${f(vertical ? q[1] : (p[1] + q[1]) / 2)} ${f(q[0])},${f(q[1])}`} />)}
    {lines.flatMap((l) => l.stations.map((s) => {
      const [x, y] = xy(s.from, l.i), name = s.e.title!.length > 22 ? `${s.e.title!.slice(0, 20)}…` : s.e.title!;
      return (
        <a href={s.e.id && refs[s.e.id] ? refs[s.e.id].href : "/path/"}>
          <title>{s.e.title}{s.e.periods[0].title ? ` · ${s.e.periods[0].title}` : ""}</title>
          <circle class="station" cx={f(x)} cy={f(y)} r="4.5" />
          {!vertical && <text x={f(x + 3)} y={f(y - 9)} transform={`rotate(-38 ${f(x + 3)} ${f(y - 9)})`}>{name}</text>}
        </a>
      );
    }))}
  </svg>
</div>
