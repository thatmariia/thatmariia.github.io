---
// Path as a feed-forward neural network: studies (inputs) → organisations → kinds of role →
// kinds of output (outputs). Layers are dense, but the weights come from the data: links from a
// study to the roles it led to, roles held at each organisation, and outputs and events linked to
// roles of each kind. Node shading is the activation; signals keep flowing forward.
import { dated, roleEntries } from "../../lib/career";
import { data, pathSections, refs, type Entry } from "../../lib/data";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

const narrow = width < 600;
const f = (v: number) => v.toFixed(1);
const cut = (s: string, n: number) => (s.length > n ? `${s.slice(0, n - 1).trim()}…` : s);
const count = <T,>(list: T[], key: (x: T) => string) => list.reduce((m, x) => m.set(key(x), (m.get(key(x)) ?? 0) + 1), new Map<string, number>());

// Layers and the weights between them.
const studies = (data.education as Entry[]).flatMap((e) => e.periods.map((p) => ({ name: p.title!, related: e.related ?? [] })));
const orgs = [...new Set([...roleEntries].sort((a, b) => a.from - b.from).map((r) => r.org))];
const sections = ["research", "teaching", "leadership", "service", "other"].filter((s) => roleEntries.some((r) => r.section === s));
const links = roleEntries.flatMap((r) => r.related.filter((id) => id in dated).map((id) => ({ section: r.section, kind: refs[id].kind })));
const kinds = [...count(links, (l) => l.kind).entries()].sort((a, b) => b[1] - a[1]).map(([k]) => k);
const layers = [
  studies.map((s) => s.name),
  orgs,
  sections.map((s) => pathSections.find((p) => p.id === s)!.title),
  kinds,
];
const weights: number[][][] = [
  studies.map((s) => orgs.map((o) => roleEntries.filter((r) => r.org === o && r.id && s.related.includes(r.id)).length)),
  orgs.map((o) => sections.map((s) => roleEntries.filter((r) => r.org === o && r.section === s).length)),
  sections.map((s) => kinds.map((k) => links.filter((l) => l.section === s && l.kind === k).length)),
];

// Positions: layers as columns, nodes spread evenly below a bias unit (+1).
const columns = narrow ? [150, 200, 250, 296] : [250, 430, 600, 770];
const [top, bottom] = [narrow ? 48 : 52, height - 18];
const nodes = layers.map((layer, l) => layer.map((name, i) => ({ name, x: columns[l], y: top + ((i + 0.5) / layer.length) * (bottom - top) })));
const bias = columns.slice(0, 3).map((x) => ({ x, y: top - 22 }));
// Activation: weighted input, normalised per layer (inputs are all on).
const activation = layers.map((layer, l) => {
  if (l === 0) return layer.map(() => 1);
  const raw = layer.map((_, j) => weights[l - 1].reduce((s, row) => s + row[j], 0));
  const most = Math.max(1, ...raw);
  return raw.map((v) => 0.15 + 0.85 * (v / most));
});
const edges = weights.flatMap((matrix, l) => {
  const most = Math.max(1, ...matrix.flat());
  return matrix.flatMap((row, i) => row.map((w, j) => ({ l, a: nodes[l][i], b: nodes[l + 1][j], w: w / most })));
});
const line = (a: { x: number; y: number }, b: { x: number; y: number }) => `M${f(a.x)},${f(a.y)} L${f(b.x)},${f(b.y)}`;
const outputs = count(links, (l) => l.kind);
const r = narrow ? 6 : 8;
const NAMES = narrow ? ["x", "h¹", "h²", "ŷ"] : ["x · studies", "h¹ · organisations", "h² · roles", "ŷ · linked work"];
---

<div class="fig neuralnet">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Path as a neural network: studies, organisations, kinds of role and kinds of output, weighted by the links between them">
    {edges.map((e) => <path class:list={["edge", { weighted: e.w > 0 }]} d={line(e.a, e.b)} stroke-width={e.w > 0 ? f(0.7 + e.w * 1.3) : undefined} />)}
    {bias.map((b, l) => nodes[l + 1].map((n) => <path class="bias-edge" d={line(b, n)} />))}
    {edges.filter((e) => e.w > 0).map((e, k) => (
      <path class="signal" d={line(e.a, e.b)} pathLength="1" style={`animation-delay: ${(e.l * 1.1 + (k % 5) * 0.08).toFixed(2)}s`} />
    ))}
    {bias.map((b) => (
      <g class="bias"><title>bias</title><rect x={f(b.x - 9)} y={f(b.y - 7)} width="18" height="14" rx="3" /><text x={f(b.x)} y={f(b.y + 3.5)} text-anchor="middle">+1</text></g>
    ))}
    {nodes.map((layer, l) => layer.map((n, i) => (
      <g class="unit">
        <title>{n.name}{l === 3 ? ` · ${outputs.get(n.name)}` : ""} · activation {activation[l][i].toFixed(2)}</title>
        <circle cx={f(n.x)} cy={f(n.y)} r={r} style={`--a: ${activation[l][i].toFixed(2)}; animation-delay: ${(l * 1.1).toFixed(2)}s`} />
        {(l === 1 || l === 2) && !narrow && <text class:list={["sigma", { on: activation[l][i] > 0.55 }]} x={f(n.x)} y={f(n.y + 3.5)} text-anchor="middle">σ</text>}
        {l === 0 && <text x={f(n.x - r - 6)} y={f(n.y + 3.5)} text-anchor="end">{cut(n.name, narrow ? 17 : 31)}</text>}
        {l === 3 && <text x={f(n.x + r + 6)} y={f(n.y + 3.5)}>{cut(n.name, narrow ? 10 : 22)} · {outputs.get(n.name)}</text>}
        {l === 2 && !narrow && <text class="hidden-label" x={f(n.x)} y={f(n.y - r - 6)} text-anchor="middle">{n.name}</text>}
      </g>
    )))}
    {NAMES.map((label, l) => <text class="layer" x={columns[l]} y={narrow ? 12 : 14} text-anchor="middle">{label}</text>)}
  </svg>
</div>
