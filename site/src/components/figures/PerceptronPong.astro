---
// Pong against a perceptron. The right paddle is a linear unit that predicts where the ball will
// arrive from where it was hit and how it moves, and learns from every ball (recursive least
// squares): clumsy at first, nearly perfect after about ten balls. First to five points wins the match; either way, a prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="pong" width={width} height={Math.round(width * (width > 600 ? 0.4 : 0.9))}
  label="Perceptron Pong: move your paddle with the pointer or the arrow keys; the opponent is a perceptron that learns"
  rules={["Perceptron Pong", "Your opponent is a perceptron: a linear model that learns from every ball.", "First to 5 points wins the match. Beat it while it is still learning.", "Move the pointer, drag, or use ↑ ↓."]} />

<script>
  import { begin, gameOver, loop, setup, type Game } from "../../lib/game";

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.pong")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, [top, bottom] = [30, H - 8], paddle = Math.max(46, (bottom - top) * 0.2);
    const [myX, aiX] = [16, W - 16];
    let state: "idle" | "running" | "over" = "idle";
    let me = H / 2, ai = H / 2, aim = H / 2, bx = W / 2, by = H / 2, vx = 0, vy = 0, points = 0, theirs = 0, epochs = 0, loss = 0.25, keys = 0;
    const MATCH = 5;
    // The perceptron: weights on [where the ball was hit, where it would arrive without bounces,
    // where it would arrive with bounces folded in, 1]. It starts naive and learns fast.
    const naive = () => [0.2 + Math.random() * 0.3, Math.random() * 0.3, 0, 0.2 + Math.random() * 0.2];
    const identity = () => [0, 1, 2, 3].map((i) => [0, 1, 2, 3].map((j) => (i === j ? 10 : 0)));
    let w = naive(), P = identity(), features = [0.5, 0.5, 0.5, 1], trail: number[][] = [];
    const norm = (y: number) => (y - top) / (bottom - top);

    function draw() {
      const { context: c, mono } = game, { ink, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      c.strokeStyle = ink; c.lineWidth = 1;
      c.setLineDash([4, 6]); c.globalAlpha = 0.35;
      c.beginPath(); c.moveTo(W / 2, top); c.lineTo(W / 2, bottom); c.stroke();
      c.setLineDash([]); c.globalAlpha = 1;
      c.beginPath(); c.moveTo(0, top); c.lineTo(W, top); c.moveTo(0, bottom); c.lineTo(W, bottom); c.stroke();
      // The perceptron's prediction, as a dashed tick on its side.
      if (vx > 0 && state === "running") { c.setLineDash([2, 3]); c.beginPath(); c.moveTo(aiX - 26, aim); c.lineTo(aiX - 8, aim); c.stroke(); c.setLineDash([]); }
      c.lineCap = "round"; c.lineWidth = 6;
      c.beginPath(); c.moveTo(myX, me - paddle / 2); c.lineTo(myX, me + paddle / 2); c.stroke();
      c.beginPath(); c.moveTo(aiX, ai - paddle / 2); c.lineTo(aiX, ai + paddle / 2); c.stroke();
      c.fillStyle = ink;
      trail.forEach(([x, y], i) => { c.globalAlpha = (i / trail.length) * 0.3; c.beginPath(); c.arc(x, y, 4, 0, Math.PI * 2); c.fill(); });
      c.globalAlpha = 1;
      c.beginPath(); c.arc(bx, by, 5.5, 0, Math.PI * 2); c.fill();
      c.fillStyle = muted; c.font = `11px ${mono}`; c.textAlign = "right";
      c.fillText(`perceptron · epoch ${epochs} · loss ${loss.toFixed(3)}`, W - 10, H - 14);
      c.fillStyle = ink; c.textAlign = "center"; c.font = `600 15px ${mono}`;
      c.fillText(`you ${points} : ${theirs} perceptron`, W / 2, 21);
      c.fillStyle = muted; c.font = `11px ${mono}`; c.textAlign = "left";
      c.fillText(`first to ${MATCH}`, 10, 20);
    }

    // Serve towards the player, a bit faster every time.
    const serve = (towards: number) => {
      const speed = W * (0.42 + points * 0.02 + epochs * 0.004), angle = (Math.random() - 0.5) * 1.1;
      [bx, by, vx, vy] = [W / 2, top + (bottom - top) * (0.3 + Math.random() * 0.4), towards * speed * Math.cos(angle), speed * Math.sin(angle)];
      trail = [];
    };
    // When the ball leaves my paddle: the perceptron predicts where it will arrive.
    const predict = () => {
      const t = (aiX - bx) / vx;
      // Bounces off the walls fold the straight-line arrival back into the court.
      const straight = norm(by + vy * t), f = ((straight % 2) + 2) % 2;
      features = [norm(by), straight, f <= 1 ? f : 2 - f, 1];
      aim = top + Math.max(0, Math.min(1, features.reduce((s, f, i) => s + f * w[i], 0))) * (bottom - top);
    };
    const learn = (arrived: number) => {
      const error = norm(arrived) - features.reduce((s, f, i) => s + f * w[i], 0);
      // Recursive least squares, forgetting slowly (λ = 0.97).
      const x = features, Px = P.map((row) => row.reduce((sum, v, j) => sum + v * x[j], 0));
      const gain = Px.map((v) => v / (0.97 + x.reduce((sum, xi, i) => sum + xi * Px[i], 0)));
      const xP = x.map((_, j) => x.reduce((sum, xi, i) => sum + xi * P[i][j], 0));
      w = w.map((wi, i) => wi + gain[i] * error);
      P = P.map((row, i) => row.map((v, j) => (v - gain[i] * xP[j]) / 0.97));
      epochs += 1;
      loss = loss * 0.8 + 0.2 * error * error;
    };
    const end = () => {
      state = "over";
      const won = points >= MATCH;
      gameOver(game, `<strong>${won ? `You beat the perceptron ${points}:${theirs}` : `The perceptron won ${theirs}:${points}`}</strong> after ${epochs} epochs of learning · its weights: ${w.map((v) => v.toFixed(2)).join(", ")}`);
    };
    const step = (dt: number) => {
      if (keys) me += keys * dt * H * 1.4;
      me = Math.max(top + paddle / 2, Math.min(bottom - paddle / 2, me));
      // The paddle moves to the prediction at a limited speed.
      const reach = dt * H * 1.1;
      ai += Math.max(-reach, Math.min(reach, (vx > 0 ? aim : H / 2) - ai));
      bx += vx * dt; by += vy * dt;
      trail = [...trail.slice(-10), [bx, by]];
      if (by < top + 5) { by = 2 * (top + 5) - by; vy = -vy; }
      if (by > bottom - 5) { by = 2 * (bottom - 5) - by; vy = -vy; }
      if (vx < 0 && bx <= myX + 6) {
        if (Math.abs(by - me) <= paddle / 2 + 5) {
          bx = myX + 6; vx = -vx * 1.04;
          vy += ((by - me) / (paddle / 2)) * Math.abs(vx) * 0.45;  // spin from where it hits the paddle
          predict();
        } else {
          theirs += 1;
          if (theirs >= MATCH) end(); else serve(-1);
        }
      }
      if (vx > 0 && bx >= aiX - 6) {
        learn(by);
        if (Math.abs(by - ai) <= paddle / 2 + 5) { bx = aiX - 6; vx = -vx; vy += (Math.random() - 0.5) * Math.abs(vx) * 0.3; }
        else { points += 1; if (points >= MATCH) end(); else serve(-1); }
      }
      draw();
      return state === "running";
    };
    const start = () => {
      [state, points, theirs, epochs, loss] = ["running", 0, 0, 0, 0.25];
      [w, P] = [naive(), identity()];
      begin(game, `First to ${MATCH} · score while the perceptron is still learning`);
      serve(-1);
      loop(game, step);
    };
    const follow = (event: PointerEvent) => {
      const rect = game.element.getBoundingClientRect();
      me = ((event.clientY - rect.top) / rect.height) * H;
    };
    game.element.addEventListener("pointermove", follow);
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      game.element.setPointerCapture(event.pointerId);
      if (state !== "running") return start();
      follow(event);
    });
    game.element.addEventListener("keydown", (event) => {
      if (state !== "running") { if (event.key.length === 1 || event.key === "Enter" || event.key.startsWith("Arrow")) { event.preventDefault(); start(); } return; }
      if (event.key === "ArrowUp") { event.preventDefault(); keys = -1; }
      if (event.key === "ArrowDown") { event.preventDefault(); keys = 1; }
    });
    game.element.addEventListener("keyup", (event) => { if (event.key === "ArrowUp" || event.key === "ArrowDown") keys = 0; });
    draw();
  }
</script>
