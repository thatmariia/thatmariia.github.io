---
// Phase plane of the FitzHugh–Nagumo neuron model: nullclines (dashed), trajectories from all
// sides converging onto the spiking limit cycle, and the fields spaced evenly along that cycle.
import { place, separate } from "../../lib/figure";
import { points, type Point } from "../../lib/random";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, width, height } = Astro.props;

const [a, b, eps, current] = [0.7, 0.8, 0.08, 0.5];
const flow = ([v, w]: number[]) => [v - v ** 3 / 3 - w + current, eps * (v + a - b * w)];
function rk4(s: number[], dt: number) {
  const k1 = flow(s), k2 = flow(s.map((x, i) => x + (dt / 2) * k1[i]));
  const k3 = flow(s.map((x, i) => x + (dt / 2) * k2[i])), k4 = flow(s.map((x, i) => x + dt * k3[i]));
  return s.map((x, i) => x + (dt / 6) * (k1[i] + 2 * k2[i] + 2 * k3[i] + k4[i]));
}

// Plot coordinates: v left to right, w bottom to top.
const [v0, v1, w0, w1, pad] = [-2.6, 2.6, -0.9, 2.1, 30];
const xy = ([v, w]: number[]): Point => [pad + ((v - v0) / (v1 - v0)) * (width - 2 * pad), height - pad - ((w - w0) / (w1 - w0)) * (height - 2 * pad)];
const inside = ([v, w]: number[]) => v >= v0 && v <= v1 && w >= w0 && w <= w1;

// Nullclines: dv/dt = 0 is a cubic, dw/dt = 0 is a line.
const vs = Array.from({ length: 121 }, (_, k) => v0 + ((v1 - v0) * k) / 120);
const cubic = vs.map((v) => [v, v - v ** 3 / 3 + current]).filter(inside).map(xy);
const line = vs.map((v) => [v, (v + a) / b]).filter(inside).map(xy);

// The limit cycle: run until settled, then record one full period.
let s = [0, 0];
for (let k = 0; k < 6000; k++) s = rk4(s, 0.05);
const start = s, cycle: number[][] = [s];
for (let k = 0; k < 4000; k++) {
  s = rk4(s, 0.05);
  cycle.push(s);
  if (k > 200 && Math.hypot(s[0] - start[0], s[1] - start[1]) < 0.02) break;
}

// Trajectories from points around the border, drawn until they join the cycle.
const seeds = [
  ...Array.from({ length: 7 }, (_, k) => [v0 + 0.1 + ((v1 - v0 - 0.2) * k) / 6, w1 - 0.05]),
  ...Array.from({ length: 7 }, (_, k) => [v0 + 0.1 + ((v1 - v0 - 0.2) * k) / 6, w0 + 0.05]),
  ...Array.from({ length: 4 }, (_, k) => [v0 + 0.05, w0 + 0.4 + ((w1 - w0 - 0.8) * k) / 3]),
  ...Array.from({ length: 4 }, (_, k) => [v1 - 0.05, w0 + 0.4 + ((w1 - w0 - 0.8) * k) / 3]),
  [0, 0.4], [-0.5, 0.9],
];
const trajectories = seeds.map((seed) => {
  let p = seed;
  const path = [p];
  for (let k = 0; k < 900; k++) {
    p = rk4(p, 0.05);
    if (!inside(p)) break;
    path.push(p);
  }
  return path.map(xy);
});

// Fields evenly spaced by arc length along the cycle.
const curve = cycle.map(xy);
const lengths = [0];
for (let k = 1; k < curve.length; k++) lengths.push(lengths[k - 1] + Math.hypot(curve[k][0] - curve[k - 1][0], curve[k][1] - curve[k - 1][1]));
const total = lengths[lengths.length - 1];
const at: Point[] = fields.map((_, i) => [...curve[lengths.findIndex((l) => l >= (total * (i + 0.5)) / fields.length)]] as Point);
separate(at, fields, width, height, 28);
---

<div class="fig phase">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields along the limit cycle of a neuron model: ${fields.join(", ")}`}>
    <g class="axes">
      <line x1={pad} y1={height - pad} x2={width - pad} y2={height - pad} />
      <line x1={pad} y1={height - pad} x2={pad} y2={pad} />
      <text x={width - pad} y={height - pad + 18} text-anchor="end">membrane potential v</text>
      <text x={pad + 6} y={pad + 4}>recovery w</text>
    </g>
    <polyline class="nullcline" points={points(cubic)} />
    <polyline class="nullcline" points={points(line)} />
    {trajectories.map((path, i) => <polyline class="line" points={points(path)} style={`--i: ${i % 9}`} pathLength="1" />)}
    <polyline class="cycle line" points={points(curve)} style="--i: 9" pathLength="1" />
  </svg>
  {at.map((p, i) => <span class="node" data-node={i} style={place(p, width, height)}>{fields[i]}</span>)}
</div>
