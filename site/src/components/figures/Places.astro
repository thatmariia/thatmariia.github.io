---
// The places worked in, as interacting attractors. One trajectory follows the real itinerary month
// by month: it wanders around the city of each role for as long as the role lasted, and alternates
// between cities that were active at the same time. Attractor size grows with time spent there.
import { now, roles } from "../../lib/career";
import { points, random, type Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const city = (location?: string) => (location && !/virtual|global/i.test(location) ? location.split(",")[0].trim() : null);
const stays = roles.flatMap((r) => (city(r.location) ? [{ city: city(r.location)!, from: r.span[0], to: Math.max(r.span[1], r.span[0] + 1) }] : []));
const start = Math.min(...stays.map((s) => s.from));

// Cities in order of first visit, around a jittered ellipse; size by months spent.
const uniform = random(seed);
const cities = [...new Set([...stays].sort((a, b) => a.from - b.from).map((s) => s.city))];
const monthsIn = (c: string) => {
  let total = 0;
  for (let m = start; m <= now; m++) if (stays.some((s) => s.city === c && s.from <= m && m < s.to)) total++;
  return total;
};
const [rx, ry] = [width / 2 - 70, height / 2 - 50];
const places = cities.map((name, i) => {
  const a = -Math.PI * 0.85 + (2 * Math.PI * i) / cities.length + (uniform() - 0.5) * 0.3;
  const at: Point = [width / 2 + rx * (0.75 + uniform() * 0.25) * Math.cos(a), height / 2 + ry * (0.75 + uniform() * 0.25) * Math.sin(a)];
  return { name, at, size: 2.5 + Math.sqrt(monthsIn(name)) * 0.55 };
});

// Walk month by month: a noisy damped spring towards one of the currently active cities.
let p: Point = [...places[0].at], v: Point = [0, 0], target = 0;
const path: Point[] = [];
function walk(steps: number) {
  for (let step = 0; step < steps; step++) {
    const [dx, dy] = [places[target].at[0] - p[0], places[target].at[1] - p[1]];
    // Spring plus a gentle swirl (kept below damping × √spring so it stays stable) plus noise.
    v = [v[0] + 0.004 * dx - 0.0012 * dy - 0.03 * v[0] + (uniform() - 0.5) * 1.1,
         v[1] + 0.004 * dy + 0.0012 * dx - 0.03 * v[1] + (uniform() - 0.5) * 1.1];
    p = [p[0] + v[0], p[1] + v[1]];
    path.push(p);
  }
}
for (let m = start; m <= now; m++) {
  const isActive = (i: number) => stays.some((s) => s.city === places[i].name && s.from <= m && m < s.to);
  // A place where a stay starts this month is visited first, however short the stay.
  for (const i of places.map((_, i) => i).filter((i) => stays.some((s) => s.city === places[i].name && s.from === m))) {
    target = i;
    walk(70);
  }
  const active = places.map((_, i) => i).filter(isActive);
  if (active.length) target = active[(m - start) % active.length];
  walk(8);
}
const chunks = Array.from({ length: Math.ceil(path.length / 160) }, (_, k) => path.slice(k * 160, k * 160 + 161));
---

<div class="fig places">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Places worked in, visited in order: ${cities.join(", ")}`}>
    {chunks.map((chunk, i) => <polyline class="line" points={points(chunk)} style={`--i: ${i}`} pathLength="1" />)}
    {places.map(({ name, at: [x, y], size }) => (
      <g class="place">
        <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={size.toFixed(1)} />
        <text x={x.toFixed(1)} y={(y - size - 8).toFixed(1)} text-anchor="middle">{name}</text>
      </g>
    ))}
  </svg>
</div>
