---
// Projects as constellations: items joined by cross-links form a project (a connected group), drawn
// as stars and lines and named after its earliest paper or preprint (or its best-connected item).
// Stars twinkle and light runs along the lines. Hover names a star; click opens it.
import { data, PAGE_OF, refs } from "../../lib/data";
import { forceLayout } from "../../lib/figure";
import { random, type Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const GROUP: Record<string, string> = {
  publications: "paper", preprints: "paper", events: "event", outreach: "event",
  software: "output", datasets: "output", posters: "output", presentations: "output", reports: "output", websites: "output", theses: "output",
};
// The cross-link graph and its connected groups.
const groupOf = new Map<string, string>(), yearOf = new Map<string, number>(), neighbours = new Map<string, Set<string>>();
for (const section of Object.keys(PAGE_OF)) {
  for (const item of (data as any)[section] as { id?: string; related?: string[]; year?: number; periods?: { start?: string }[] }[]) {
    if (!item.id) continue;
    groupOf.set(item.id, GROUP[section] ?? "role");
    yearOf.set(item.id, item.year ?? Number(item.periods?.[0]?.start?.slice(0, 4) ?? 9999));
    for (const other of item.related ?? []) {
      neighbours.set(item.id, (neighbours.get(item.id) ?? new Set()).add(other));
      neighbours.set(other, (neighbours.get(other) ?? new Set()).add(item.id));
    }
  }
}
const seen = new Set<string>();
const projects = [...neighbours.keys()].flatMap((start) => {
  if (seen.has(start)) return [];
  const members: string[] = [], queue = [start];
  while (queue.length) {
    const id = queue.pop()!;
    if (seen.has(id)) continue;
    seen.add(id);
    members.push(id);
    queue.push(...neighbours.get(id)!);
  }
  const papers = members.filter((m) => groupOf.get(m) === "paper").sort((a, b) => yearOf.get(a)! - yearOf.get(b)!);
  const main = papers[0] ?? [...members].sort((a, b) => neighbours.get(b)!.size - neighbours.get(a)!.size)[0];
  return [{ members, name: refs[main].title }];
}).sort((a, b) => b.members.length - a.members.length);

// Each project gets a cell of a grid, sized to the figure; constellations are laid out inside.
const uniform = random(seed);
const columns = width > height ? Math.ceil(Math.sqrt(projects.length * 1.6)) : 2;
const rows = Math.ceil(projects.length / columns);
const [cellW, cellH] = [width / columns, (height - 8) / rows];
const f = (v: number) => v.toFixed(1);
// Names are cut to fit their cell (Martian Mono is wide: about 8 units per character).
const fits = Math.floor((cellW - 10) / 8);
const short = (s: string) => (s.length > fits ? `${s.slice(0, fits - 1).trim()}…` : s);
const drawn = projects.map((project, k) => {
  const [ox, oy] = [(k % columns) * cellW, Math.floor(k / columns) * cellH];
  const index = new Map(project.members.map((m, i) => [m, i]));
  const edges = project.members.flatMap((m, i) => [...neighbours.get(m)!].filter((o) => index.get(o)! > i).map((o) => ({ pair: [i, index.get(o)!], w: 1 })));
  const layout = project.members.length === 1 ? [[cellW / 2, cellH / 2] as Point]
    : forceLayout(project.members.length, edges, cellW, cellH - 22, Math.min(cellW, cellH) * 0.18, uniform);
  const at = layout.map(([x, y]) => [ox + x, oy + y] as Point);
  return { name: short(project.name), title: project.name, labelAt: [ox + cellW / 2, oy + cellH - 8] as Point, members: project.members, at, edges };
});
---

<div class="fig projects">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${projects.length} projects, each a group of linked papers, outputs, events and roles`}>
    {drawn.map((project) => (
      <g class="constellation">
        {project.edges.map(({ pair: [i, j] }) => {
          const d = `M${f(project.at[i][0])},${f(project.at[i][1])} L${f(project.at[j][0])},${f(project.at[j][1])}`;
          return (
            <>
              <path class="link" d={d} />
              <path class="pulse" d={d} pathLength="1" style={`animation-delay: ${(uniform() * 8).toFixed(2)}s`} />
            </>
          );
        })}
        {project.members.map((id, i) => {
          const [x, y] = project.at[i], group = groupOf.get(id)!, r = 3 + Math.sqrt(neighbours.get(id)!.size) * 1.3;
          return (
            <a href={refs[id].href} class:list={["star", group]} style={`animation-duration: ${(2 + uniform() * 3).toFixed(2)}s; animation-delay: ${(-uniform() * 4).toFixed(2)}s`}>
              <title>{refs[id].kind}: {refs[id].title}</title>
              {group === "paper" || group === "event"
                ? <circle cx={f(x)} cy={f(y)} r={f(r)} />
                : <rect x={f(x - r * 0.85)} y={f(y - r * 0.85)} width={f(r * 1.7)} height={f(r * 1.7)} transform={`rotate(45 ${f(x)} ${f(y)})`} />}
            </a>
          );
        })}
        <text x={f(project.labelAt[0])} y={f(project.labelAt[1])} text-anchor="middle"><title>{project.title}</title>{project.name}</text>
      </g>
    ))}
  </svg>
</div>
