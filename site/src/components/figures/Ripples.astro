---
// How much the open outputs are used, from Zenodo statistics: each output sits at its year (across)
// and its number of views (up, log scale), and sends out ripples that come faster with more views
// and spread wider with more downloads. Hover shows the numbers.
import external from "../../data/external.json";
import { lastYear } from "../../lib/career";
import { data, type Work } from "../../lib/data";
import { random } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const usage = external.usage as Record<string, { views: number; downloads: number }>;
const sections = ["software", "datasets", "posters", "presentations", "reports", "websites", "theses"];
const outputs = sections.flatMap((s) => ((data as any)[s] as Work[]).filter((w) => w.doi && usage[w.doi]));
const uniform = random(seed);
const from = Math.min(...outputs.map((w) => w.year));
const [left, right, top, bottom] = [44, width - 24, 30, height - 34];
const maxViews = Math.max(...outputs.map((w) => usage[w.doi!].views));
const x = (year: number) => left + ((year - from) / (lastYear + 1 - from)) * (right - left);
const y = (views: number) => bottom - (Math.log10(views + 1) / Math.log10(maxViews * 1.6)) * (bottom - top);
const sources = outputs.map((w) => {
  const { views, downloads } = usage[w.doi!];
  return { title: w.title, views, downloads, x: x(w.year + 0.1 + uniform() * 0.8), y: y(views),
    period: 9 / Math.log10(views + 10), spread: 3 + Math.log10(downloads + 1) * 4 };
});
const years = Array.from({ length: lastYear - from + 1 }, (_, i) => from + i);
const f = (v: number) => v.toFixed(1);
---

<div class="fig ripples">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Views and downloads of ${sources.length} open outputs on Zenodo`}>
    {[10, 100, 1000].filter((v) => v < maxViews * 1.6).map((v) => (
      <g class="grid">
        <line x1={left} x2={right} y1={f(y(v))} y2={f(y(v))} />
        <text x={left - 6} y={f(y(v) + 3)} text-anchor="end">{v.toLocaleString("en")}</text>
      </g>
    ))}
    <text x={left - 6} y={top - 12} text-anchor="end">views</text>
    {sources.map((s) => (
      <g class="source">
        <title>{s.title} · {s.views} views · {s.downloads} downloads</title>
        {[0, 1, 2].map((k) => (
          <circle class="ripple" cx={f(s.x)} cy={f(s.y)} r="3"
            style={`--spread: ${f(s.spread)}; animation-duration: ${s.period.toFixed(2)}s; animation-delay: ${((-s.period * k) / 3).toFixed(2)}s`} />
        ))}
        <circle class="core" cx={f(s.x)} cy={f(s.y)} r="2.6" />
      </g>
    ))}
    <line class="axis" x1={left} y1={bottom + 6} x2={right} y2={bottom + 6} />
    {years.map((yr) => <text x={f(x(yr + 0.5))} y={bottom + 22} text-anchor="middle">{yr}</text>)}
  </svg>
</div>
