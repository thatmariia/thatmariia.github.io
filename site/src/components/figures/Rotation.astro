---
// Mental rotation (Shepard & Metzler, 1971): is the shape on the right the one on the left,
// rotated (same), or its mirror image? Answer with ← / → (or the buttons) before the deadline,
// which keeps shrinking; one mistake ends it. Your reaction time per degree of rotation is
// measured, as in the original, and there is a prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="rotation" width={width} height={Math.round(width * (width > 600 ? 0.4 : 0.95))}
  label="Mental rotation: decide whether the right shape is the left one rotated, or its mirror image; left arrow for same, right arrow for mirror"
  hint="← same · → mirror" />

<script>
  import { banner, best, corners, gameOver, inside, loop, pills, pointer, setup, type Button, type Game } from "../../lib/game";

  // Asymmetric polyominoes (so that a mirror image is never a rotation).
  const SHAPES = [
    [[0, 0], [1, 0], [1, 1], [1, 2], [2, 1]], [[0, 0], [0, 1], [0, 2], [1, 2], [2, 2], [2, 3]], [[0, 0], [1, 0], [2, 0], [2, 1], [3, 1]],
    [[0, 1], [1, 1], [1, 0], [2, 0], [2, 1], [2, 2]], [[0, 0], [0, 1], [1, 1], [2, 1], [2, 2], [3, 2], [1, 2]], [[0, 0], [1, 0], [1, 1], [2, 1], [2, 2], [3, 2]],
  ];
  for (const figure of document.querySelectorAll<HTMLElement>(".fig.rotation")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, cell = Math.min(W / 18, H / 9);
    let state: "idle" | "trial" | "feedback" | "over" = "idle";
    let shape = SHAPES[0], angle = 0, mirror = false, clock = 0, deadline = 4, streak = 0, note = "", buttons: Button[] = [];
    let results: { angle: number; rt: number }[] = [];

    const polyomino = (c: CanvasRenderingContext2D, cells: number[][], cx: number, cy: number, rotate: number, flip: boolean, ink: string, bg: string) => {
      const mx = Math.max(...cells.map(([x]) => x)) / 2, my = Math.max(...cells.map(([, y]) => y)) / 2;
      c.save(); c.translate(cx, cy); c.rotate((rotate * Math.PI) / 180); if (flip) c.scale(-1, 1);
      c.fillStyle = bg; c.strokeStyle = ink; c.lineWidth = 1.6;
      for (const [x, y] of cells) { c.beginPath(); c.rect((x - mx - 0.5) * cell, (y - my - 0.5) * cell, cell, cell); c.fill(); c.stroke(); }
      c.fillStyle = ink;
      for (const [x, y] of cells) { c.globalAlpha = 0.12; c.fillRect((x - mx - 0.5) * cell + 3, (y - my - 0.5) * cell + 3, cell - 6, cell - 6); }
      c.globalAlpha = 1; c.restore();
    };
    // The slope of reaction time against angle (ms per degree), from correct answers.
    const slope = () => {
      const r = results.map((p) => ({ a: Math.min(p.angle, 360 - p.angle), t: p.rt * 1000 }));
      if (r.length < 3) return 0;
      const [ma, mt] = [r.reduce((s, p) => s + p.a, 0) / r.length, r.reduce((s, p) => s + p.t, 0) / r.length];
      const den = r.reduce((s, p) => s + (p.a - ma) ** 2, 0);
      return den ? r.reduce((s, p) => s + (p.a - ma) * (p.t - mt), 0) / den : 0;
    };

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      corners(game, "rotation", `streak ${streak}`);
      if (state === "trial" || state === "feedback") {
        polyomino(c, shape, W * 0.3, H * 0.45, 0, false, ink, bg);
        polyomino(c, shape, W * 0.7, H * 0.45, angle, mirror, ink, bg);
        if (state === "trial") {
          const left = Math.max(0, 1 - clock / deadline);
          c.strokeStyle = muted; c.lineWidth = 2;
          c.beginPath(); c.moveTo(W / 2 - W * 0.3 * left, H * 0.78); c.lineTo(W / 2 + W * 0.3 * left, H * 0.78); c.stroke();
        }
        if (state === "feedback") { c.fillStyle = ink; c.font = `600 12px ${mono}`; c.textAlign = "center"; c.fillText(note, W / 2, H * 0.8); }
      }
      buttons = state === "trial" ? pills(game, ["← same", "mirror →"], H - 40) : [];
      if (state === "idle") banner(game, ["Mental rotation", "is the right shape the left one rotated (same)", "or its mirror image? ← same · → mirror", "one mistake ends it · the deadline shrinks"]);
      if (state === "over") banner(game, [`Streak of ${streak}`, `${Math.round(slope())} ms per degree of rotation`, "press a key or tap to go again"]);
    }

    const next = () => {
      shape = SHAPES[Math.floor(Math.random() * SHAPES.length)];
      [angle, mirror, clock, state] = [Math.floor(Math.random() * 8) * 45, Math.random() < 0.5, 0, "trial"];
    };
    const answer = (saysMirror: boolean) => {
      if (state !== "trial") return;
      if (saysMirror === mirror) {
        results.push({ angle, rt: clock });
        streak += 1;
        deadline = Math.max(1.3, deadline * 0.95);
        [note, state, clock] = [`${Math.round(clock * 1000)} ms`, "feedback", 0];
      } else end(mirror ? "it was the mirror image" : "it was the same shape");
    };
    const end = (why: string) => {
      state = "over";
      const record = best("rotation", streak);
      gameOver(game.readout, game.pool, `<strong>Streak of ${streak}</strong> (${why}) · ${Math.round(slope())} ms per degree${streak >= record && streak > 0 ? " · new best!" : ""}`);
    };
    const step = (dt: number) => {
      clock += dt;
      if (state === "trial" && clock > deadline) end("too slow");
      if (state === "feedback" && clock > 0.5) next();
      draw();
      return state !== "over";
    };
    const start = () => {
      [streak, deadline, results] = [0, 4, []];
      game.readout.innerHTML = '<span class="hint">← same · → mirror</span>';
      next();
      loop(step);
    };
    game.element.addEventListener("keydown", (event) => {
      if (state === "idle" || state === "over") { if (event.key.length === 1 || event.key === "Enter" || event.key.startsWith("Arrow")) { event.preventDefault(); start(); } return; }
      if (event.key === "ArrowLeft" || event.key === "s") { event.preventDefault(); answer(false); }
      if (event.key === "ArrowRight" || event.key === "m") { event.preventDefault(); answer(true); }
    });
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      if (state === "idle" || state === "over") return start();
      const at = pointer(game, event), b = buttons.findIndex((button) => inside(button, at));
      if (b >= 0) answer(b === 1);
    });
    draw();
  }
</script>
