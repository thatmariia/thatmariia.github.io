---
// Saltatory conduction as a one-button runner: you are an action potential leaping from node to
// node along a myelinated axon. It speeds up, and new hazards join as you go: pufferfish to jump
// (tetrodotoxin blocks sodium channels), cone snails above not to jump into (conotoxin),
// demyelinated lesions to leap across, and box jellyfish bobbing up and down. A block ends the run,
// with one of the website's items as the prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="saltatory" width={width} height={Math.round(width * (width > 600 ? 0.32 : 0.78))}
  label="Saltatory: an action potential runs along an axon; press Space or tap to jump over pufferfish, but not into cone snails"
  rules={["Saltatory conduction", "You are an action potential, leaping from node to node along a myelinated axon.", "Space or tap to jump. Jump the pufferfish (tetrodotoxin).", "New hazards join as you go; each is announced when it arrives."]} />

<script>
  import { begin, best, corners, gameOver, loop, setup, type Game } from "../../lib/game";

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.saltatory")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game;
    const axon = H * 0.72, runnerX = W * 0.14, internode = Math.max(90, W * 0.12), sheath = H * 0.07;
    const hop = H * 0.36, air = 0.6, gravity = (8 * hop) / air ** 2;
    const [slow, fast] = [W * 0.36, W * 0.85];

    let state: "idle" | "running" | "over" = "idle";
    let speed = slow, offset = 0, y = 0, vy = 0, nodes = 0, next = W, flash = 0;
    type Kind = "fish" | "snail" | "urchin" | "lesion" | "jelly" | "octopus";
    let hazards: { x: number; r: number; kind: Kind; y: number; w?: number; phase?: number }[] = [], leaps: { x: number; age: number }[] = [];
    // New hazards join at these nodes, announced as they arrive.
    const UNLOCK: [number, Kind, string][] = [
      [10, "snail", "cone snails above: don't jump into them"], [22, "urchin", "sea urchins: long spines, jump early"],
      [35, "lesion", "demyelinated lesions: leap across"], [50, "jelly", "box jellyfish: time your jumps"],
      [70, "octopus", "blue-ringed octopus: more TTX, and it charges"],
    ];
    let notice = "", noticeLeft = 0;
    const metres = () => Math.round(30 + ((speed - slow) / (fast - slow)) * 90);

    function draw() {
      const { context: c } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      c.lineCap = c.lineJoin = "round";
      c.strokeStyle = ink; c.lineWidth = 1.2;
      c.beginPath(); c.moveTo(0, axon); c.lineTo(W, axon); c.stroke();
      // Myelin sheaths scroll by; the gaps are nodes of Ranvier, with sodium channels that flash.
      const shift = offset % internode;
      for (let x = -shift - internode; x < W + internode; x += internode) {
        const [a, b] = [x + internode * 0.07, x + internode * 0.93];
        c.fillStyle = bg;
        c.beginPath(); c.roundRect(a, axon - sheath, b - a, 2 * sheath, sheath); c.fill(); c.stroke();
        c.strokeStyle = Math.abs(x - runnerX) < internode / 2 && flash > 0 ? ink : muted;
        for (const dx of [-3, 0, 3]) { c.beginPath(); c.moveTo(x + dx, axon - 6); c.lineTo(x + dx, axon + 6); c.stroke(); }
        c.strokeStyle = ink;
      }
      if (state === "idle") {
        c.fillStyle = muted; c.font = `10px ${game.mono}`; c.textAlign = "center";
        const node = internode * Math.ceil(runnerX / internode) + internode;
        c.fillText("myelin", node + internode / 2, axon + sheath + 14);
        c.fillText("node of Ranvier", node, axon - sheath - 8);
      }
      for (const leap of leaps) spike(c, leap.x, axon, Math.max(0, 0.35 - leap.age), 1.2);
      for (const h of hazards) {
        if (h.kind === "lesion") lesion(c, h.x, h.w!, ink, bg, muted);
        else ({ fish: puffer, snail, urchin, jelly, octopus } as Record<string, typeof puffer>)[h.kind](c, h.x, h.y, h.r, ink, bg);
      }
      if (noticeLeft > 0) { c.globalAlpha = Math.min(1, noticeLeft); c.fillStyle = ink; c.font = `600 12px ${game.mono}`; c.textAlign = "center"; c.fillText(notice, W / 2, 44); c.globalAlpha = 1; }
      spike(c, runnerX, axon - y, 1, 2.2);
      corners(game, "saltatory", `node ${nodes} · ${state === "idle" ? "—" : metres()} m/s`);
    }
    const spike = (c: CanvasRenderingContext2D, x: number, base: number, alpha: number, width: number) => {
      if (alpha <= 0) return;
      c.globalAlpha = alpha; c.lineWidth = width;
      c.beginPath();
      [[-16, 0], [-7, 0], [-4, -3], [-1, -26], [2, -4], [6, 5], [11, 2], [16, 0]].forEach(([dx, dy], i) => (i ? c.lineTo : c.moveTo).call(c, x + dx, base + dy));
      c.stroke();
      c.globalAlpha = 1; c.lineWidth = 1.2;
    };
    const puffer = (c: CanvasRenderingContext2D, x: number, cy: number, r: number, ink: string, bg: string) => {
      c.fillStyle = bg;
      for (let k = 0; k < 12; k++) {
        const a = (k / 12) * Math.PI * 2;
        c.beginPath(); c.moveTo(x + Math.cos(a) * r, cy + Math.sin(a) * r); c.lineTo(x + Math.cos(a) * r * 1.35, cy + Math.sin(a) * r * 1.35); c.stroke();
      }
      c.beginPath(); c.moveTo(x + r * 0.9, cy); c.lineTo(x + r * 1.5, cy - r * 0.45); c.lineTo(x + r * 1.5, cy + r * 0.45); c.closePath(); c.fill(); c.stroke();
      c.beginPath(); c.arc(x, cy, r, 0, Math.PI * 2); c.fill(); c.stroke();
      c.fillStyle = ink; c.beginPath(); c.arc(x - r * 0.45, cy - r * 0.2, 1.6, 0, Math.PI * 2); c.fill();
    };
    // A cone snail: a striped cone-shaped shell with its siphon in front.
    const snail = (c: CanvasRenderingContext2D, x: number, cy: number, r: number, ink: string, bg: string) => {
      c.fillStyle = bg;
      c.beginPath(); c.moveTo(x - r * 1.3, cy); c.quadraticCurveTo(x + r * 0.2, cy - r * 1.1, x + r * 1.1, cy - r * 0.5);
      c.lineTo(x + r * 1.1, cy + r * 0.5); c.quadraticCurveTo(x + r * 0.2, cy + r * 1.1, x - r * 1.3, cy); c.fill(); c.stroke();
      for (const u of [0.25, 0.5, 0.75]) { const sx = x - r * 1.3 + u * r * 2.4; c.beginPath(); c.moveTo(sx, cy - r * 0.8 * u - 1); c.lineTo(sx - 3, cy + r * 0.8 * u + 1); c.stroke(); }
      c.beginPath(); c.moveTo(x - r * 1.3, cy); c.lineTo(x - r * 1.9, cy - r * 0.3); c.stroke();
    };

    // A lesion: the myelin is gone and the axon frays; landing on it blocks conduction.
    const lesion = (c: CanvasRenderingContext2D, x: number, w: number, ink: string, bg: string, muted: string) => {
      c.fillStyle = bg; c.fillRect(x, axon - sheath - 2, w, 2 * sheath + 4);
      c.strokeStyle = muted; c.setLineDash([3, 4]);
      c.beginPath(); c.moveTo(x, axon); c.lineTo(x + w, axon); c.stroke();
      c.setLineDash([]); c.strokeStyle = ink;
      for (const e of [x, x + w]) { c.beginPath(); c.moveTo(e, axon - sheath); c.lineTo(e, axon + sheath); c.stroke(); }
    };
    // A sea urchin: a long-spined ball (drawn at its spine radius r).
    const urchin = (c: CanvasRenderingContext2D, x: number, cy: number, r: number, ink: string, bg: string) => {
      const body = r / 1.5;
      for (let k = 0; k < 18; k++) { const a = Math.PI + (k / 17) * Math.PI; c.beginPath(); c.moveTo(x + Math.cos(a) * body, cy + Math.sin(a) * body); c.lineTo(x + Math.cos(a) * r, cy + Math.sin(a) * r); c.stroke(); }
      c.fillStyle = bg; c.beginPath(); c.arc(x, cy, body, 0, Math.PI * 2); c.fill(); c.stroke();
    };
    // A blue-ringed octopus: a head with rings, and curling arms.
    const octopus = (c: CanvasRenderingContext2D, x: number, cy: number, r: number, ink: string, bg: string) => {
      for (let k = 0; k < 4; k++) { c.beginPath(); c.moveTo(x - r * 0.6 + k * r * 0.4, cy + r * 0.3); c.quadraticCurveTo(x - r + k * r * 0.5, cy + r, x - r * 0.8 + k * r * 0.55, cy + r * 1.1); c.stroke(); }
      c.fillStyle = bg; c.beginPath(); c.ellipse(x, cy - r * 0.1, r * 0.75, r * 0.6, 0, 0, Math.PI * 2); c.fill(); c.stroke();
      for (const [dx, dy] of [[-0.3, -0.2], [0.25, -0.3], [0.05, 0.15]]) { c.beginPath(); c.arc(x + dx * r, cy + dy * r, r * 0.13, 0, Math.PI * 2); c.stroke(); }
      c.fillStyle = ink; c.beginPath(); c.arc(x - r * 0.55, cy, 1.5, 0, Math.PI * 2); c.fill();
    };
    // A box jellyfish: a bell with trailing tentacles.
    const jelly = (c: CanvasRenderingContext2D, x: number, cy: number, r: number, ink: string, bg: string) => {
      c.fillStyle = bg;
      c.beginPath(); c.arc(x, cy, r, Math.PI, 0); c.lineTo(x + r, cy + r * 0.25); c.lineTo(x - r, cy + r * 0.25); c.closePath(); c.fill(); c.stroke();
      for (const dx of [-0.6, 0, 0.6]) {
        c.beginPath(); c.moveTo(x + dx * r, cy + r * 0.25);
        for (let k = 1; k <= 4; k++) c.lineTo(x + dx * r + (k % 2 ? 2 : -2), cy + r * 0.25 + k * r * 0.35);
        c.stroke();
      }
    };

    const step = (dt: number) => {
      speed = Math.min(fast, speed + W * 0.007 * dt);
      noticeLeft -= dt;
      const before = Math.floor(offset / internode);
      offset += speed * dt;
      if (Math.floor(offset / internode) > before) { nodes += 1; if (y === 0) flash = 0.12; }
      flash -= dt;
      if (y > 0 || vy > 0) {
        y += vy * dt; vy -= gravity * dt;
        if (y <= 0) { y = 0; vy = 0; leaps.push({ x: runnerX, age: 0 }); flash = 0.12; }
      }
      for (const l of leaps) { l.x -= speed * dt; l.age += dt; }
      leaps = leaps.filter((l) => l.age < 0.35);
      for (const h of hazards) {
        h.x -= speed * (h.kind === "snail" ? 1.15 : h.kind === "octopus" ? 1.45 : 1) * dt;
        if (h.kind === "jelly") { h.phase! += dt * 2.6; h.y = axon - sheath - h.r - (hop * 0.85) * (0.5 + 0.5 * Math.sin(h.phase!)); }
      }
      hazards = hazards.filter((h) => h.x + (h.w ?? 0) > -40);
      for (const [at, , text] of UNLOCK) if (nodes === at && notice !== text) [notice, noticeLeft] = [text, 2.5];
      // Hazards come at random gaps that always leave room to land and take off again.
      next -= speed * dt;
      if (next <= 0) {
        const open = ["fish", ...UNLOCK.filter(([at]) => nodes >= at).map(([, kind]) => kind)] as Kind[];
        const kind = open[Math.floor(Math.random() * open.length)], r = H * (0.045 + Math.random() * 0.035);
        let extra = 0;
        if (kind === "snail") hazards.push({ x: W + 30, r: H * 0.05, kind, y: axon - hop * (0.55 + Math.random() * 0.35) });
        else if (kind === "lesion") { extra = internode * (0.45 + Math.random() * 0.45); hazards.push({ x: W + 10, r: 0, w: extra, kind, y: axon }); }
        else if (kind === "jelly") hazards.push({ x: W + 30, r: H * 0.045, kind, y: axon - hop * 0.5, phase: Math.random() * 6 });
        else if (kind === "urchin") { const u = H * 0.055; hazards.push({ x: W + 30, r: u * 1.5, kind, y: axon - u - sheath * 0.2 }); }
        else if (kind === "octopus") { const o = H * 0.05; hazards.push({ x: W + 60, r: o, kind, y: axon - o - sheath * 0.2 }); }
        else {
          hazards.push({ x: W + 30, r, kind, y: axon - r - sheath * 0.2 });
          const more = nodes > 20 ? Math.floor(Math.random() * (nodes > 45 ? 3 : 2)) : 0;
          for (let i = 1; i <= more; i++) hazards.push({ x: W + 30 + r * 2.6 * i, r: r * 0.85, kind, y: axon - r * 0.85 - sheath * 0.2 });
        }
        next = speed * (air + 0.15 + Math.random() * Math.max(0.3, 1.1 - nodes * 0.008)) + extra;
      }
      // Collision with the spike (its base and its peak).
      const CAUSE: Record<Kind, string> = { fish: "tetrodotoxin", snail: "conotoxin", urchin: "a sea urchin", lesion: "demyelination", jelly: "box jellyfish venom", octopus: "a blue-ringed octopus (tetrodotoxin)" };
      for (const h of hazards) {
        const [top, bottom] = [axon - y - 26, axon - y];
        const hit = h.kind === "lesion"
          ? y < 1 && runnerX > h.x + 4 && runnerX < h.x + h.w! - 4
          : Math.abs(h.x - runnerX) < h.r + 9 && bottom > h.y - h.r * 1.2 && top < h.y + h.r * 1.2;
        if (hit && state === "running") {
          state = "over";
          const record = best("saltatory", nodes);
          gameOver(game, `<strong>Conduction block at node ${nodes}</strong> by ${CAUSE[h.kind]} · ${metres()} m/s${nodes >= record && nodes > 0 ? " · new best!" : ""}`);
        }
      }
      draw();
      return state === "running";
    };
    const press = () => {
      if (state !== "running") {
        [state, speed, offset, y, vy, nodes, next, hazards, leaps, noticeLeft, notice] = ["running", slow, 0, 0, 0, 0, W * 0.5, [], [], 0, ""];
        begin(game, "Jump the pufferfish · new hazards join as you go");
        loop(game, step);
      } else if (y === 0) vy = Math.sqrt(2 * gravity * hop);
    };
    game.element.addEventListener("pointerdown", (event) => { event.preventDefault(); game.element.focus(); press(); });
    game.element.addEventListener("keydown", (event) => { if (event.key === " " || event.key === "ArrowUp" || event.key === "Enter") { event.preventDefault(); press(); } });
    draw();
  }
</script>
