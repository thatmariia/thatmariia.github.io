---
// A sieve of Eratosthenes as an arcade game: numbers fall; zap the primes (click them, or type them
// and press Enter) before they land. Zapping a composite shows its factors and costs a life, and so
// does a prime that lands. Losing the last life gives one of the website's items as the prize.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="sieve" width={width} height={Math.round(width * (width > 600 ? 0.36 : 0.8))}
  label="Sieve: falling numbers; click a prime, or type it and press Enter, before it lands"
  hint="Zap the primes · click or type them" />

<script>
  import { banner, best, corners, escape, gameOver, loop, setup, type Game } from "../../lib/game";

  const factors = (n: number) => {
    const out: number[] = [];
    for (let p = 2; p * p <= n; p++) while (n % p === 0) { out.push(p); n /= p; }
    if (n > 1) out.push(n);
    return out;
  };
  const prime = (n: number) => n > 1 && factors(n).length === 1;
  const MERSENNE = new Set([3, 7, 31, 127, 8191]), FERMAT = new Set([3, 5, 17, 257]);

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.sieve")) {
    const game: Game = setup(figure, () => draw());
    const { W, H, element, readout } = game;
    const floor = H - 30;

    type Drop = { n: number; x: number; y: number; w: number; dead?: number; note?: string };
    let state: "idle" | "running" | "over" = "idle";
    let drops: Drop[] = [], sparks: { x: number; y: number; vx: number; vy: number; age: number }[] = [];
    let lives = 3, score = 0, spawn = 0, typed = "", lastPrime = 0, clock = 0;

    function draw() {
      const { context: c, mono } = game, { ink, bg, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      c.strokeStyle = ink; c.lineWidth = 1.2;
      c.beginPath(); c.moveTo(0, floor); c.lineTo(W, floor); c.stroke();
      c.textAlign = "center"; c.textBaseline = "middle";
      for (const d of drops) {
        c.globalAlpha = d.dead === undefined ? 1 : Math.max(0, 1 - d.dead / 0.9);
        c.font = `600 13px ${mono}`;
        c.fillStyle = bg; c.strokeStyle = ink;
        c.beginPath(); c.roundRect(d.x - d.w / 2, d.y - 12, d.w, 24, 12); c.fill(); c.stroke();
        c.fillStyle = ink; c.fillText(String(d.n), d.x, d.y + 1);
        if (d.note) { c.fillStyle = muted; c.font = `11px ${mono}`; c.fillText(d.note, d.x, d.y - 22); }
      }
      c.globalAlpha = 1;
      c.fillStyle = ink;
      for (const s of sparks) { c.globalAlpha = Math.max(0, 1 - s.age / 0.5); c.fillRect(s.x - 1.5, s.y - 1.5, 3, 3); }
      c.globalAlpha = 1;
      c.textBaseline = "alphabetic";
      corners(game, "sieve", `${score} primes · lives ${"●".repeat(lives)}${"○".repeat(3 - lives)}`);
      c.font = `600 12px ${mono}`; c.textAlign = "left"; c.fillStyle = typed ? ink : muted;
      c.fillText(`> ${typed}${state === "running" ? "_" : ""}`, 10, H - 9);
      if (state === "idle") banner(game, ["Sieve of Eratosthenes", "zap the primes before they land", "3 lives: composites zapped and primes landed cost one"], H * 0.4);
      if (state === "over") banner(game, [`Sieve broken at ${score} primes`, "click or press a key to sieve again"], H * 0.4);
    }

    const end = (message: string) => {
      lives -= 1;
      if (lives > 0) { readout.innerHTML = message; return; }
      state = "over";
      const record = best("sieve", score);
      gameOver(readout, game.pool, `${message} · <strong>${score} primes</strong>${score >= record && score > 0 ? " · new best!" : ""}`);
    };
    const zap = (d: Drop) => {
      if (prime(d.n)) {
        d.dead = 0;
        score += 1;
        for (let k = 0; k < 14; k++) { const a = Math.random() * Math.PI * 2, v = 60 + Math.random() * 120; sparks.push({ x: d.x, y: d.y, vx: Math.cos(a) * v, vy: Math.sin(a) * v, age: 0 }); }
        const twin = Math.abs(d.n - lastPrime) === 2 ? ` · twin primes (${Math.min(d.n, lastPrime)}, ${Math.max(d.n, lastPrime)})` : "";
        const special = MERSENNE.has(d.n) ? ` · ${d.n} = 2^${Math.log2(d.n + 1)} − 1, a Mersenne prime` : FERMAT.has(d.n) ? ` · ${d.n} is a Fermat prime` : "";
        lastPrime = d.n;
        readout.innerHTML = `<strong>${d.n}</strong> is prime${twin}${special}`;
      } else {
        d.dead = 0;
        d.note = `${d.n} = ${factors(d.n).join(" × ")}`;
        end(`Not prime: <strong>${escape(d.note)}</strong>`);
      }
    };
    const step = (dt: number) => {
      clock += dt;
      const level = 1 + score / 6 + clock / 20, fall = H * (0.12 + 0.03 * level);
      spawn -= dt;
      if (spawn <= 0) {
        // Under half the numbers are prime; half the composites are tricky (two primes from 7 up).
        // The range grows with score and time.
        const top = Math.round(40 + score * 12 + clock * 2);
        let n = 2 + Math.floor(Math.random() * top);
        if (Math.random() < 0.45) while (!prime(n)) n += 1;
        else if (Math.random() < 0.5) {
          const small = [7, 11, 13, 17, 19, 23, 29, 31].filter((p) => p * 7 <= Math.max(49, top));
          n = small[Math.floor(Math.random() * small.length)] * small[Math.floor(Math.random() * small.length)];
        } else while (prime(n) || n < 4) n += 1;
        const w = 22 + String(n).length * 9;
        drops.push({ n, x: w / 2 + 8 + Math.random() * (W - w - 16), y: 40, w });
        spawn = Math.max(0.38, 1.25 - level * 0.13);
      }
      for (const d of drops) {
        if (d.dead !== undefined) { d.dead += dt; continue; }
        d.y += fall * dt;
        if (d.y >= floor - 12) {
          d.dead = 0;
          d.y = floor - 12;
          if (prime(d.n)) end(`Missed a prime: <strong>${d.n}</strong>`);
        }
      }
      drops = drops.filter((d) => d.dead === undefined || d.dead < 0.9);
      for (const s of sparks) { s.x += s.vx * dt; s.y += s.vy * dt; s.age += dt; }
      sparks = sparks.filter((s) => s.age < 0.5);
      draw();
      return state === "running";
    };
    const start = () => {
      [state, drops, sparks, lives, score, spawn, typed, lastPrime, clock] = ["running", [], [], 3, 0, 0.3, "", 0, 0];
      readout.innerHTML = '<span class="hint">Zap the primes · composites cost a life, and so do landed primes</span>';
      loop(step);
    };
    element.addEventListener("pointerdown", (event) => {
      element.focus();
      if (state !== "running") return start();
      const rect = element.getBoundingClientRect(), [x, y] = [((event.clientX - rect.left) / rect.width) * W, ((event.clientY - rect.top) / rect.height) * H];
      const hit = drops.find((d) => d.dead === undefined && Math.abs(x - d.x) < d.w / 2 + 6 && Math.abs(y - d.y) < 18);
      if (hit) zap(hit);
    });
    element.addEventListener("keydown", (event) => {
      if (state !== "running") { if (event.key.length === 1 || event.key === "Enter") { event.preventDefault(); start(); } return; }
      if (/^\d$/.test(event.key)) typed = (typed + event.key).slice(-5);
      else if (event.key === "Backspace") typed = typed.slice(0, -1);
      else if (event.key === "Enter" && typed) {
        const hit = drops.filter((d) => d.dead === undefined && d.n === Number(typed)).sort((a, b) => b.y - a.y)[0];
        if (hit) zap(hit);
        typed = "";
      } else return;
      event.preventDefault();
    });
    draw();
  }
</script>
