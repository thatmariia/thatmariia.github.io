---
// Fruit Ninja as spike sorting: spike waveforms fly up from the recording. Slice (swipe or click)
// only the spikes of the unit you are sorting, shown at the top; slicing another unit or 50 Hz
// noise, or letting one of yours fall, costs a life (of 3). The unit to sort changes as you go.
import Arcade from "../Arcade.astro";
interface Props { seed: number; width: number; height: number }
const { width } = Astro.props;
---

<Arcade name="sorting" width={width} height={Math.round(width * (width > 600 ? 0.45 : 1.05))}
  label="Spike sorting: swipe or click through the spike waveforms that match the unit shown at the top, and leave the others"
  rules={["Spike sorting", "Waveforms fly up from the recording. Swipe (or click) through the spikes of your unit, shown top left.", "Leave other units and 50 Hz noise alone, and don't let your unit's spikes fall.", "The unit to sort changes every 5 spikes. You have 3 lives."]} />

<script>
  import { begin, best, corners, gameOver, loop, pointer, setup, type Game } from "../../lib/game";

  // Waveform templates (voltage over time, both in −1..1): a narrow fast-spiking unit, a broad
  // pyramidal unit, a positive (axonal) unit, and 50 Hz line noise.
  const SHAPES: Record<string, (t: number) => number> = {
    "unit 1": (t) => -Math.exp(-((t + 0.2) ** 2) / 0.012) + 0.45 * Math.exp(-((t - 0.05) ** 2) / 0.03),
    "unit 2": (t) => -0.8 * Math.exp(-((t + 0.1) ** 2) / 0.04) + 0.5 * Math.exp(-((t - 0.45) ** 2) / 0.08),
    "unit 3": (t) => 0.9 * Math.exp(-((t + 0.15) ** 2) / 0.015) - 0.35 * Math.exp(-((t - 0.25) ** 2) / 0.05),
    noise: (t) => 0.5 * Math.sin(t * 9.4),
  };
  const UNITS = ["unit 1", "unit 2", "unit 3"];

  for (const figure of document.querySelectorAll<HTMLElement>(".fig.sorting")) {
    const game: Game = setup(figure, () => draw());
    const { W, H } = game, size = Math.min(W, H) * 0.11;
    type Wave = { kind: string; x: number; y: number; vx: number; vy: number; spin: number; angle: number; cut?: number; jitter: number };
    let state: "idle" | "running" | "over" = "idle";
    let waves: Wave[] = [], blade: { x: number; y: number; age: number }[] = [], sorting = UNITS[0], score = 0, lives = 3, spawn = 0, time = 0, slicing = false, note = "", noteLeft = 0;

    const trace = (c: CanvasRenderingContext2D, kind: string, jitter: number, from = -1, to = 1) => {
      c.beginPath();
      for (let k = 0; k <= 24; k++) {
        const t = from + ((to - from) * k) / 24;
        const v = SHAPES[kind](t) + jitter * Math.sin(t * 23);
        (k ? c.lineTo : c.moveTo).call(c, t * size, -v * size * 0.8);
      }
      c.stroke();
    };

    function draw() {
      const { context: c, mono } = game, { ink, muted } = game.colours();
      c.clearRect(0, 0, W, H);
      // The unit being sorted, top left.
      c.save(); c.translate(16 + size, 46 + size * 0.4); c.strokeStyle = ink; c.lineWidth = 2; trace(c, sorting, 0); c.restore();
      c.fillStyle = muted; c.font = `10px ${mono}`; c.textAlign = "left"; c.fillText(`sort ${sorting}`, 16, 40);
      for (const w of waves) {
        c.save(); c.translate(w.x, w.y); c.rotate(w.angle);
        c.strokeStyle = ink; c.lineWidth = 2; c.lineCap = "round";
        if (w.cut === undefined) trace(c, w.kind, w.jitter);
        else {
          // Sliced: the two halves drift apart.
          c.save(); c.translate(-w.cut * 30, -w.cut * 10); trace(c, w.kind, w.jitter, -1, 0); c.restore();
          c.save(); c.translate(w.cut * 30, w.cut * 10); trace(c, w.kind, w.jitter, 0, 1); c.restore();
        }
        c.restore();
      }
      c.strokeStyle = ink; c.lineCap = "round";
      for (let k = 1; k < blade.length; k++) { c.globalAlpha = 1 - blade[k].age / 0.25; c.lineWidth = 3; c.beginPath(); c.moveTo(blade[k - 1].x, blade[k - 1].y); c.lineTo(blade[k].x, blade[k].y); c.stroke(); }
      c.globalAlpha = 1;
      if (noteLeft > 0) { c.fillStyle = ink; c.font = `600 12px ${mono}`; c.textAlign = "center"; c.fillText(note, W / 2, 44); }
      corners(game, "sorting", `${score} sorted · lives ${"●".repeat(lives)}${"○".repeat(3 - lives)}`);
    }

    const lose = (why: string) => {
      lives -= 1;
      [note, noteLeft] = [why, 1.2];
      if (lives <= 0) {
        state = "over";
        const record = best("sorting", score);
        gameOver(game, `${why} · ${score} spikes sorted${score >= record && score > 0 ? " · new best!" : ""}`);
      }
    };
    const slice = (x: number, y: number) => {
      for (const w of waves) {
        if (w.cut !== undefined || Math.hypot(w.x - x, w.y - y) > size * 1.1) continue;
        w.cut = 0;
        if (w.kind === sorting) {
          score += 1;
          if (score % 5 === 0) { sorting = UNITS[(UNITS.indexOf(sorting) + 1 + Math.floor(Math.random() * 2)) % 3]; [note, noteLeft] = [`now sort ${sorting}`, 1.6]; }
        } else lose(w.kind === "noise" ? "That was 50 Hz noise" : `That was ${w.kind}`);
      }
    };
    const step = (dt: number) => {
      time += dt; noteLeft -= dt; spawn -= dt;
      if (spawn <= 0) {
        // A volley: about half of them your unit.
        const n = 1 + Math.floor(Math.random() * Math.min(4, 1 + time / 20));
        for (let k = 0; k < n; k++) {
          const kind = Math.random() < 0.5 ? sorting : Math.random() < 0.2 ? "noise" : UNITS.filter((u) => u !== sorting)[Math.floor(Math.random() * 2)];
          waves.push({ kind, x: W * (0.2 + Math.random() * 0.6), y: H + size, vx: (Math.random() - 0.5) * W * 0.3, vy: -H * (0.8 + Math.random() * 0.15), spin: (Math.random() - 0.5) * 0.5, angle: (Math.random() - 0.5) * 0.25, jitter: Math.random() * 0.08 });
        }
        spawn = Math.max(1.3, 2.6 - time / 50);
      }
      for (const w of waves) {
        w.x += w.vx * dt; w.y += w.vy * dt; w.vy += H * 0.55 * dt; w.angle += w.spin * dt;
        if (w.cut !== undefined) w.cut += dt;
      }
      // Spikes of your unit that fall back uncut are missed.
      for (const w of waves) if (w.y > H + size * 2 && w.vy > 0 && w.cut === undefined && w.kind === sorting && state === "running") { w.cut = 99; lose(`Missed a spike of ${sorting}`); }
      waves = waves.filter((w) => w.y < H + size * 2 && (w.cut === undefined || w.cut < 0.6));
      for (const b of blade) b.age += dt;
      blade = blade.filter((b) => b.age < 0.25);
      draw();
      return state === "running";
    };
    const start = () => {
      [state, waves, blade, sorting, score, lives, spawn, time, noteLeft] = ["running", [], [], UNITS[Math.floor(Math.random() * 3)], 0, 3, 0.5, 0, 0];
      begin(game, "Swipe through your unit's spikes only");
      loop(game, step);
    };
    game.element.addEventListener("pointerdown", (event) => {
      event.preventDefault();
      game.element.focus();
      game.element.setPointerCapture(event.pointerId);
      if (state !== "running") return start();
      slicing = true;
      const [x, y] = pointer(game, event);
      blade.push({ x, y, age: 0 });
      slice(x, y);
    });
    game.element.addEventListener("pointermove", (event) => {
      if (!slicing || state !== "running") return;
      const [x, y] = pointer(game, event), last = blade[blade.length - 1];
      // Check along the swipe, not just at the samples.
      const steps = last ? Math.ceil(Math.hypot(x - last.x, y - last.y) / (size * 0.5)) : 1;
      for (let k = 1; k <= steps; k++) slice(last ? last.x + ((x - last.x) * k) / steps : x, last ? last.y + ((y - last.y) * k) / steps : y);
      blade.push({ x, y, age: 0 });
    });
    for (const type of ["pointerup", "pointercancel"]) game.element.addEventListener(type, () => (slicing = false));
    game.element.addEventListener("keydown", (event) => { if (state !== "running" && (event.key.length === 1 || event.key === "Enter")) { event.preventDefault(); start(); } });
    draw();
  }
</script>
