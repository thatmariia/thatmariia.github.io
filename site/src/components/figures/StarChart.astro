---
// Awards as a star chart: each award is a bright star in its own constellation together with the
// events and works it is linked to (dimmer stars). A faint celestial grid sits behind; the stars
// twinkle. Hover names a star; click opens it.
import { data, refs, type Entry } from "../../lib/data";
import { random, type Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const uniform = random(seed);
const awards = (data.awards as Entry[]).filter((a) => a.id).sort((a, b) => a.periods[0].start!.localeCompare(b.periods[0].start!));
const columns = width > height ? Math.min(awards.length, 3) : 2;
const rows = Math.ceil(awards.length / columns);
const [cellW, cellH] = [width / columns, height / rows];
const f = (v: number) => v.toFixed(1);
const constellations = awards.map((a, k) => {
  const [cx, cy] = [cellW * ((k % columns) + 0.5), cellH * (Math.floor(k / columns) + 0.42)];
  const linked = (a.related ?? []).filter((id) => refs[id]);
  const spread = Math.min(cellW, cellH) * 0.32;
  const stars = linked.map((id, i) => {
    const angle = (2 * Math.PI * i) / Math.max(1, linked.length) + uniform() * 0.8 - Math.PI / 2;
    return { id, at: [cx + Math.cos(angle) * spread * (0.6 + uniform() * 0.4), cy + Math.sin(angle) * spread * (0.6 + uniform() * 0.4)] as Point };
  });
  return { a, centre: [cx, cy] as Point, stars };
});
// A bright star: four long rays and four short ones.
const rays = ([x, y]: Point, r: number) => [0, 1, 2, 3, 4, 5, 6, 7].map((k) => {
  const angle = (k * Math.PI) / 4, length = k % 2 ? r * 0.55 : r * 1.4;
  return `M${f(x)},${f(y)} L${f(x + Math.cos(angle) * length)},${f(y + Math.sin(angle) * length)}`;
}).join(" ");
const background = Array.from({ length: Math.round((width * height) / 3000) }, () => [uniform() * width, uniform() * height, uniform()]);
const short = (s: string) => (s.length > 28 ? `${s.slice(0, 26).trim()}…` : s);
---

<div class="fig starchart">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`${awards.length} awards as constellations with the work they were for`}>
    {[0.25, 0.5, 0.75].map((p) => <line class="grid" x1="0" x2={width} y1={f(height * p)} y2={f(height * p)} />)}
    {[0.2, 0.4, 0.6, 0.8].map((p) => <path class="grid" d={`M${f(width * p)},0 Q${f(width * p + (p - 0.5) * 60)},${f(height / 2)} ${f(width * p)},${height}`} />)}
    {background.map(([x, y, s]) => <circle class="dust" cx={f(x)} cy={f(y)} r={f(0.4 + s * 0.8)} />)}
    {constellations.map((c, k) => (
      <g>
        {c.stars.map((s) => <line class="figure-line" x1={f(c.centre[0])} y1={f(c.centre[1])} x2={f(s.at[0])} y2={f(s.at[1])} />)}
        {c.stars.map((s, i) => (
          <a href={refs[s.id].href} class="dim" style={`animation-delay: ${(-uniform() * 3).toFixed(2)}s`}>
            <title>{refs[s.id].kind}: {refs[s.id].title}</title>
            <circle cx={f(s.at[0])} cy={f(s.at[1])} r="3" />
          </a>
        ))}
        <a href={refs[c.a.id!].href} class="bright" style={`animation-delay: ${(-k * 0.7).toFixed(2)}s`}>
          <title>{c.a.title}</title>
          <path d={rays(c.centre, 9)} />
          <circle cx={f(c.centre[0])} cy={f(c.centre[1])} r="4" />
        </a>
        <text x={f(c.centre[0])} y={f(c.centre[1] + Math.min(cellW, cellH) * 0.42 + 8)} text-anchor="middle">{short(c.a.title!)}</text>
      </g>
    ))}
  </svg>
</div>
