---
// A memory game with real cross-links: cards are outputs, events and roles; flip two that are
// linked in the portfolio (say, a poster and its preprint) to form a synapse between them.
import { data, PAGE_OF, refs } from "../../lib/data";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

// Every linked pair, once, with both items' kind, title and link.
const pairs: { a: string; b: string }[] = [];
for (const section of Object.keys(PAGE_OF)) {
  for (const item of (data as any)[section] as { id?: string; related?: string[] }[]) {
    for (const other of item.related ?? []) {
      if (item.id && refs[other] && item.id < other) pairs.push({ a: item.id, b: other });
    }
  }
}
const cards = Object.fromEntries([...new Set(pairs.flatMap((p) => [p.a, p.b]))].map((id) => [id, { kind: refs[id].kind, title: refs[id].title, href: refs[id].href }]));
const pairCount = width > height ? 6 : 4;
---

<div class="fig synapses" data-pairs={pairCount}>
  <div class="board" style={`aspect-ratio: ${width} / ${height}`}></div>
  <div class="readout" aria-live="polite"><span class="hint">Flip two cards that are linked to form a synapse</span></div>
  <script is:inline type="application/json" set:html={JSON.stringify({ pairs, cards })} />
</div>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>(".fig.synapses")) {
    const board = figure.querySelector<HTMLElement>(".board")!;
    const readout = figure.querySelector<HTMLElement>(".readout")!;
    const { pairs, cards } = JSON.parse(figure.querySelector("script[type='application/json']")!.textContent!);
    const escape = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
    const shuffle = <T,>(list: T[]) => list.map((x) => [Math.random(), x] as const).sort((a, b) => a[0] - b[0]).map(([, x]) => x);
    const linked = (a: string, b: string) => pairs.some((p: { a: string; b: string }) => (p.a === a && p.b === b) || (p.a === b && p.b === a));
    const deal = () => {
      // Pick pairs that share no card, so every card has exactly one partner on the board.
      const chosen: { a: string; b: string }[] = [], used = new Set<string>();
      for (const p of shuffle(pairs)) {
        if (chosen.length === Number(figure.dataset.pairs)) break;
        if (!used.has(p.a) && !used.has(p.b)) { chosen.push(p); used.add(p.a); used.add(p.b); }
      }
      let open: HTMLButtonElement[] = [], found = 0;
      board.innerHTML = "";
      for (const id of shuffle(chosen.flatMap((p) => [p.a, p.b]))) {
        const card = cards[id], button = document.createElement("button");
        button.className = "card";
        button.dataset.id = id;
        button.innerHTML = `<span class="back" aria-hidden="true"></span><span class="front"><span class="xref-kind">${escape(card.kind)}</span>${escape(card.title)}</span>`;
        button.setAttribute("aria-label", "Hidden card");
        button.addEventListener("click", () => {
          if (button.classList.contains("up") || open.length === 2) return;
          button.classList.add("up");
          button.setAttribute("aria-label", `${card.kind}: ${card.title}`);
          open.push(button);
          if (open.length < 2) return;
          const [a, b] = open;
          if (linked(a.dataset.id!, b.dataset.id!)) {
            a.classList.add("matched"); b.classList.add("matched");
            found += 1;
            const [x, y] = [cards[a.dataset.id!], cards[b.dataset.id!]];
            readout.innerHTML = found === chosen.length
              ? `<strong>All synapses formed!</strong> <button class="pill again">Play again</button>`
              : `Synapse: <a href="${x.href}">${escape(x.title)}</a> ↔ <a href="${y.href}">${escape(y.title)}</a>`;
            readout.querySelector(".again")?.addEventListener("click", deal);
            open = [];
          } else {
            readout.textContent = "Not linked — try again";
            setTimeout(() => { for (const c of open) { c.classList.remove("up"); c.setAttribute("aria-label", "Hidden card"); } open = []; }, 1100);
          }
        });
        board.append(button);
      }
    };
    deal();
  }
</script>
