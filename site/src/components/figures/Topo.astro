---
// Path as a topographic map. Time runs along the map; across it lie regions, one per kind of role
// (and an unnamed one for studies, which shape the land without labels).
// Every role is a hill in its region (each organisation on its own line there), centred on when it
// happened, as wide as it lasted and as high as it lasted and produced (linked outputs and events).
// Contour lines trace the landscape (every fourth one bolder), summits carry the organisations, and
// my trail goes from place to place along the land, circling each hill, with a hiker walking it.
import { dated, firstYear, month, now, roleEntries, shortName } from "../../lib/career";
import { data, pathSections, refs, type Entry } from "../../lib/data";
import { smooth } from "../../lib/figure";
import type { Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

const vertical = height > width;
const [start, end] = [firstYear * 12, now + 3];
const f = (v: number) => v.toFixed(1);
// (time in months, lane in 0..1) → screen; time runs left to right, or down on narrow screens.
const [x0, x1, y0, y1] = vertical ? [44, width - 14, 30, height - 14] : [16, width - 16, 18, height - 34];
const at = (u: number, v: number): Point => vertical
  ? [x0 + v * (x1 - x0), y0 + ((u - start) / (end - start)) * (y1 - y0)]
  : [x0 + ((u - start) / (end - start)) * (x1 - x0), y0 + v * (y1 - y0)];

// Regions: one band per kind of role; within a band, each organisation has its own line.
// Studies shape the land too, in a last, unnamed band.
const regions = pathSections.filter((p) => roleEntries.some((r) => r.section === p.id));
const band = 1 / (regions.length + 1);
const studies = (data.education as Entry[]).flatMap((e) => e.periods.filter((p) => p.start && month(p.start) <= now)
  .map((p, i) => ({ from: month(p.start!), to: Math.min(now, month(p.end ?? p.start!) + 6), v: band * (regions.length + 0.5) + band * 0.3 * ((i * 0.618034) % 1 - 0.5) })));
const lane = (section: string, org: string) => {
  const r = regions.findIndex((p) => p.id === section), orgs = [...new Set(roleEntries.filter((e) => e.section === section).sort((a, b) => a.from - b.from).map((e) => e.org))];
  return band * (r + 0.5) + (orgs.length > 1 ? band * 0.56 * (((orgs.indexOf(org) * 0.618034) % 1) - 0.5) : 0);
};
const hills = roleEntries.map((r) => {
  const months = r.to - r.from, linked = r.related.filter((id) => id in dated).length;
  return { ...r, months, linked, u: (r.from + r.to) / 2, v: lane(r.section, r.org), su: Math.max(5, months / 2.4), sv: band * 0.22, h: Math.sqrt(months + 1) * (1 + 0.12 * linked) };
});
const land = [...hills, ...studies.map((s) => ({ ...s, u: (s.from + s.to) / 2, su: Math.max(5, (s.to - s.from) / 2.4), sv: band * 0.22, h: Math.sqrt(s.to - s.from + 1) }))];
const z = (u: number, v: number) => land.reduce((s, h) => s + h.h * Math.exp(-(((u - h.u) / h.su) ** 2 + ((v - h.v) / h.sv) ** 2) / 2), 0);

// Sample the landscape on a grid and trace contour lines with marching squares.
const [nu, nv] = vertical ? [110, 56] : [180, 64];
const U = (i: number) => start + (i / nu) * (end - start), V = (j: number) => j / nv;
const grid = Array.from({ length: nu + 1 }, (_, i) => Array.from({ length: nv + 1 }, (_, j) => z(U(i), V(j))));
const top = Math.max(...grid.flat());
const CASES: Record<number, string[][]> = {
  1: [["l", "b"]], 2: [["b", "r"]], 3: [["l", "r"]], 4: [["t", "r"]], 5: [["l", "t"], ["b", "r"]], 6: [["t", "b"]], 7: [["l", "t"]],
  8: [["l", "t"]], 9: [["t", "b"]], 10: [["t", "r"], ["l", "b"]], 11: [["t", "r"]], 12: [["l", "r"]], 13: [["b", "r"]], 14: [["l", "b"]],
};
const contour = (level: number) => {
  const points = new Map<string, Point>(), segments: [string, string][] = [];
  const edge = (i: number, j: number, di: number, dj: number) => {
    const key = `${i},${j},${di}`;
    if (!points.has(key)) {
      const [za, zb] = [grid[i][j], grid[i + di][j + dj]], t = (level - za) / (zb - za);
      points.set(key, at(U(i + di * t), V(j + dj * t)));
    }
    return key;
  };
  for (let i = 0; i < nu; i++) for (let j = 0; j < nv; j++) {
    const c = (grid[i][j] > level ? 8 : 0) | (grid[i + 1][j] > level ? 4 : 0) | (grid[i + 1][j + 1] > level ? 2 : 0) | (grid[i][j + 1] > level ? 1 : 0);
    const sides: Record<string, () => string> = { t: () => edge(i, j, 1, 0), b: () => edge(i, j + 1, 1, 0), l: () => edge(i, j, 0, 1), r: () => edge(i + 1, j, 0, 1) };
    for (const [a, b] of CASES[c] ?? []) segments.push([sides[a](), sides[b]()]);
  }
  // Join the segments into lines.
  const ends = new Map<string, number[]>();
  segments.forEach(([a, b], s) => { for (const key of [a, b]) ends.set(key, [...(ends.get(key) ?? []), s]); });
  const used = new Set<number>(), lines: { points: Point[]; closed: boolean }[] = [];
  segments.forEach((segment, s0) => {
    if (used.has(s0)) return;
    used.add(s0);
    const chain = [...segment];
    for (const forward of [true, false]) for (;;) {
      const key = forward ? chain[chain.length - 1] : chain[0];
      const next = (ends.get(key) ?? []).find((s) => !used.has(s));
      if (next === undefined) break;
      used.add(next);
      const other = segments[next][0] === key ? segments[next][1] : segments[next][0];
      if (forward) chain.push(other); else chain.unshift(other);
    }
    const closed = chain.length > 3 && chain[0] === chain[chain.length - 1];
    if (chain.length > 4) lines.push({ points: (closed ? chain.slice(0, -1) : chain).map((k) => points.get(k)!), closed });
  });
  return lines;
};
const levels = Array.from({ length: 11 }, (_, l) => ({ index: (l + 1) % 4 === 0, lines: contour(top * ((l + 1) / 12) ** 1.8) }));

// Summits: the highest hill of each organisation, labelled where there is room.
const summits = [...new Set(hills.map((h) => `${h.section} ${h.org}`))]
  .map((key) => hills.filter((h) => `${h.section} ${h.org}` === key).sort((a, b) => b.h - a.h)[0]).sort((a, b) => b.h - a.h);
const years = Array.from({ length: Math.floor(now / 12) - firstYear + 1 }, (_, i) => firstYear + i).filter((y) => (y - firstYear) % (vertical ? 2 : 1) === 0);
// Summit names avoid the year labels and each other.
const placed: number[][] = years.map((yr) => {
  const [x, y] = at(yr * 12, vertical ? 0 : 1);
  return vertical ? [x - 40, y - 8, x - 4, y + 5] : [x - 16, y + 12, x + 16, y + 25];
});
const labelled = summits.flatMap((h) => {
  const [x, y] = at(h.u, h.v), text = shortName(h.org, vertical ? 14 : 20), w = text.length * 6.6 + 6;
  const box = [x - w / 2, y - 26, x + w / 2, y - 12];
  if (box[0] < 2 || box[2] > width - 2 || placed.some((p) => box[0] < p[2] && p[0] < box[2] && box[1] < p[3] && p[1] < box[3])) return [{ h, x, y, text: "" }];
  placed.push(box);
  return [{ h, x, y, text }];
});
// The trail: a hiker going from place to place in time order (each role's hill, by when its middle
// falls, taking the nearest of those within a year). On the way it bends along the contour lines where the land is steep, rather than
// climbing straight; at each place it circles the hill, spiralling up to the summit. (Studies
// shape the land; the trail keeps to roles.)
const toUV = ([x, y]: Point): [number, number] => vertical
  ? [start + ((y - y0) / (y1 - y0)) * (end - start), (x - x0) / (x1 - x0)]
  : [start + ((x - x0) / (x1 - x0)) * (end - start), (y - y0) / (y1 - y0)];
const elevation = (p: Point) => z(...toUV(p));
const slope = (p: Point): Point => [(elevation([p[0] + 1, p[1]]) - elevation([p[0] - 1, p[1]])) / 2, (elevation([p[0], p[1] + 1]) - elevation([p[0], p[1] - 1])) / 2];
const steep = (top / Math.min(x1 - x0, y1 - y0)) * 2;
// Order: always among the places whose time comes within a year of the earliest left, the nearest.
const left = [...hills].sort((a, b) => a.u - b.u), stops: typeof hills = [];
let from = at(start, left[0].v);
while (left.length) {
  const soon = left.filter((h) => h.u <= left[0].u + 12);
  const next = soon.sort((a, b) => Math.hypot(...at(a.u, a.v).map((c, i) => c - from[i]) as [number, number]) - Math.hypot(...at(b.u, b.v).map((c, i) => c - from[i]) as [number, number]))[0];
  stops.push(next);
  left.splice(left.indexOf(next), 1);
  from = at(next.u, next.v);
}
const walk: Point[] = [at(start, stops[0].v)];
const go = (target: Point, near: number) => {
  let p = walk[walk.length - 1];
  for (let n = 0; n < 600; n++) {
    const [dx, dy] = [target[0] - p[0], target[1] - p[1]], d = Math.hypot(dx, dy);
    if (d < near) break;
    const [gx, gy] = slope(p), g = Math.hypot(gx, gy);
    let [mx, my] = [dx / d, dy / d];
    if (g > 0 && d > near * 2) {
      // Follow the contour (perpendicular to the slope) more, the steeper it is.
      let [tx, ty] = [-gy / g, gx / g];
      if (tx * mx + ty * my < 0) [tx, ty] = [-tx, -ty];
      const w = 0.85 * Math.min(1, g / steep);
      [mx, my] = [mx * (1 - w) + tx * w, my * (1 - w) + ty * w];
      const m = Math.hypot(mx, my) || 1;
      [mx, my] = [mx / m, my / m];
    }
    p = [Math.max(x0, Math.min(x1, p[0] + mx * 3)), Math.max(y0, Math.min(y1, p[1] + my * 3))];
    walk.push(p);
  }
};
stops.forEach((h, k) => {
  const summit = at(h.u, h.v), ring = Math.max(7, Math.min(30, 5 + Math.sqrt(h.months) * 3));
  go(summit, ring);
  // Circle the hill, spiralling up to its summit (alternately clockwise and anticlockwise).
  const p = walk[walk.length - 1], a0 = Math.atan2(p[1] - summit[1], p[0] - summit[0]), sign = k % 2 ? 1 : -1, r0 = Math.hypot(p[0] - summit[0], p[1] - summit[1]);
  for (let i = 1; i <= 48; i++) {
    const u = i / 48, a = a0 + sign * u * Math.PI * 2.6, r = r0 * (1 - 0.8 * u);
    walk.push([summit[0] + Math.cos(a) * r, summit[1] + Math.sin(a) * r]);
  }
});
go(at(now, stops[stops.length - 1].v), 2);
const trail = walk.filter((_, k) => k % 3 === 0 || k === walk.length - 1);
const here = trail[trail.length - 1];
---

<div class="fig topo">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Path since ${firstYear} as a topographic map: every role a hill in the region of its kind, with my trail across them`}>
    {regions.map((_, r) => {
      const [a, b] = [at(start, band * (r + 1)), at(end, band * (r + 1))];
      return <line class="border" x1={f(a[0])} y1={f(a[1])} x2={f(b[0])} y2={f(b[1])} />;
    })}
    {regions.map((p, r) => {
      const [x, y] = vertical ? at(start, band * (r + 0.5)) : at(start, band * r);
      return vertical ? <text class="region" x={f(x)} y={f(y - 4)} text-anchor="middle">{p.title}</text> : <text class="region" x={f(x + 2)} y={f(y + 11)}>{p.title}</text>;
    })}
    {levels.map((l) => l.lines.map((line) => <path class:list={["contour", { index: l.index }]} d={smooth(line.points, line.closed)} />))}
    <path class="trail" d={smooth(trail)} />
    <path class="hiker" d={smooth(trail)} pathLength="1" />
    {labelled.map(({ h, x, y, text }) => (
      <a href={h.id && refs[h.id] ? refs[h.id].href : `/path/#${h.section}`}>
        <title>{h.org} · {h.role} · {h.months} months{h.linked ? ` · ${h.linked} linked outputs and events` : ""}</title>
        <path class="summit" d={`M${f(x - 4)},${f(y + 2)} L${f(x)},${f(y - 5)} L${f(x + 4)},${f(y + 2)}Z`} />
        {text && <text x={f(x)} y={f(y - 12)} text-anchor="middle">{text}</text>}
      </a>
    ))}
    <circle class="here" cx={f(here[0])} cy={f(here[1])} r="4"><title>now</title></circle>
    {years.map((yr) => {
      const [x, y] = at(yr * 12, vertical ? 0 : 1);
      return vertical ? <text class="year" x={f(x - 8)} y={f(y + 3)} text-anchor="end">{yr}</text> : <text class="year" x={f(x)} y={f(y + 22)} text-anchor="middle">{yr}</text>;
    })}
  </svg>
</div>
