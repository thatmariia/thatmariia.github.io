---
// Career phases as EEG scalp maps. Each electrode is a kind of activity; the potential peaks where
// there was most of it in that phase, and electrodes pulse faster the more there was. Maps are average-referenced like real EEG (solid contours
// above the average, faint below) and share one scale so phases can be compared.
import { events, firstYear, lastYear, roles, works } from "../../lib/career";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const phases = [
  { label: `${firstYear}–2017`, from: firstYear, to: 2017 },
  { label: "2018–2023", from: 2018, to: 2023 },
  { label: `2024–${lastYear === new Date().getFullYear() ? "now" : lastYear}`, from: 2024, to: lastYear },
];
const inPhase = (year: number, p: (typeof phases)[number]) => year >= p.from && year <= p.to;
const rolesIn = (sections: string[], p: (typeof phases)[number]) =>
  roles.filter((r) => sections.includes(r.section) && r.span[0] < (p.to + 1) * 12 && r.span[1] >= p.from * 12).length;
const sites = [
  { code: "PA", label: "papers", count: (p: any) => works.filter((w) => w.kind === "publications" && inPhase(w.year, p)).length },
  { code: "PR", label: "preprints", count: (p: any) => works.filter((w) => w.kind === "preprints" && inPhase(w.year, p)).length },
  { code: "SW", label: "software & data", count: (p: any) => works.filter((w) => !["publications", "preprints"].includes(w.kind) && inPhase(w.year, p)).length },
  { code: "TK", label: "talks & posters", count: (p: any) => events.filter((e) => e.section === "events" && inPhase(Math.floor(e.start / 12), p)).length },
  { code: "OU", label: "outreach", count: (p: any) => events.filter((e) => e.section === "outreach" && inPhase(Math.floor(e.start / 12), p)).length },
  { code: "LE", label: "leadership", count: (p: any) => rolesIn(["leadership", "service", "other"], p) },
  { code: "TE", label: "teaching", count: (p: any) => rolesIn(["teaching"], p) },
].map((site, i, all) => {
  const a = -Math.PI / 2 + (2 * Math.PI * i) / all.length;
  return { ...site, u: 0.58 * Math.cos(a), v: 0.58 * Math.sin(a), angle: a };
});
const counts = phases.map((p) => sites.map((s) => s.count(p)));
const peak = Math.sqrt(Math.max(1, ...counts.flat()));

// Potential: one Gaussian bump per electrode, weighted by √count, minus its mean over the scalp.
const raw = (u: number, v: number, c: number[]) =>
  sites.reduce((sum, s, i) => sum + (Math.sqrt(c[i]) / peak) * Math.exp(-((u - s.u) ** 2 + (v - s.v) ** 2) / (2 * 0.36 ** 2)), 0);
const n = 64, step = 2 / n;
const fields = counts.map((c) => {
  const grid = Array.from({ length: n + 1 }, (_, i) => Array.from({ length: n + 1 }, (_, j) => raw(-1 + j * step, -1 + i * step, c)));
  const inside = grid.flatMap((row, i) => row.filter((_, j) => (-1 + j * step) ** 2 + (-1 + i * step) ** 2 <= 1));
  const mean = inside.reduce((s, x) => s + x, 0) / inside.length;
  return grid.map((row) => row.map((x) => x - mean));
});
const top = Math.max(...fields.flat(2).map(Math.abs));
const levels = [-0.75, -0.55, -0.35, -0.15, 0.15, 0.35, 0.55, 0.75].map((l) => l * top);

const wide = width > height, keyHeight = wide ? 26 : 60;
const [cellW, cellH] = wide ? [width / 3, height - keyHeight] : [width, (height - keyHeight) / 3];
const radius = Math.min(cellW, cellH) * (wide ? 0.3 : 0.3);
const f = (x: number) => x.toFixed(1);

// Marching squares: line segments where the potential crosses each level, split by sign.
function contours(grid: number[][], cx: number, cy: number) {
  const out = { positive: "", negative: "" };
  const xy = (u: number, v: number) => `${f(cx + u * radius)},${f(cy + v * radius)}`;
  for (const level of levels) {
    let d = "";
    for (let i = 0; i < n; i++) {
      for (let j = 0; j < n; j++) {
        const [u, v] = [-1 + j * step, -1 + i * step];
        const c = [grid[i][j], grid[i][j + 1], grid[i + 1][j + 1], grid[i + 1][j]];
        const corners = [[u, v], [u + step, v], [u + step, v + step], [u, v + step]];
        const crossings: number[][] = [];
        for (let e = 0; e < 4; e++) {
          const [a, b] = [c[e], c[(e + 1) % 4]];
          if ((a - level) * (b - level) < 0) {
            const t = (level - a) / (b - a), [p, q] = [corners[e], corners[(e + 1) % 4]];
            crossings.push([p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])]);
          }
        }
        for (let s = 0; s + 1 < crossings.length; s += 2) d += `M${xy(crossings[s][0], crossings[s][1])}L${xy(crossings[s + 1][0], crossings[s + 1][1])}`;
      }
    }
    out[level > 0 ? "positive" : "negative"] += d;
  }
  return out;
}

const panels = phases.map((phase, k) => {
  const [cx, cy] = wide ? [cellW * (k + 0.5), height * 0.46] : [width / 2, cellH * (k + 0.46)];
  return { phase, k, cx, cy, ...contours(fields[k], cx, cy) };
});
---

<div class="fig topography">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Activity by career phase (${phases.map((p) => p.label).join(", ")}) as scalp maps`}>
    {panels.map(({ phase, k, cx, cy, positive, negative }) => (
      <g>
        <clipPath id={`scalp-${seed}-${width}-${k}`}><circle cx={cx} cy={cy} r={radius} /></clipPath>
        <g clip-path={`url(#scalp-${seed}-${width}-${k})`}>
          <path class="contour negative" d={negative} />
          <path class="contour positive" d={positive} />
        </g>
        <circle class="head" cx={cx} cy={cy} r={radius} />
        <path class="head" d={`M${f(cx - radius * 0.13)},${f(cy - radius * 0.99)} L${f(cx)},${f(cy - radius * 1.13)} L${f(cx + radius * 0.13)},${f(cy - radius * 0.99)}`} />
        <path class="head" d={`M${f(cx - radius)},${f(cy - radius * 0.14)} q${f(-radius * 0.09)},${f(radius * 0.02)} ${f(-radius * 0.07)},${f(radius * 0.14)} t${f(radius * 0.07)},${f(radius * 0.14)}`} />
        <path class="head" d={`M${f(cx + radius)},${f(cy - radius * 0.14)} q${f(radius * 0.09)},${f(radius * 0.02)} ${f(radius * 0.07)},${f(radius * 0.14)} t${f(-radius * 0.07)},${f(radius * 0.14)}`} />
        {sites.map((s, i) => (
          <circle class="electrode" cx={f(cx + s.u * radius)} cy={f(cy + s.v * radius)} r="2.2"
            style={counts[k][i] ? `animation-duration: ${(3.2 / Math.sqrt(counts[k][i])).toFixed(2)}s` : "animation: none"}>
            <title>{s.label}: {counts[k][i]}</title>
          </circle>
        ))}
        {sites.map((s) => <text class="code" x={f(cx + s.u * radius * 1.32)} y={f(cy + s.v * radius * 1.32 + 3)} text-anchor="middle">{s.code}</text>)}
        <text class="phase" x={cx} y={cy + radius + 22} text-anchor="middle">{phase.label}</text>
      </g>
    ))}
    {(wide ? [sites] : [sites.slice(0, 3), sites.slice(3, 5), sites.slice(5)]).map((line, row) => (
      <text class="key" x={width / 2} y={height - keyHeight + 14 + row * 16} text-anchor="middle">{line.map((s) => `${s.code} ${s.label}`).join("  ·  ")}</text>
    ))}
  </svg>
</div>
