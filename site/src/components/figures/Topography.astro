---
// EEG scalp topographies at successive times: potential isocontours (solid positive, faint
// negative) of a rotating dipole-like pattern inside a head outline with electrode positions.
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const f = (v: number) => v.toFixed(1);
const wide = width > height, heads = wide ? 3 : 2;
const [cellW, cellH] = wide ? [width / heads, height] : [width, height / heads];
const radius = Math.min(cellW, cellH) * 0.34;

// Potential on the unit disc: a positive and a negative blob opposite each other, plus a weaker
// pair, rotating from one panel to the next.
function potential(u: number, v: number, k: number) {
  const blob = (x: number, y: number, s: number) => Math.exp(-((u - x) ** 2 + (v - y) ** 2) / (2 * s * s));
  const a = 0.6 + seed * 0.3 + k * 0.85, b = a + 2.1;
  return blob(0.45 * Math.cos(a), 0.45 * Math.sin(a), 0.32) - blob(-0.45 * Math.cos(a), -0.45 * Math.sin(a), 0.32)
    + 0.45 * (blob(0.55 * Math.cos(b), 0.55 * Math.sin(b), 0.22) - blob(-0.55 * Math.cos(b), -0.55 * Math.sin(b), 0.22));
}

// Marching squares over a grid on [-1, 1]², one path per sign of the contour level.
function contours(k: number, cx: number, cy: number) {
  const n = 64, step = 2 / n, levels = [-0.75, -0.6, -0.45, -0.3, -0.15, 0.15, 0.3, 0.45, 0.6, 0.75];
  const grid = Array.from({ length: n + 1 }, (_, i) => Array.from({ length: n + 1 }, (_, j) => potential(-1 + j * step, -1 + i * step, k)));
  const out = { positive: "", negative: "" };
  const xy = (u: number, v: number) => `${f(cx + u * radius)},${f(cy + v * radius)}`;
  for (const level of levels) {
    let d = "";
    for (let i = 0; i < n; i++) {
      for (let j = 0; j < n; j++) {
        const [u, v] = [-1 + j * step, -1 + i * step];
        const c = [grid[i][j], grid[i][j + 1], grid[i + 1][j + 1], grid[i + 1][j]];
        const corners = [[u, v], [u + step, v], [u + step, v + step], [u, v + step]];
        // Points where the level crosses each edge of the cell.
        const crossings: number[][] = [];
        for (let e = 0; e < 4; e++) {
          const [a, b] = [c[e], c[(e + 1) % 4]];
          if ((a - level) * (b - level) < 0) {
            const t = (level - a) / (b - a), [p, q] = [corners[e], corners[(e + 1) % 4]];
            crossings.push([p[0] + t * (q[0] - p[0]), p[1] + t * (q[1] - p[1])]);
          }
        }
        for (let s = 0; s + 1 < crossings.length; s += 2) d += `M${xy(...(crossings[s] as [number, number]))}L${xy(...(crossings[s + 1] as [number, number]))}`;
      }
    }
    out[level > 0 ? "positive" : "negative"] += d;
  }
  return out;
}

const electrodes = [[0, 1], [0.33, 8], [0.66, 12], [0.92, 14]].flatMap(([r, count]) =>
  Array.from({ length: count }, (_, i) => [r * Math.cos((2 * Math.PI * i) / count - Math.PI / 2), r * Math.sin((2 * Math.PI * i) / count - Math.PI / 2)]));
const panels = Array.from({ length: heads }, (_, k) => {
  const [cx, cy] = wide ? [cellW * (k + 0.5), height * 0.47] : [width / 2, cellH * (k + 0.47)];
  return { k, cx, cy, ...contours(k, cx, cy) };
});
---

<div class="fig topography">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="EEG scalp topographies at successive moments">
    {panels.map(({ k, cx, cy, positive, negative }) => (
      <g>
        <clipPath id={`scalp-${seed}-${width}-${k}`}><circle cx={cx} cy={cy} r={radius} /></clipPath>
        <g clip-path={`url(#scalp-${seed}-${width}-${k})`}>
          <path class="contour negative" d={negative} />
          <path class="contour positive" d={positive} />
        </g>
        <circle class="head" cx={cx} cy={cy} r={radius} />
        <path class="head" d={`M${f(cx - radius * 0.13)},${f(cy - radius * 0.99)} L${f(cx)},${f(cy - radius * 1.13)} L${f(cx + radius * 0.13)},${f(cy - radius * 0.99)}`} />
        <path class="head" d={`M${f(cx - radius)},${f(cy - radius * 0.14)} q${f(-radius * 0.09)},${f(radius * 0.02)} ${f(-radius * 0.07)},${f(radius * 0.14)} t${f(radius * 0.07)},${f(radius * 0.14)}`} />
        <path class="head" d={`M${f(cx + radius)},${f(cy - radius * 0.14)} q${f(radius * 0.09)},${f(radius * 0.02)} ${f(radius * 0.07)},${f(radius * 0.14)} t${f(-radius * 0.07)},${f(radius * 0.14)}`} />
        {electrodes.map(([u, v]) => <circle class="electrode" cx={f(cx + u * radius)} cy={f(cy + v * radius)} r="1.6" />)}
        <text x={cx} y={cy + radius + 26} text-anchor="middle">{k * 100} ms</text>
      </g>
    ))}
  </svg>
</div>
