---
// Beyond science as a beach-volleyball rally, two players a side. Each side plays three touches:
// the back player passes, the net player sets, and the back player runs in, jumps and attacks over
// the net. Every touch shows the next activity. The ball is a beach ball with swirled panels,
// spinning, with its shadow on the sand. SMIL animations, paused for visitors who prefer reduced motion.
import { data } from "../../lib/data";
import { random } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const uniform = random(seed);
const activities = (data.beyond as { title: string }[]).map((a) => a.title);
const f = (v: number) => v.toFixed(1);
const k = Math.min(1.4, width / 330);  // player scale
const sand = height - 40, net = width / 2, netTop = sand - 76 * k, half = net - 12;

// Body poses, relative to the feet and in player units: arms from the shoulder.
const arms = (pose: "pass" | "set" | "attack", face: number) => {
  const [a, b] = { pass: [[11, -36], [10, -34]], set: [[3, -68], [6, -67]], attack: [[5, -70], [-6, -52]] }[pose];
  return `M0,-46 L${a[0] * face},${a[1]} M0,-46 L${b[0] * face},${b[1]}`;
};
const body = "M0,-51 L0,-24 M0,-24 L-6,0 M0,-24 L6,0";

// Per side (left -1, right 1): positions, contact points (ball centres) and the touches.
const n = 6, touch = 1.05, cycle = n * touch;
const sides = [-1, 1].map((side, s) => {
  const face = -side, at = (u: number) => net + side * half * u;
  const [back, setter, attack] = [at(0.78), at(0.38), at(0.2)];
  const jump = 26;
  const contacts = [
    { x: back + 12 * face * k, y: sand - 45 * k },
    { x: setter + 4 * face * k, y: sand - 77 * k },
    { x: attack + 7 * face * k, y: sand - 104 * k },
  ];
  // The back player's run, jump and return, timed to the rally (touches 3s, 3s+1, 3s+2).
  const t = (u: number) => (3 * s + u) / n;
  const dx = (attack - back) / k;
  const keys: [number, string, "pass" | "attack"][] = [
    [0, "0,0", "pass"], [t(0), "0,0", "pass"], [t(1), `${f(dx * 0.6)},0`, "pass"], [t(1.6), `${f(dx * 0.95)},0`, "pass"],
    [t(2), `${f(dx)},${-jump}`, "attack"], [t(2.4), `${f(dx)},0`, "pass"], [t(3), "0,0", "pass"], [1, "0,0", "pass"],
  ];
  const unique = keys.filter(([time], i) => i === 0 || time > keys[i - 1][0]);
  const [times, moves, poses] = [unique.map(([time]) => time.toFixed(4)), unique.map(([, m]) => m), unique.map(([, , pose]) => arms(pose, face))];
  return { side, face, back, setter, contacts, times, moves, poses };
});
const touches = [...sides[0].contacts, ...sides[1].contacts];

// The rally: quadratic arcs between touches.
const loop = [...touches, touches[0]];
const kinds = ["pass", "set", "attack", "pass", "set", "attack"];
let path = `M${f(loop[0].x)},${f(loop[0].y)}`, shadow = `M${f(loop[0].x)},${f(sand + 3)}`;
const lengths: number[] = [], shadowLengths: number[] = [];
for (let i = 0; i < n; i++) {
  const [a, b] = [loop[i], loop[i + 1]], top = Math.min(a.y, b.y);
  // Attacks aim just over the tape; passes and sets peak high, half-way between the touches.
  const peak = kinds[i] === "pass" ? top - (top - 24) * 0.8 : top - (top - 24) * 0.45;
  const [qx, qy] = kinds[i] === "attack" ? [net, netTop - 22 * k] : [(a.x + b.x) / 2, 2 * peak - (a.y + b.y) / 2];
  path += ` Q${f(qx)},${f(qy)} ${f(b.x)},${f(b.y)}`;
  shadow += ` L${f(b.x)},${f(sand + 3)}`;
  let length = 0, [px, py] = [a.x, a.y];
  for (let j = 1; j <= 30; j++) {
    const u = j / 30, [x, y] = [(1 - u) ** 2 * a.x + 2 * (1 - u) * u * qx + u * u * b.x, (1 - u) ** 2 * a.y + 2 * (1 - u) * u * qy + u * u * b.y];
    length += Math.hypot(x - px, y - py);
    [px, py] = [x, y];
  }
  lengths.push(length);
  shadowLengths.push(Math.abs(b.x - a.x) || 1);
}
// Every touch takes the same time, for the ball and its shadow alike.
const keyTimes = loop.map((_, i) => (i / n).toFixed(4)).join(";");
const keyPoints = (ls: number[]) => {
  const total = ls.reduce((s, l) => s + l, 0);
  return loop.map((_, i) => (ls.slice(0, i).reduce((s, l) => s + l, 0) / total).toFixed(4)).join(";");
};

// Labels: touch j shows activity j (mod the number of activities) in the sand under the player,
// until the next touch; the label cycle lasts until every activity has been shown at every touch.
const rounds = activities.length * n;
const labels = Array.from({ length: rounds }, (_, j) => {
  const text = activities[j % activities.length], move = kinds[j % n], at = touches[j % n], w = (move.length + 1 + text.length) * 7.6;
  return { text, move, j, x: Math.max(w / 2 + 4, Math.min(width - w / 2 - 4, at.x)), y: sand + 30 };
});

// Beach ball: curved panels swirling out from the middle, every third one dark, with seams.
const r = 8 * k, count = 9;
const polar = (a: number, d: number) => `${f(Math.cos(a) * d)},${f(Math.sin(a) * d)}`;
const swirl = (a: number) => `C${polar(a + 1.6, r * 0.35)} ${polar(a + 0.9, r * 0.75)} ${polar(a, r)}`;
const panels = Array.from({ length: count }, (_, p) => {
  const [a0, a1] = [(2 * p * Math.PI) / count, (2 * (p + 1) * Math.PI) / count];
  const back = `C${polar(a1 + 0.9, r * 0.75)} ${polar(a1 + 1.6, r * 0.35)} 0,0`;
  return `<path class="${p % 3 ? "light" : "dark"}" d="M0,0 ${swirl(a0)} A${f(r)},${f(r)} 0 0 1 ${polar(a1, r)} ${back}Z" />`;
}).join("");
const grains = Array.from({ length: Math.round(width / 3) }, () => [uniform() * width, sand + 3 + uniform() * 14]);
---

<div class="fig volleyball">
  <svg viewBox={`0 0 ${width} ${height}`} role="img"
    aria-label={`A beach volleyball rally, three touches a side, each touch an activity: ${activities.join(", ")}`}>
    <line class="sand" x1="0" x2={width} y1={sand} y2={sand} />
    {grains.map(([x, y]) => <circle class="grain" cx={f(x)} cy={f(y)} r="0.7" />)}
    <line class="pole" x1={net} x2={net} y1={f(netTop - 4)} y2={sand} />
    {Array.from({ length: 4 }, (_, m) => <line class="mesh" x1={net - 5} x2={net + 5} y1={f(netTop + m * 8 * k)} y2={f(netTop + (m + 1) * 8 * k)} />)}
    <line class="tape" x1={net - 6} x2={net + 6} y1={f(netTop)} y2={f(netTop)} />
    <path class="rally" d={path} />
    {sides.map((p) => (
      <g class="player" transform={`translate(${f(p.setter)},${f(sand)}) scale(${k})`}>
        <circle cy="-56" r="5" />
        <path d={body} />
        <path d={arms("set", p.face)} />
      </g>
    ))}
    {sides.map((p) => (
      <g transform={`translate(${f(p.back)},${f(sand)}) scale(${k})`}>
        <g class="player">
          <animateTransform attributeName="transform" type="translate" dur={`${cycle.toFixed(2)}s`} repeatCount="indefinite"
            keyTimes={p.times.join(";")} values={p.moves.join(";")} />
          <circle cy="-56" r="5" />
          <path d={body} />
          <path d={p.poses[0]}>
            <animate attributeName="d" dur={`${cycle.toFixed(2)}s`} repeatCount="indefinite" keyTimes={p.times.join(";")} values={p.poses.join(";")} />
          </path>
        </g>
      </g>
    ))}
    {labels.map(({ text, move, j, x, y }) => (
      <text class="touch" x={f(x)} y={f(y)} text-anchor="middle" opacity={j === 0 ? 1 : 0}>
        <tspan class="move">{move}</tspan> {text}
        <animate attributeName="opacity" dur={`${(rounds * touch).toFixed(2)}s`} repeatCount="indefinite" calcMode="discrete"
          keyTimes={j === 0 ? `0;${(1 / rounds).toFixed(5)}` : `0;${(j / rounds).toFixed(5)};${((j + 1) / rounds).toFixed(5)}`}
          values={j === 0 ? "1;0" : "0;1;0"} />
      </text>
    ))}
    <ellipse class="shadow" rx={f(r)} ry="2.4">
      <animateMotion dur={`${cycle.toFixed(2)}s`} repeatCount="indefinite" path={shadow} calcMode="linear" keyTimes={keyTimes} keyPoints={keyPoints(shadowLengths)} />
    </ellipse>
    <g class="ball">
      <animateMotion dur={`${cycle.toFixed(2)}s`} repeatCount="indefinite" path={path} calcMode="linear" keyTimes={keyTimes} keyPoints={keyPoints(lengths)} />
      <g>
        <animateTransform attributeName="transform" type="rotate" from="0" to="360" dur="0.9s" repeatCount="indefinite" />
        <g set:html={panels} />
        <circle class="rim" r={f(r)} />
      </g>
    </g>
  </svg>
</div>

<script>
  // SMIL animations ignore CSS, so pause them by hand for visitors who prefer reduced motion.
  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    for (const svg of document.querySelectorAll<SVGSVGElement>(".fig.volleyball svg")) svg.pauseAnimations();
  }
</script>
