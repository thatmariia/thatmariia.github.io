---
// Where co-authors are, from OpenAlex affiliations: a polar world chart around home with a
// logarithmic distance scale, one dot per city sized by the works shared with people there, and
// pulses running outwards along the lines to them.
import external from "../../data/external.json";
import { data } from "../../lib/data";
import { cityOf, distanceBearing } from "../../lib/places";
import { random } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { seed, width, height } = Astro.props;

const home = cityOf(data.profile.location)!;
const byCity = new Map<string, { city: string; country: string; at: [number, number]; works: number; names: string[] }>();
for (const i of external.institutions) {
  const city = i.city ?? i.name;
  const entry = byCity.get(city) ?? { city, country: i.country, at: [i.lat, i.lon] as [number, number], works: 0, names: [] };
  entry.works += i.works;
  entry.names.push(i.name);
  byCity.set(city, entry);
}
const cities = [...byCity.values()].map((c) => ({ ...c, ...distanceBearing(home.at, c.at) }));
const maxDistance = Math.max(...cities.map((c) => c.distance));
const [cx, cy] = [width / 2, height / 2], R = Math.min(width, height) / 2 - 30;
const scale = (d: number) => (R * Math.log10(1 + d / 5)) / Math.log10(1 + maxDistance / 5);
const f = (v: number) => v.toFixed(1);
const uniform = random(seed);
const points = cities.map((c) => {
  const r = scale(c.distance);
  return { ...c, x: cx + r * Math.sin(c.bearing), y: cy - r * Math.cos(c.bearing), size: 1.8 + Math.sqrt(c.works) * 1.6, delay: uniform() * 4 };
});
const labelled = points.filter((p) => p.distance > 150).sort((a, b) => b.works - a.works).slice(0, width > height ? 16 : 10);
---

<div class="fig world">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Co-authors in ${cities.length} cities around the world`}>
    {Array.from({ length: 12 }, (_, k) => <line class="meridian" x1={f(cx)} y1={f(cy)} x2={f(cx + R * Math.sin((k * Math.PI) / 6))} y2={f(cy - R * Math.cos((k * Math.PI) / 6))} />)}
    {[100, 1000, 10000].map((d) => (
      <g class="ring">
        <circle cx={f(cx)} cy={f(cy)} r={f(scale(d))} />
        <text x={f(cx + 4)} y={f(cy - scale(d) - 3)}>{d.toLocaleString("en")} km</text>
      </g>
    ))}
    {points.map((p) => <line class="link" x1={f(cx)} y1={f(cy)} x2={f(p.x)} y2={f(p.y)} />)}
    {points.map((p) => <line class="pulse" x1={f(cx)} y1={f(cy)} x2={f(p.x)} y2={f(p.y)} pathLength="1" style={`animation-delay: ${p.delay.toFixed(2)}s`} />)}
    {points.map((p) => <circle class="city" cx={f(p.x)} cy={f(p.y)} r={f(p.size)}><title>{p.city} ({p.country}) · {p.works} shared · {p.names.join(", ")}</title></circle>)}
    <circle class="home" cx={f(cx)} cy={f(cy)} r="4.5"><title>{home.name}</title></circle>
    {labelled.map((p) => p.x > cx + R * 0.35
      ? <text x={f(p.x - p.size - 3)} y={f(p.y - p.size - 3)} text-anchor="end">{p.city}</text>
      : <text x={f(p.x + p.size + 3)} y={f(p.y + 3)}>{p.city}</text>)}
  </svg>
</div>
