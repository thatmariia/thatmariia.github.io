---
// The path as a spacetime diagram: places across (west to east, evenly spaced), time upwards. Each
// stay is a grey bar at its place; the bold worldline is me, moving between the places active at
// the time, with a small light cone at every move. A pulse keeps travelling up the worldline.
import { now, roles } from "../../lib/career";
import { cityOf } from "../../lib/places";
import { points, type Point } from "../../lib/random";
interface Props { seed: number; width: number; height: number }
const { width, height } = Astro.props;

const stays = roles.flatMap((r) => { const c = cityOf(r.location); return c ? [{ ...c, from: r.span[0], to: Math.max(r.span[1], r.span[0] + 1) }] : []; });
const places = [...new Map(stays.map((s) => [s.name, s.at[1]])).entries()].sort((a, b) => a[1] - b[1]).map(([name]) => name);
const [start, end] = [Math.min(...stays.map((s) => s.from)), now + 1];
const [left, right, top, bottom] = [46, width - 16, 16, height - 70];
const column = (name: string) => left + ((places.indexOf(name) + 0.5) / places.length) * (right - left);
const y = (t: number) => bottom - ((t - start) / (end - start)) * (bottom - top);
const f = (v: number) => v.toFixed(1);

// The worldline: each month at the mean position of the active places (or where it was last).
let x = column(stays.sort((a, b) => a.from - b.from)[0].name);
const line: Point[] = [], moves: Point[] = [];
for (let t = start; t <= end; t += 0.5) {
  const active = stays.filter((s) => s.from <= t && t < s.to);
  const target = active.length ? active.reduce((sum, s) => sum + column(s.name), 0) / active.length : x;
  if (Math.abs(target - x) > 8) moves.push([x, y(t)]);
  x += (target - x) * 0.35;
  line.push([x, y(t)]);
}
const cone = 14;
const years = Array.from({ length: Math.floor(now / 12) - Math.floor(start / 12) + 1 }, (_, i) => Math.floor(start / 12) + i).filter((yr) => yr % 2 === 0);
---

<div class="fig worldline">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`A spacetime diagram of moving between ${places.join(", ")}`}>
    {places.map((name) => <line class="axis" x1={f(column(name))} x2={f(column(name))} y1={top} y2={bottom} />)}
    {stays.map((s) => <line class="stay" x1={f(column(s.name))} x2={f(column(s.name))} y1={f(y(s.from))} y2={f(y(s.to))}><title>{s.name}</title></line>)}
    {moves.map(([mx, my]) => <path class="cone" d={`M${f(mx - cone)},${f(my - cone)} L${f(mx)},${f(my)} L${f(mx + cone)},${f(my - cone)}`} />)}
    <polyline class="me" points={points(line)} />
    <polyline class="pulse" points={points(line)} pathLength="1" />
    {years.map((yr) => <text x={left - 8} y={f(y(yr * 12) + 3)} text-anchor="end">{yr}</text>)}
    {places.map((name) => {
      const cx = column(name);
      return <text x={f(cx)} y={bottom + 14} transform={`rotate(50 ${f(cx)} ${bottom + 14})`}>{name}</text>;
    })}
  </svg>
</div>
