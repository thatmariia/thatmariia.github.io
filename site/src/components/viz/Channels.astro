---
// Fields as channels of a multichannel EEG recording, with a time grid and scale bars.
import { points, random, type Point } from "../../lib/walk";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, seed, width, height } = Astro.props;

const { uniform, gauss } = random(seed);
const n = fields.length;
// On narrow figures the channel names go above the traces instead of beside them.
const stacked = width < 500;
const left = stacked ? 4 : Math.min(170, width * 0.32), right = width - 12, top = stacked ? 22 : 14, bottom = height - 36;
const rowHeight = (bottom - top) / n;
const seconds = 2, samples = 360;
const x = (t: number) => left + ((right - left) * t) / seconds;

const channels = fields.map((field, i) => {
  // A few rhythms (alpha-, theta- and beta-like) plus smoothed noise, different per channel.
  const rhythms = [4 + uniform() * 3, 8 + uniform() * 4, 15 + uniform() * 10].map((f, k) => ({
    f, phase: uniform() * 2 * Math.PI, amp: [0.5, 1, 0.35][k] * (0.6 + uniform() * 0.8),
  }));
  const base = top + rowHeight * (i + 0.5);
  let noise = 0;
  const trace: Point[] = [];
  for (let s = 0; s <= samples; s++) {
    const t = (s / samples) * seconds;
    noise = 0.85 * noise + 0.35 * gauss();
    const v = rhythms.reduce((sum, r) => sum + r.amp * Math.sin(2 * Math.PI * r.f * t + r.phase), 0) + noise;
    trace.push([x(t), base - v * rowHeight * 0.17]);
  }
  return { field, base, trace };
});
const grid = Array.from({ length: seconds * 4 + 1 }, (_, k) => x(k / 4));
---

<svg class="viz-svg channels" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields as EEG channels: ${fields.join(", ")}`}>
  {grid.map((gx, k) => <line class:list={["grid", { major: k % 4 === 0 }]} x1={gx} y1={top} x2={gx} y2={bottom} />)}
  {channels.map((c, i) => (
    <g style={`--i: ${i}`} class:list={{ current: i === n - 1 }}>
      <text class="label" x={stacked ? left : left - 14} y={stacked ? c.base - rowHeight * 0.36 : c.base + 4} text-anchor={stacked ? "start" : "end"}>{c.field}</text>
      <polyline class="draw" points={points(c.trace)} pathLength="1" />
    </g>
  ))}
  <g class="scale">
    <line x1={right - 60} y1={bottom + 22} x2={right} y2={bottom + 22} />
    <line x1={right} y1={bottom + 22} x2={right} y2={bottom + 22 - rowHeight * 0.4} />
    <text x={right - 30} y={bottom + 34} text-anchor="middle">250 ms</text>
    <text x={right - 6} y={bottom + 18 - rowHeight * 0.2} text-anchor="end">50 µV</text>
  </g>
</svg>
