---
// Fields as clusters in a 2D embedding (UMAP-style scatter), joined in order by a faint walk.
import { bridge, points, random, type Point } from "../../lib/walk";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, seed, width, height } = Astro.props;

const COLORS = ["#2346d1", "#d8321f", "#a3784f", "#1d6b63", "#e2a32b", "#5aa65a", "#cf5f9e"];
const { uniform, gauss } = random(seed);
const pad = 40, spread = Math.min(width, height) * 0.045;
const minGap = Math.min(width, height) * 0.28;
const centers: Point[] = [];
for (let tries = 0; centers.length < fields.length; tries++) {
  // Keep clear of the axes in the bottom-left corner.
  const p: Point = [pad + 30 + uniform() * (width - 2 * pad - 60), pad + 20 + uniform() * (height - 2 * pad - 90)];
  const gap = tries > 3000 ? 0 : minGap * (1 - tries / 4000);
  if (centers.every((q) => Math.hypot(p[0] - q[0], p[1] - q[1]) > gap)) centers.push(p);
}
const clusters = centers.map((c, i) => ({
  field: fields[i], center: c, color: COLORS[i % COLORS.length],
  dots: Array.from({ length: 42 }, () => [c[0] + gauss() * spread * 1.4, c[1] + gauss() * spread] as Point),
}));
const walk = centers.slice(1).flatMap((c, i) => bridge(gauss, centers[i], c, 30, 3).slice(i ? 1 : 0));
---

<svg class="viz-svg embedding" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields as clusters: ${fields.join(", ")}`}>
  <g class="axes">
    <line x1="12" y1={height - 12} x2="72" y2={height - 12} />
    <line x1="12" y1={height - 12} x2="12" y2={height - 72} />
    <text x="78" y={height - 8}>UMAP 1</text>
    <text x="8" y={height - 80}>UMAP 2</text>
  </g>
  <polyline class="walk draw" points={points(walk)} pathLength="1" />
  {clusters.map((c, i) => (
    <g style={`--c: ${c.color}; --i: ${i}`} class="cluster">
      {c.dots.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.6" />)}
      <text x={c.center[0]} y={c.center[1] - spread * 3.2} text-anchor="middle">{c.field}</text>
    </g>
  ))}
</svg>
