---
// Fields as point charges (alternating + and −) with the electric field lines between them.
import { points, random, type Point } from "../../lib/walk";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, seed, width, height } = Astro.props;

const { uniform } = random(seed);
const pad = 46, minGap = Math.min(width, height) * 0.3;
const charges: { at: Point; q: number }[] = [];
for (let tries = 0; charges.length < fields.length; tries++) {
  const p: Point = [pad + uniform() * (width - 2 * pad), pad + uniform() * (height - 2 * pad)];
  const gap = tries > 3000 ? 0 : minGap * (1 - tries / 4000);
  if (charges.every((c) => Math.hypot(p[0] - c.at[0], p[1] - c.at[1]) > gap)) charges.push({ at: p, q: charges.length % 2 ? -1 : 1 });
}

function field([x, y]: Point): Point {
  let ex = 0, ey = 0;
  for (const { at: [cx, cy], q } of charges) {
    const dx = x - cx, dy = y - cy, r3 = Math.max(1, Math.hypot(dx, dy)) ** 3;
    ex += (q * dx) / r3;
    ey += (q * dy) / r3;
  }
  return [ex, ey];
}

// Trace lines out of each positive charge until they reach a negative one or leave the figure.
const lines: Point[][] = [];
for (const { at: [cx, cy], q } of charges.filter((c) => c.q > 0)) {
  for (let k = 0; k < 12; k++) {
    const a = (2 * Math.PI * k) / 12 + 0.13;
    let p: Point = [cx + 9 * Math.cos(a), cy + 9 * Math.sin(a)];
    const line: Point[] = [p];
    for (let step = 0; step < 900; step++) {
      const [ex, ey] = field(p);
      const norm = Math.hypot(ex, ey) || 1;
      p = [p[0] + (3 * ex) / norm, p[1] + (3 * ey) / norm];
      line.push(p);
      const end = charges.some((c) => c.q < 0 && Math.hypot(p[0] - c.at[0], p[1] - c.at[1]) < 8);
      if (end || p[0] < -20 || p[0] > width + 20 || p[1] < -20 || p[1] > height + 20) break;
    }
    lines.push(line);
  }
}
---

<svg class="viz-svg fieldlines" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields as charges: ${fields.join(", ")}`}>
  <clipPath id={`clip-${seed}-${width}`}><rect width={width} height={height} /></clipPath>
  <g clip-path={`url(#clip-${seed}-${width})`}>
    {lines.map((line, i) => <polyline class="draw" style={`--i: ${i % 7}`} points={points(line)} pathLength="1" />)}
  </g>
  {charges.map(({ at: [x, y], q }, i) => (
    <g class:list={["charge", q > 0 ? "plus" : "minus"]}>
      <circle cx={x} cy={y} r="9" />
      <text class="sign" x={x} y={y + 4} text-anchor="middle">{q > 0 ? "+" : "−"}</text>
      <text class="label" x={x} y={y + 26} text-anchor="middle">{fields[i]}</text>
    </g>
  ))}
</svg>
