---
// Each field as its own hand-drawn line wandering across the figure; the lines cross.
import { bridge, points, random, type Point } from "../../lib/walk";
interface Props { fields: string[]; seed: number; width: number; height: number }
const { fields, seed, width, height } = Astro.props;

const COLORS = ["#2346d1", "#d8321f", "#a3784f", "#1d6b63", "#e2a32b", "#5aa65a", "#cf5f9e"];
const { uniform, gauss } = random(seed);
const n = fields.length;
const threads = fields.map((field, i) => {
  // Starts are spread top to bottom, ends are random, so the threads cross.
  const y0 = height * (0.1 + 0.8 * (i / Math.max(1, n - 1)));
  const y1 = height * (0.1 + 0.8 * uniform());
  const x0 = width * (0.03 + uniform() * 0.2), x1 = width * (0.78 + uniform() * 0.2);
  const line = bridge(gauss, [x0, y0] as Point, [x1, y1] as Point, 90, Math.min(width, height) * 0.009);
  return { field, line, color: COLORS[i % COLORS.length] };
});
---

<svg class="viz-svg threads" viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Fields: ${fields.join(", ")}`}>
  {threads.map((t, i) => {
    const [x0, y0] = t.line[0], [x1, y1] = t.line[t.line.length - 1];
    return (
      <g style={`--c: ${t.color}; --i: ${i}`}>
        <polyline class="draw" points={points(t.line)} pathLength="1" />
        <circle cx={x1} cy={y1} r="3.5" />
        <text x={x0} y={y0 - 10}>{t.field}</text>
      </g>
    );
  })}
</svg>
