---
import "@fontsource-variable/ibm-plex-sans/index.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource-variable/geist/index.css";
import "@fontsource-variable/geist-mono/index.css";
import "@fontsource-variable/instrument-sans/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "@fontsource-variable/hanken-grotesk/index.css";
import "../styles/base.css";
import "../styles/site.css";
import Head from "../components/Head.astro";
import Options from "../components/Options.astro";
import { affiliations, data, PAGES } from "../lib/data";

interface Props { title?: string; sections?: { id: string; title: string }[] }
const { title, sections = [] } = Astro.props;
const { profile } = data;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} />
    <script is:inline>
      try {
        for (const key of ["viz", "type", "tone"]) {
          const value = localStorage.getItem(`option-${key}`);
          if (value) document.documentElement.dataset[key] = value;
        }
      } catch {}
    </script>
  </head>
  <body>
    <aside class="side">
      <a class="name" href="/">{profile.name}</a>
      <p class="headline">{profile.headline}</p>
      <ul class="links">{profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
      <nav class="pages" aria-label="Pages">
        {PAGES.map(([href, label]) => (
          <div class="page">
            <a href={href} aria-current={href === here ? "page" : undefined}>{label}</a>
            {href === here && sections.length > 0 && (
              <ul class="subs">{sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}</ul>
            )}
          </div>
        ))}
      </nav>
      <dl class="facts">
        <dt>Based in</dt><dd>{profile.location}</dd>
        <dt>Affiliations</dt><dd>{affiliations.map((a) => <span>{a}</span>)}</dd>
      </dl>
    </aside>
    <main class="main">
      {title && <h1 class="page-title">{title}</h1>}
      <slot />
    </main>
    <Options />
  </body>
</html>
