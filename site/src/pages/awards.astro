---
import EntryItem from "../components/EntryItem.astro";
import Base from "../layouts/Base.astro";
import { data, type Entry } from "../lib/data";

const awards = data.awards as Entry[];
---

<Base title="Awards & distinctions" figures={["peaks", "rosettes"]}>
  <section class="block" id="awards">
    <h2>Awards & distinctions</h2>
    {awards.map((entry) => <EntryItem entry={entry} />)}
  </section>
</Base>
