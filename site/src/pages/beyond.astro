---
import Base from "../layouts/Base.astro";
import { data, markup } from "../lib/data";

const activities = data.beyond as { title: string; note?: string }[];
---

<Base title="Beyond science" figures={["volleyball"]}>
  <section class="block" id="activities">
    <h2>Activities</h2>
    <ul class="activities">
      {activities.map((a) => <li><strong>{a.title}</strong>{a.note && <span set:html={markup(a.note)} />}</li>)}
    </ul>
  </section>
</Base>
