---
import "@fontsource-variable/hanken-grotesk/index.css";
import "@fontsource/space-mono/400.css";
import "../styles/global.css";
import EntryItem from "../components/EntryItem.astro";
import Route from "../components/Route.astro";
import Section from "../components/Section.astro";
import WorkItem from "../components/WorkItem.astro";
import { data, firstSentence, isUpcoming, markup, outputSections, restOfText, type Entry } from "../lib/data";

const { profile } = data;
const [firstName, ...lastNames] = profile.name.split(" ");
const research = data.research as Entry[];
const current = research.flatMap((entry) =>
  entry.periods.filter((p) => p.end === "present").map((p) => ({ role: p.title, org: entry.title })),
);
const places = [...new Set(research.filter((e) => e.periods.some((p) => p.end === "present")).map((e) => e.location))];
const path = [
  ["Research", data.research], ["Teaching", data.teaching], ["Leadership", data.leadership],
  ["Service", data.service], ["Awards", data.awards], ["Funding", data.funding], ["Also", data.other],
].filter(([, items]) => items.length) as [string, Entry[]][];
const events = data.events as Entry[];
const upcoming = events.filter(isUpcoming).reverse();
const past = events.filter((e) => !isUpcoming(e));
const studies = (data.education as Entry[]).flatMap((e) => e.periods.map((p) => p.title));
const thesis = (data.education as Entry[]).flatMap((e) => e.related ?? []);
const pad = (n: number) => String(n).padStart(2, "0");
const counts = [
  { label: "Publications", value: data.publications.length + data.preprints.length, href: "#work" },
  { label: "Open outputs", value: outputSections.reduce((n, s) => n + s.items.length, 0), href: "#outputs" },
  { label: "Events", value: events.length, href: "#events" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name}</title>
    <meta name="description" content={`${profile.name} — ${profile.headline}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        if (theme) document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <a href="#">{profile.name}</a>
      <nav>
        <a href="#work">Work</a>
        <a href="#path">Path</a>
        <a href="#events">Events</a>
        <a href="#elsewhere">Elsewhere</a>
        <button class="theme" type="button" onclick="
          const root = document.documentElement;
          const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          root.dataset.theme = dark ? 'light' : 'dark';
          try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        "><span class="to-dark">Dark</span><span class="to-light">Light</span></button>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="cell intro">{profile.headline}</p>
        <p class="cell place">{places.map((p) => <span>{p}</span>)}</p>
        <h1 class="cell name">{firstName}<br />{lastNames.join(" ")}</h1>
        <figure class="cell figure">
          <Route stops={profile.walk} seed={42} />
          <Route stops={profile.walk} seed={42} vertical />
          <figcaption>
            <span class="mono">Fig. 1</span>
            <span>{firstSentence(profile.bio)}</span>
            <span class="key mono" aria-hidden="true">
              <span><i class="key-line"></i>route</span>
              <span><i class="key-pin"></i>field entered</span>
              <span><i class="key-tail"></i>still walking</span>
            </span>
          </figcaption>
        </figure>
        {counts.map((c) => (
          <a class="cell count" href={c.href}>
            <span class="mono">{c.label}</span>
            <span class="value">{pad(c.value)}</span>
            <span class="arrow" aria-hidden="true">↘</span>
          </a>
        ))}
        <div class="cell now">
          <span class="mono">Now</span>
          {current.map((c) => <p>{c.role}<span>{c.org}</span></p>)}
        </div>
      </section>

      <Section id="about" number="01" title="About">
        <div class="prose" set:html={markup(restOfText(profile.bio) || profile.bio)} />
        <dl class="facts">
          <dt class="mono">Studied</dt>
          <dd>
            {studies.join(", ")}
            {thesis.map((id) => <a class="mono" href={`#${id}`}>↔ thesis</a>)}
          </dd>
          {data.skills.map((group) => (
            <>
              <dt class="mono">{group.title}</dt>
              <dd>{Object.values(group.levels).flat().join(", ")}</dd>
            </>
          ))}
        </dl>
      </Section>

      <Section id="work" number="02" title="Publications">
        {data.publications.map((work) => <WorkItem work={work as any} />)}
        {data.preprints.length > 0 && <h3 class="group">Preprints<span>{pad(data.preprints.length)}</span></h3>}
        {data.preprints.map((work) => <WorkItem work={work as any} label="preprint" />)}
      </Section>

      <Section id="outputs" number="03" title="Open science">
        <p class="key mono legend">
          {outputSections.map((s) => <span><i class:list={["key-dot", s.color]} />{s.key}</span>)}
        </p>
        {outputSections.map((section) => (
          <>
            <h3 class="group">{section.key[0].toUpperCase() + section.key.slice(1)}<span>{pad(section.items.length)}</span></h3>
            {section.items.map((work) => <WorkItem work={work} label={section.label.toLowerCase()} color={section.color} />)}
          </>
        ))}
      </Section>

      <Section id="path" number="04" title="Path">
        {path.map(([title, items]) => (
          <>
            <h3 class="group">{title}<span>{pad(items.length)}</span></h3>
            {items.map((entry) => <EntryItem entry={entry} />)}
          </>
        ))}
      </Section>

      <Section id="events" number="05" title="Events">
        {upcoming.length > 0 && <h3 class="group">Upcoming<span>{pad(upcoming.length)}</span></h3>}
        {upcoming.map((entry) => <EntryItem entry={entry} upcoming />)}
        <h3 class="group">Conferences & events<span>{pad(past.length)}</span></h3>
        {past.map((entry) => <EntryItem entry={entry} />)}
        {data.outreach.length > 0 && <h3 class="group">Outreach<span>{pad(data.outreach.length)}</span></h3>}
        {(data.outreach as Entry[]).map((entry) => <EntryItem entry={entry} />)}
      </Section>

      <Section id="elsewhere" number="06" title="Elsewhere">
        <ul class="elsewhere">
          {profile.links.map((link) => <li><a href={link.url}>{link.label}<span aria-hidden="true">↗</span></a></li>)}
        </ul>
      </Section>
    </main>

    <footer class="colophon mono">
      <span>{profile.name}</span>
      <span>Set in Hanken Grotesk &amp; Space Mono</span>
      <span>Updated {new Date().toISOString().slice(0, 10)}</span>
    </footer>
  </body>
</html>
