---
import "@fontsource-variable/hanken-grotesk/index.css";
import "@fontsource/courier-prime/400.css";
import "../../styles/base.css";
import "../../styles/mockup-c.css";
import Content from "../../components/Content.astro";
import Head from "../../components/Head.astro";
import Threads from "../../components/Threads.astro";
import { affiliations, data, NAV } from "../../lib/data";
const { profile } = data;
---

<!doctype html>
<html lang="en">
  <head><Head /></head>
  <body>
    <nav class="top">{NAV.map(([id, label]) => <a href={`#${id}`}>{label.toLowerCase()}</a>)}</nav>
    <section class="hero">
      <div class="threads-wide"><Threads fields={profile.walk} seed={9} /></div>
      <div class="threads-narrow"><Threads fields={profile.walk} seed={9} width={420} height={560} /></div>
      <h1>{profile.name}</h1>
      <p class="note n1">{profile.headline.toLowerCase()}</p>
      <p class="note n2">based in {profile.location}</p>
      <p class="note n3">{affiliations.join(" & ")}</p>
      <ul class="note n4">{profile.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul>
    </section>
    <main class="column"><Content /></main>
  </body>
</html>
