---
import "../../styles/base.css";
import Head from "../../components/Head.astro";
const options = [
  ["a", "A — Index", "Sticky sidebar with a contents list and a trajectory plot of your fields; compact table rows. Sage paper, grotesk + mono."],
  ["b", "B — Orbit", "Solar-system poster: your fields as planets on dotted orbits, a legend table, sticky section tabs. Cream paper, geometric sans."],
  ["c", "C — Notebook", "Hand-drawn coloured threads, one per field, crossing behind a typewriter name; scattered notes; one calm column."],
];
---

<!doctype html>
<html lang="en">
  <head><Head /></head>
  <body style="font: 17px/1.5 system-ui; max-width: 640px; margin: 60px auto; padding: 0 20px; background: #f4f1ea; color: #222;">
    <h1 style="font-weight: 600; margin-bottom: 24px;">Mockups</h1>
    <ul style="display: grid; gap: 18px;">
      {options.map(([slug, title, text]) => <li><a href={`/mockups/${slug}`} style="font-weight: 600;">{title}</a><p>{text}</p></li>)}
    </ul>
  </body>
</html>
