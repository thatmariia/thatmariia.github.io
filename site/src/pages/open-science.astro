---
import WorkItem from "../components/WorkItem.astro";
import Base from "../layouts/Base.astro";
import { outputSections } from "../lib/data";
---

<Base title="Open science" sections={outputSections} mark={6}>
  {outputSections.map((s) => (
    <section class="block" id={s.id}>
      <h2>{s.title}</h2>
      {s.items.map((work) => <WorkItem work={work} />)}
    </section>
  ))}
</Base>
