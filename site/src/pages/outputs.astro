---
import WorkItem from "../components/WorkItem.astro";
import Base from "../layouts/Base.astro";
import { data, outputSections, type Work } from "../lib/data";

const sections = [
  { id: "papers", title: "Papers", items: data.papers as Work[] },
  { id: "preprints", title: "Preprints", items: data.preprints as Work[] },
  ...outputSections,
].filter((s) => s.items.length);
---

<Base title="Public outputs" sections={sections} figures={["collaborators"]}>
  {sections.map((s) => (
    <section class="block" id={s.id}>
      <h2>{s.title}</h2>
      {s.items.map((work) => <WorkItem work={work} />)}
    </section>
  ))}
</Base>
